// The status balloons: the same three states in each clan theme. A static default picture
// is used when a client sends EF_TALK but does not relay an SJK status reason.

gfx/sjk/status/default/typing
{
	nopicmip
	nomipmaps
	{
		animMap 3 gfx/sjk/status/default/typing_1 gfx/sjk/status/default/typing_2 gfx/sjk/status/default/typing_3
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
	}
}

gfx/sjk/status/default/busy
{
	nopicmip
	nomipmaps
	{
		clampmap gfx/sjk/status/default/busy
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
	}
}

