// Taris Undercity (Mythical, rebuilt on Sol's glow and core 3/11/2026): Taris at night, the city-world before Malak burned it: the blade is a black tower climbing in tiers, thousands of windows alight. Rivers of speeder traffic circle it in three dimensions, searchlights sweep through the smog and rain falls past. Then the Sith fleet fires: beams strike the tower, its lights die and fire bursts from it.
const Am: vec3<f32> = vec3<f32>(1.000, 0.700, 0.300);

const Te: vec3<f32> = vec3<f32>(0.240, 0.780, 0.950);

const Rd: vec3<f32> = vec3<f32>(1.000, 0.130, 0.080);

const Fi: vec3<f32> = vec3<f32>(1.000, 0.380, 0.080);

const H: vec3<f32> = vec3<f32>(1.000, 0.960, 0.860);

const Tw: vec3<f32> = vec3<f32>(0.022, 0.024, 0.034);

fn ta_top() -> f32 {
    return uLength * rxLife(0.0, 0.5, 0.32);
}

// The tower narrows in tiers, softly, up to a long spire.
fn ta_half(y: f32) -> f32 {
    let top = ta_top();
    if y > top {
        return 0.0;
    }
    let L = max(uLength, 1.0);
    let s = y / L * 5.0;
    let i = floor(s);
    let f = s - i;
    let w = mix(0.66, 0.34, (i + smoothstep(0.82, 1.0, f)) / 5.0);
    let e = 1.0 - clamp((top - y) / 5.0, 0.0, 1.0);
    return w * sqrt(max(1.0 - e * e, 0.0));
}

// Bombardment, every 15 seconds; three strikes one after the other.
fn ta_q(k: f32) -> f32 {
    return (glsl_mod(uClock, 15.0) - 9.0 - k * 0.75) / 1.5;
}

fn ta_ya(k: f32) -> f32 {
    return uLength * (0.25 + 0.24 * k) + 2.0 * sin(floor(uClock / 15.0) * 2.3 + k * 1.7);
}

fn ta_dark(y: f32) -> f32 {
    return 0.0;
}

fn ta_dark_old(y: f32) -> f32 {
    var d: f32 = 0.0;
    for (var i = 0; i < 3; i++) {
        let k = f32(i);
        let q = ta_q(k);
        if q > 0.0 {
            d = max(d, (1.0 - smoothstep(q * 5.5 - 2.0, q * 5.5 + 1.0, abs(y - ta_ya(k)))) * (1.0 - smoothstep(1.6, 3.6, q)));
        }
    }
    return d;
}

fn sig_glow_grown(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = ta_top();
    let yc = clamp(b.y, 0.0, top);
    let d = max(length(vec2(b.x, b.y - yc)) - ta_half(yc), 0.0);
    let city = 1.0 - 0.75 * ta_dark(b.y);
    var col = g * (0.5 + 0.1 * sin(b.y * 0.4 - uClock * 1.2)) * city;
    col += Am * (halo(d, 0.6) * 0.5 + halo(d, 2.4) * 0.2) * city + Te * halo(d, 4.6) * 0.09;
    for (var i = 0; i < 3; i++) {
        let k = f32(i);
        let q = ta_q(k);
    }
    return (col + g * 0.6 * clamp(uClash, 0.0, 1.0)) * tipFadeB(b) * roomFade(abs(b.x));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

fn sig_solid_night(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    if b.y < -0.3 || b.y > L + 0.3 {
        return o;
    }
    let half = ta_half(b.y);
    let cov = (1.0 - smoothstep(half - 0.04 - px, half + 0.03 + px, abs(b.x))) * smoothstep(0.02, 0.1 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    let nz = sqrt(max(1.0 - u * u, 0.0));
    var col = Tw * (0.6 + 1.2 * nz) + vec3<f32>(0.1, 0.11, 0.15) * pow(nz, 6.0) * 0.4;
    let s = b.y / max(L, 1.0) * 5.0;
    let f = fract(s);
    col *= 1.0 - 0.7 * smoothstep(0.86, 1.0, f);
    if part(0.0) > 0.5 {
        // windows: rows on the round of the tower, thousands of small lights
        let g = vec2(asin(u) * 3.2, b.y * 3.0);
        let id = floor(g);
        let q = fract(g) - 0.5;
        let h = h11(id.x * 7.31 + id.y * 3.17);
        let on = step(0.42, h) * step(0.2, h11(id.x * 2.1 + id.y * 5.9 + floor(uClock * (0.7 + 1.3 * h) + h * 9.0)));
        let w = (1.0 - smoothstep(0.2, 0.36, abs(q.x))) * (1.0 - smoothstep(0.18, 0.32, abs(q.y)));
        let tint = select(select(Am, H, h > 0.86), Te, h > 0.93);
        col += tint * w * on * (0.55 + 0.75 * h) * (0.35 + 0.75 * nz) * (1.0 - ta_dark(b.y));
        // lit spines climbing the corners, with light running up them
        let run = pow(0.5 + 0.5 * sin(b.y * 0.7 - uClock * 3.0), 5.0);
        col += mix(Am, H, run) * smoothstep(0.88, 1.0, abs(u)) * (0.25 + 1.3 * run) * (1.0 - ta_dark(b.y));
    }
    let burn = ta_dark(b.y);
    col += Fi * burn * smoothstep(0.4, 0.8, rxFlow(vec2(b.x * 3.0, b.y * 0.5 - uClock * 1.5))) * 1.6;
    col = mix(col, H, 0.45 * clamp(uClash, 0.0, 1.0));
    col *= smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

// A traffic lane: speeders with long curved streaks going round it; white one way, red the other.
fn ta_lane(ro: vec3<f32>, rd: vec3<f32>, px: f32, R: f32, y0: f32, pitch: f32, dir: f32, seed: f32, hot: vec3<f32>, tint: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    for (var i = 0; i < 4; i++) {
        let k = f32(i);
        var s: f32;
        let a = k / 4.0 + 0.1 * h11(k * 3.1 + seed) + dir * uClock * (0.27 + 0.09 * h11(k * 5.7 + seed));
        let span = 0.24 + 0.2 * h11(k * 2.3 + seed);
        let yy = y0 + 3.2 * (h11(k * 7.9 + seed) - 0.5);
        var bWs: f32 = 0.0;
        var best: f32 = 1.0e3;
        var f: f32 = 0.0;
        var prev = around(R, a - dir * span, yy + pitch * sin(6.2832 * (a - dir * span)));
        for (var j = 1; j <= 5; j++) {
            let g = f32(j) / 5.0;
            let ag = a - dir * span * (1.0 - g);
            let q = around(R, ag, yy + pitch * sin(6.2832 * ag));
            let d = raySeg(ro, rd, prev, q, &s);
            {
                let wN = bW(d);
                bWs += wN;
                best = min(best, d);
                f += ((f32(j) - 1.0 + s) / 5.0 - f) * wN / bWs;
            }
            prev = q;
        }
        acc += hot * halo(best, max(0.026, px)) * 1.25 * f * f * f + tint * (halo(best, 0.08 + 0.05 * f) * 0.75 + halo(best, 0.38) * 0.14) * f * f;
        var t: f32;
        let dh = rayPt(ro, rd, prev, &t);
        acc += hot * halo(dh, max(0.05, px)) * 1.5 + tint * halo(dh, 0.26) * 0.45;
    }
    return acc;
}

fn sig_vol_e3(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    let aft = rxLife(0.2, 0.9, 0.35);
    if aft <= 0.01 {
        return fx;
    }
    if part(1.0) > 0.5 && fxNear(ro, rd, 0.0, L) < 7.0 {
        fx += ta_lane(ro, rd, px, 1.75, L * 0.22, 0.9, 1.0, 11.0, H, Am);
        fx += ta_lane(ro, rd, px, 2.5, L * 0.43, 1.2, -1.0, 23.0, vec3<f32>(1.0, 0.5, 0.42), Rd);
        fx += ta_lane(ro, rd, px, 3.3, L * 0.64, 1.3, 1.0, 37.0, H, Te);
        fx += ta_lane(ro, rd, px, 2.15, L * 0.82, 0.7, -1.0, 41.0, vec3<f32>(1.0, 0.5, 0.42), Rd);
    }
    if part(2.0) > 0.5 {
        for (var i = 0; i < 3; i++) {
            // a searchlight: a soft cone out of the tower, sweeping
            let k = f32(i);
            var s: f32;
            let a = 0.2 + k * 0.37 + 0.11 * sin(uClock * (0.42 + 0.1 * k) + k * 2.0);
            let y = L * (0.26 + 0.27 * k);
            let p0 = around(0.5, a, y);
            let p1 = around(6.6, a, y + 3.2 * sin(uClock * (0.35 + 0.08 * k) + k * 3.0));
            let d = raySeg(ro, rd, p0, p1, &s);
            let wd = 0.07 + 0.72 * s;
            fx += mix(H, Te, 0.45) * exp(-d * d / (wd * wd)) * (1.0 - s) * (1.0 - s) * 0.42;
        }
    }
    if part(3.0) > 0.5 {
        fx += 1.1 * syMistSpin(ro, rd, 0.3, L * 0.7, 1.2, 4.8, 0.05, 103.0, Am * 0.16 + Te * 0.1, vec3<f32>(0.03, 0.035, 0.05));
        fx += 0.8 * fxFall(ro, rd, px, 1.0, L - 0.8, 3.6, 18.0, 4.4, 1.5, 0.05, 104.0, vec3<f32>(0.55, 0.62, 0.72));
    }
    return fx * aft * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_grown(g, b, r, px) * growGlow(b);
}

fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_e3(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    let C = uClock;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return base;
    }
    // the lights of the towers all round it, hanging signs of amber and teal, and the rain coming down through them
    a += 1.5 * shMotes(ro, rd, 4.6, 0.5, L - 0.5, 34.0, 1.2, 0.0, 0.0, 0.04, 0.6, 0.25, 111.0, H, Am);
    a += 1.2 * shMotes(ro, rd, 3.2, 0.5, L - 0.5, 26.0, 1.6, 0.0, 0.0, 0.035, 0.5, 0.2, 112.0, Te + H * 0.2, Te);
    var t: f32;
    for (var i = 0; i < 6; i++) {
        let k = f32(i);
        var s: f32;
        let mo = glsl_mod(k, 2.0);
        let p0 = around(2.7 + 1.2 * h11(k * 3.1), h11(k * 7.7) + C * 0.006, L * (0.14 + 0.13 * k));
        let dq = raySegRaw(ro, rd, p0, p0 + vec3<f32>(0.0, 1.2, 0.0), &s);
        let blink = 0.65 + 0.35 * sin(C * (0.6 + 0.4 * h11(k)) + k * 3.0);
        a += mix(Am, Te, mo) * (halo(dq, 0.1) * 1.3 + halo(dq, 0.42) * 0.42) * blink;
    }
    return base + a * rxLife(0.3, 1.2, 0.4) * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

// Day over Taris: slowly from the hand to the point the black tower turns pale in the sun, its windows dark against it, and night comes back the same way.
fn ta_day() -> f32 {
    return select(0.0, rxCycle(58.0, 24.0, 32.0, 46.0, 54.0), part(4.0) > 0.5);
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    var r = sig_solid_night(o, b, px);
    if uAge < 2000.0 && uAge < 3.2 && r.a > 0.0 {
        let front = smoothstep(0.1, 3.0, uAge) * (uLength + 8.0);
        r.r *= mix(0.1, 1.0, 1.0 - smoothstep(front - 7.0, front, b.y));
        r.g *= mix(0.1, 1.0, 1.0 - smoothstep(front - 7.0, front, b.y));
        r.b *= mix(0.1, 1.0, 1.0 - smoothstep(front - 7.0, front, b.y));
    }
    if uClashT < 1.2 && r.a > 0.0 {
        r.r *= 1.0 + 1.4 * pow(1.0 - uClashT / 1.2, 2.0);
        r.g *= 1.0 + 1.4 * pow(1.0 - uClashT / 1.2, 2.0);
        r.b *= 1.0 + 1.4 * pow(1.0 - uClashT / 1.2, 2.0);
    }
    let d0 = ta_day();
    if d0 > 0.0 && r.a > 0.0 && abs(b.x) < 2.4 {
        let m = smoothstep(0.0, 1.0, (d0 * (uLength + 12.0) - 6.0 - b.y) / 6.0);
        let lit = smoothstep(0.32, 0.7, max(r.r, max(r.g, r.b)));
        let tower = mix(vec3<f32>(0.78, 0.8, 0.84), vec3<f32>(0.16, 0.2, 0.28) + r.rgb * 0.3, lit);
        let sig_t0 = mix(r.rgb, tower, m);
        r.r = sig_t0.x;
        r.g = sig_t0.y;
        r.b = sig_t0.z;
    }
    return r;
}
