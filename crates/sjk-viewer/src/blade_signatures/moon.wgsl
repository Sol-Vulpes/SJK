// Moon blade (blade 270, rebuilt 4/11/2026): The Sun's night sister and Creyon's own blade: a blade of pure moonlight, pearl white with soft grey seas drifting through it. A slow tide of silver rises and falls along it, veils of moonlight wind round it, stars glitter in its mist and falling stars streak past. In its great moment the Earth's shadow takes it: a black blade in a blazing silver corona.
const Wh: vec3<f32> = vec3<f32>(0.985, 0.985, 1.000);

const Pe: vec3<f32> = vec3<f32>(0.880, 0.905, 0.960);

const Se: vec3<f32> = vec3<f32>(0.520, 0.570, 0.700);

const Si: vec3<f32> = vec3<f32>(0.700, 0.780, 1.000);

const Bl: vec3<f32> = vec3<f32>(0.280, 0.360, 0.640);

const Nt: vec3<f32> = vec3<f32>(0.030, 0.045, 0.110);

fn mo_top() -> f32 {
    return uLength * rxLife(0.0, 0.9, 0.55);
}

// the eclipse: 0 none, 1 total; every 26 seconds, slowly in and slowly out
fn mo_ecl() -> f32 {
    return select(0.0, rxCycle(56.0, 14.0, 22.0, 42.0, 51.0), part(5.0) > 0.5);
}

fn mo_shadow(y: f32) -> f32 {
    let e = mo_ecl();
    return select(smoothstep(uLength * (1.5 - 2.0 * e) - 7.0, uLength * (1.5 - 2.0 * e) + 7.0, y), 0.0, e <= 0.0);
}

// the tide: a long swell of light going slowly up the blade and sinking back
fn mo_tide(y: f32) -> f32 {
    let h = uLength * (0.5 + 0.55 * sin(uClock * 0.42));
    let dy = (y - h) / 5.5;
    return select(0.0, exp(-dy * dy), part(2.0) > 0.5);
}

fn mo_half(y: f32) -> f32 {
    let top = mo_top();
    if y > top {
        return 0.0;
    }
    let L = max(uLength, 1.0);
    let w = mix(0.62, 0.46, smoothstep(0.0, L, y)) * (0.4 + 0.6 * rxLife(0.0, 1.1, 0.45)) + 0.05 * mo_tide(y);
    let e = 1.0 - clamp((top - y) / 3.0, 0.0, 1.0);
    return w * sqrt(max(1.0 - e * e, 0.0));
}

fn sig_glow_grown(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = mo_top();
    let yc = clamp(b.y, 0.0, top);
    let d = max(length(vec2(b.x, b.y - yc)) - mo_half(yc), 0.0);
    let sh = mo_shadow(b.y);
    let ecl = mo_ecl();
    let tide = mo_tide(b.y);
    var col = g * (0.34 + 0.34 * tide) * (1.0 - 0.9 * sh);
    col += (Wh * halo(d, 0.07) * 0.5 + Si * (halo(d, 0.42) * (0.26 + 0.26 * tide) + halo(d, 1.9) * (0.13 + 0.14 * tide)) + Bl * halo(d, 4.6) * 0.1) * (1.0 - 0.92 * sh);
    // moonbeams: broad soft shafts of light leaning off the blade, slowly passing
    if part(2.0) > 0.5 {
        let bm = rxFlow(vec2(b.y * 0.42 + abs(b.x) * 0.16 - uClock * 0.09, select(6.0, 2.0, b.x > 0.0)));
        col += Si * bm * bm * bm * halo(d, 3.4) * (0.5 + 0.5 * tide) * (1.0 - sh);
    }
    // silver light round the night
    if ecl > 0.0 {
        let st = 0.6 + 0.4 * sin(b.y * 0.9 + uClock * 0.5 + 2.0 * sin(b.y * 0.27 - uClock * 0.3));
        col += sh * ecl * (Wh * halo(d, 0.05) * 0.7 + Si * (halo(d, 0.32) * 0.42 * st + halo(d, 1.8) * 0.3 * st) + Bl * halo(d, 4.4) * 0.2);
    }
    // moonrise: the silver point climbing as it lights
    let rise = 1.0 - smoothstep(0.5, 1.0, rxLife(0.0, 0.95, 0.5));
    col += (Wh * halo(length(vec2(b.x, b.y - top)), 0.8) * 1.3 + Si * halo(length(vec2(b.x, b.y - top)), 2.6) * 0.6) * rise;
    return (col + g * 0.7 * clamp(uClash, 0.0, 1.0)) * tipFadeB(b) * roomFade(abs(b.x));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    if b.y < -0.3 || b.y > L + 0.3 {
        return o;
    }
    let half = mo_half(b.y);
    var cov = (1.0 - smoothstep(half - 0.05 - px, half + 0.03 + px, abs(b.x))) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    let nz = sqrt(max(1.0 - u * u, 0.0));
    var col = Pe;
    let tide = mo_tide(b.y);
    if part(0.0) > 0.5 {
        // moonlight with the moon's face in it: soft grey seas drifting, a pearl sheen, the faintest craters up close
        let a = asin(u);
        let p = vec2(a * 0.75 + 0.03 * sin(b.y * 0.4), b.y * 0.62 - 0.05 * uClock);
        let see = 1.0 - smoothstep(0.02, 0.08, px);
        let sea = smoothstep(0.42, 0.72, vn(p * 0.85 + 4.0) * 0.66 + vn(p * 2.1 + 9.0) * 0.34);
        col = mix(Wh, Se, sea * 0.72);
        col *= 0.96 + 0.08 * vn(p * 4.5);
        for (var i = 0; i < 2; i++) {
            let s0 = select(3.3, 1.3, i == 0);
            let g0 = p * s0 + f32(i) * 7.3;
            var i0 = floor(g0);
            let f0 = fract(g0) - 0.5;
            let h = h11(i0.x * 7.1 + i0.y * 3.3 + f32(i) * 11.0);
            if h < 0.55 {
                continue;
            }
            let c0 = 0.28 * (vec2(fract(h * 17.0), fract(h * 31.0)) - 0.5);
            let rc = 0.1 + 0.16 * fract(h * 47.0);
            let dc = length(f0 - c0);
            let side = dot((f0 - c0) / max(dc, 0.001), vec2<f32>(0.45, 0.89));
            col *= 1.0 - see * (1.0 - smoothstep(rc * 0.25, rc, dc)) * (0.08 + 0.07 * side);
            col += Wh * see * (1.0 - smoothstep(0.0, 0.05, abs(dc - rc))) * (0.03 + 0.08 * side);
        }
    }
    // lit from within: a pale heart, silver toward its edges
    col *= 0.8 + 0.26 * nz;
    let tipk = smoothstep(0.0, 3.2, mo_top() - b.y);
    col = mix(col, Si, pow(1.0 - nz, 2.0) * 0.75 * tipk);
    col += Wh * tide * 0.2;
    let sh = mo_shadow(b.y);
    // night comes up it: not black but deep blue sky with stars in it, its edges still silver
    if sh > 0.0 {
        let sw0 = clamp(uSwing, 0.0, 1.0);
        let fl = vec2(b.x * 1.4 + 0.4 * sin(b.y * 0.2 + uClock * 0.3), b.y * 0.3 - 0.16 * uClock);
        let neb = vn(fl + 0.6 * (vn(fl * 1.7 + 3.0) - 0.5));
        var sky = mix(vec3<f32>(0.03, 0.05, 0.16), vec3<f32>(0.14, 0.2, 0.46), neb) * (1.0 + 0.7 * sw0);
        for (var i0 = 0; i0 < 2; i0++) {
            let f0 = f32(i0);
            let sq = vec2(b.x * (3.2 + 1.6 * f0), b.y * (1.4 + 0.7 * f0) - (0.34 - 0.14 * f0) * uClock) + f0 * 7.0;
            let si = floor(sq);
            let sp = si + 0.25 + 0.5 * h22(si);
            let ds = sq - sp;
            sky += Wh * halo(length(vec2(ds.x, ds.y / (1.0 + 3.0 * sw0))), 0.09) * step(0.6, h21(si)) * (0.6 + 0.4 * sin(uClock * (0.8 + h21(si)) + h21(si) * 20.0));
        }
        sky += Si * pow(1.0 - nz, 2.0) * 0.28 * tipk;
        col = mix(col, sky, sh * 0.98);
    }
    // it goes out as the moon sets: from the point, a shadow coming down
    col = mix(col, Wh, 0.45 * clamp(uClash, 0.0, 1.0));
    cov *= smoothstep(-0.25, 0.3, b.y) * (1.0 - smoothstep(uLength - 0.9, uLength + 0.1, b.y));
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

// The moon herself, hanging high beside the blade and moving slowly round it. The night passing over the blade passes over her too.
fn mo_moon() -> vec3<f32> {
    return around(4.0 + 0.2 * sin(uClock * 0.09), 0.11 + uClock * 0.005, uLength * 0.74 + 0.45 * sin(uClock * 0.13));
}

// A falling star: rare, far out, a long soft stroke crossing the blade's air; never the same place twice.
fn mo_star(ro: vec3<f32>, rd: vec3<f32>, px: f32, k: f32) -> vec3<f32> {
    let L = uLength;
    let run = uClock * (0.075 + 0.015 * h11(k * 1.9)) + k * 0.37;
    let cyc = floor(run);
    let q = fract(run);
    let go = clamp(q / 0.5, 0.0, 1.0);
    if q > 0.5 {
        return vec3<f32>(0.0);
    }
    let a = h11(k * 2.3 + cyc * 1.7);
    let R = 3.1 + 2.3 * h11(k * 5.1 + cyc);
    let y0 = L * (0.55 + 0.42 * h11(k * 3.7 + cyc));
    let run_y = 7.0 + 6.0 * h11(k * 6.3 + cyc);
    let turn = (0.09 + 0.08 * h11(k * 8.1 + cyc)) * (select(-1.0, 1.0, glsl_mod(cyc + k, 2.0) < 0.5));
    let hf = go * (0.6 + 0.4 * go);
    let tf = max(hf - 0.42, 0.0);
    let h0 = around(R, a + turn * hf, y0 - run_y * hf);
    let t0 = around(R + 0.3, a + turn * tf, y0 - run_y * tf);
    var s: f32;
    let d = raySeg(ro, rd, t0, h0, &s);
    let env = smoothstep(0.0, 0.06, q) * (1.0 - smoothstep(0.34, 0.5, q));
    let w = 0.02 + 0.045 * s * s;
    return (Wh * halo(d, max(w * 0.6, px)) * (0.5 + 1.7 * s * s) + Si * (halo(d, w * 2.4) * (0.5 + 0.7 * s) + halo(d, 0.5) * 0.12 * s)) * s * env;
}

fn sig_vol_r24(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    let C = uClock;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    let aft = rxLife(0.35, 1.5, 0.5);
    if aft <= 0.01 {
        return fx;
    }
    let ecl = mo_ecl();
    let day = 1.0 - 0.75 * ecl;
    if part(1.0) > 0.5 {
        // star dust: a few bright stars that twinkle and a fine glitter round them
        fx += (1.5 + 1.2 * ecl) * xDust(ro, rd, 2.2, 3.8, 1.1, C * 0.03, L * 0.03, L * 0.97, 1.5, 271.0, Wh, Si);
        fx += (1.4 + 1.6 * ecl) * shMotes(ro, rd, 4.4, 0.5, L - 0.5, 24.0, 2.4, 0.05, 0.01, 0.05, 0.55, 0.0, 272.0, Wh, Si);
        fx += 1.2 * shMotes(ro, rd, 2.8, 0.5, L - 0.5, 22.0, 2.0, -0.32, 0.016, 0.035, 0.6, 0.0, 276.0, Wh, Si * 0.6);
    }
    if part(2.0) > 0.5 {
        // the tide's veil: a silver mist turning slowly, no lines in it
        fx += day * 0.8 * syMistSpin(ro, rd, 0.3, L * 0.97, 1.6, 4.4, 0.01, 273.0, Si * 0.32, Bl * 0.3);
    }
    if part(3.0) > 0.5 {
        for (var i = 0; i < 3; i++) {
            fx += (1.0 + 0.8 * ecl) * mo_star(ro, rd, px, f32(i));
        }
    }
    // at night its light turns to stars: a whole sky comes out round it, shining points of four rays and fine dust
    if ecl > 0.01 {
        fx += ecl * 1.9 * syGlints(ro, rd, px, 14.0, 5.0, 279.0, Wh, Si);
        fx += ecl * 1.6 * syGlints(ro, rd, px, 14.0, 3.2, 280.0, Wh, Si * 0.7);
        fx += ecl * 2.0 * shMotes(ro, rd, 3.6, 0.5, L - 0.5, 30.0, 1.6, 0.0, 0.004, 0.03, 0.75, 0.3, 281.0, Wh, Si);
    }
    if part(0.0) > 0.5 {
        // her light on the air, and thin cloud crossing before her
        var tm: f32;
        let dm = rayPtRaw(ro, rd, mo_moon(), &tm);
        let on = rxLife(0.6, 2.0, 0.4);
        fx += (Wh * halo(dm, 1.7) * 0.4 + Si * (halo(dm, 3.0) * 0.24)) * on * (1.0 - 0.97 * ecl);
        // in the night her dark face keeps a thin white rim
        fx += Wh * (halo(abs(dm - 1.5), max(0.022, px * 0.7)) * 0.75 + halo(abs(dm - 1.5), 0.11) * 0.12) * on * ecl;
    }
    if part(4.0) > 0.5 {
        fx += 1.2 * syMistSpin(ro, rd, 0.3, L * 0.97, 1.4, 5.4, 0.016, 275.0, Si * 0.26, Nt * 1.4);
    }
    // splinters of moon rock turning slowly round it, silver by day and catching the stars at night
    fx += (1.15 + 0.6 * ecl) * gxTumble(ro, rd, px, 12.0, 5.6, 0.0, 0.0, 0.32, 281.0, Wh, Si);
    // by day: pearls of moonlight climbing round it in two strands, a shoal of silver lights, a slow great star now and then
    fx += day * 1.2 * gxHelix(ro, rd, px, 18.0, 2.5, 1.7, 0.035, 283.0, Wh, Si);
    fx += day * 1.1 * gxSwarm(ro, rd, px, 10.0, 4.8, 284.0, Wh, Si);
    fx += day * 1.05 * gxFlares(ro, rd, px, 4.0, 5.2, 285.0, Wh, Si);
    // the corona's great stars opening while the shadow is on it
    if ecl > 0.02 {
        fx += ecl * 1.5 * gxFlares(ro, rd, px, 6.0, 5.4, 282.0, Wh, Si * 0.7);
    }
    return fx * aft * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_grown(g, b, r, px) * growGlow(b);
}

fn sig_vol_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    let o: vec4<f32> = vec4<f32>(0.0);
    if uFx <= 0.0 || part(0.0) < 0.5 || fxNear(ro, rd, 0.0, uLength) > 16.0 {
        return o;
    }
    var tm: f32;
    let R = 1.5 * rxLife(0.6, 2.0, 0.4);
    let c = mo_moon();
    let d = rayPtRaw(ro, rd, c, &tm);
    if R < 0.05 || d > R + 0.1 {
        return o;
    }
    let e1 = normalize(cross(rd, vec3<f32>(0.0, 1.0, 0.0)));
    let e2 = cross(rd, e1);
    let w0 = ro + rd * tm - c;
    let u = vec2(dot(w0, e1), dot(w0, e2)) / R;
    let r0 = length(u);
    let nz = sqrt(max(1.0 - r0 * r0, 0.0));
    let tn = uClock * 0.012;
    let cs = cos(tn);
    let sn = sin(tn);
    let nn = vec3(u, nz);
    let n0 = vec3(cs * nn.x + sn * nn.z, nn.y, -sn * nn.x + cs * nn.z);
    // height of her ground: broad seas low, fine pits, and craters of two sizes with raised rims
    let sea = smoothstep(0.42, 0.66, 0.68 * gx3(n0 * 2.1 + 4.0) + 0.32 * gx3(n0 * 5.0 + 9.0));
    let h0 = 0.7 * gx3(n0 * 11.0) + 0.3 * gx3(n0 * 24.0 + 3.0) - 0.5 * sea;
    var rim: f32 = 0.0;
    var pit: f32 = 0.0;
    for (var i0 = 0; i0 < 2; i0++) {
        let sc = select(7.5, 3.4, i0 == 0);
        let g0 = n0 * sc + f32(i0) * 5.0;
        let c1 = floor(g0);
        let f0 = g0 - c1 - 0.5;
        let hc = h11(c1.x * 7.1 + c1.y * 3.3 + c1.z * 5.7);
        if hc < 0.5 {
            continue;
        }
        let rc = 0.14 + 0.2 * fract(hc * 47.0);
        let dc = length(f0 - 0.2 * (vec3(fract(hc * 17.0), fract(hc * 31.0), fract(hc * 53.0)) - 0.5));
        pit = max(pit, (1.0 - smoothstep(rc * 0.4, rc, dc)));
        rim = max(rim, 1.0 - smoothstep(0.0, 0.06, abs(dc - rc)));
    }
    let sun_ = normalize(vec3<f32>(-0.55, 0.45, 0.7));
    let e = mo_ecl();
    let dirn = normalize(vec3(sin(e * 3.1), 0.2, cos(e * 3.1)));
    let grain = gx3(n0 * 40.0);
    let lam = clamp(dot(nn, sun_) * 0.5 + 0.62, 0.0, 1.0);
    var ground = mix(vec3<f32>(0.95, 0.95, 0.93), vec3<f32>(0.42, 0.44, 0.5), sea * 0.85) * (0.8 + 0.3 * h0 + 0.08 * grain);
    ground = ground * (1.0 - 0.34 * pit) + vec3<f32>(0.32) * rim * (1.0 - 0.4 * sea);
    var col = ground * (0.42 + 0.74 * lam) * (0.72 + 0.3 * nz);
    // the night's shadow goes across her as a real phase, with a soft edge; what is dark keeps a faint earthshine
    let lit = smoothstep(-0.2, 0.26, dot(nn, dirn));
    let night_ = ground * vec3<f32>(0.05, 0.065, 0.12);
    col = mix(night_, col, lit);
    let cov = (1.0 - smoothstep(0.88 - px / R, 1.0 + px / R, r0)) * (1.0 - behindBlade(ro, rd, tm));
    return vec4(col, cov * uFx * tipFade(ro, rd) * hiltFade(ro, rd));
}

// >>> how it answers: as it lights, in a swing, in a clash
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_r24(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return base;
    }
    let ig = select(0.0, 1.0 - smoothstep(0.3, 3.0, uAge), uAge < 2000.0);
    let sw = clamp(uSwing, 0.0, 1.0);
    a += ig * 1.25 * gxHelix(ro, rd, px, 18.0, 2.4, 1.6, 0.14, 301.0, Wh, Si);
    a += 1.3 * gxBurst(ro, rd, px, 12.0, 5.0, 2.0, 0.0, 302.0, Wh, Si);
    a += sw * 1.1 * gxFlares(ro, rd, px, 4.0, 4.0, 303.0, Wh, Si);
    return base + a * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}
