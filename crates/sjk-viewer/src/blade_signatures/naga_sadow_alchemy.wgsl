// Naga Sadow Alchemy (rebuilt 3/11/2026): Naga Sadow's forbidden alchemy at the boil: a blade of swallowing blood with bubbles climbing through it. Heavy ropes of blood are thrown out of its sides, arc through the air and fall back in, fumes roll off it and thick drops fall from it.
const R: vec3<f32> = vec3<f32>(0.900, 0.050, 0.070);

const D: vec3<f32> = vec3<f32>(0.070, 0.004, 0.012);

const O: vec3<f32> = vec3<f32>(1.000, 0.360, 0.110);

const H: vec3<f32> = vec3<f32>(1.000, 0.880, 0.720);

fn ng_top() -> f32 {
    return uLength * rxLife(0.0, 0.5, 0.32);
}

fn ng_boil() -> f32 {
    return rxCycle(18.0, 9.0, 11.2, 13.2, 16.2);
}

fn ng_half(y: f32) -> f32 {
    let top = ng_top();
    if y > top {
        return 0.0;
    }
    let e = 1.0 - clamp((top - y) / 1.4, 0.0, 1.0);
    let gulp = 0.13 * sin(y * 0.55 - uClock * 1.5) + 0.07 * sin(y * 1.35 + uClock * 0.9);
    return (0.56 + gulp * smoothstep(0.5, 3.0, y)) * sqrt(max(1.0 - e * e, 0.0));
}

fn sig_glow_w2(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = ng_top();
    let yc = clamp(b.y, 0.0, top);
    let d = max(length(vec2(b.x, b.y - yc)) - ng_half(yc), 0.0);
    let st = ng_boil();
    var col = R * (halo(d, 0.3) * 0.95 + halo(d, 1.4) * (0.42 + 0.3 * st) + halo(d, 4.0) * (0.13 + 0.12 * st));
    col += lvl(g) * R * (1.0 - smoothstep(0.3, 1.5, abs(b.y))) * 0.25;
    col *= tipFadeB(b);
    return col * roomFade(abs(b.x)) * (1.0 + 0.8 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    if b.y < -0.3 || b.y > L + 0.3 {
        return o;
    }
    let half = ng_half(b.y);
    let cov = (1.0 - smoothstep(half - 0.05 - px, half + 0.03 + px, abs(b.x))) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    let nz = sqrt(max(1.0 - u * u, 0.0));
    var col = R;
    if part(0.0) > 0.5 {
        let v = rxFlow(vec2(b.x * 1.7, b.y * 0.13 - uClock * 0.3));
        col = mix(D, R, smoothstep(0.18, 0.72, v));
        col += O * smoothstep(0.6, 0.84, v) * 0.7;
        // bubbles climbing through the liquid
        let q = vn(vec2(b.x * 3.4, b.y * 0.9 - uClock * 1.6));
        col += mix(O, H, 0.6) * smoothstep(0.72, 0.84, q) * 0.85;
    }
    col *= 0.55 + 0.75 * nz;
    col += O * pow(1.0 - nz, 3.0) * 0.9;
    col = mix(col, H, 0.45 * clamp(uClash, 0.0, 1.0));
    col *= smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

// A rope of blood thrown out of the blade, arcing and falling back into it.
fn ng_rope(ro: vec3<f32>, rd: vec3<f32>, px: f32, k: f32, boil: f32) -> vec3<f32> {
    let L = uLength;
    let run = uClock * (0.2 + 0.05 * h11(k * 1.9)) + k * 0.29;
    let cyc = floor(run);
    let ph = fract(run);
    let a = h11(k * 2.3 + cyc * 1.7);
    let y = L * (0.08 + 0.62 * h11(k * 5.1 + cyc * 0.9));
    let tall = 3.6 + 1.8 * h11(k * 3.1 + cyc) + 1.4 * boil;
    let span = 3.5 + 2.8 * h11(k * 6.3 + cyc);
    var tm: f32;
    if rayPtRaw(ro, rd, around(1.0 + tall * 0.5, a, y + span * 0.5), &tm) > tall + span * 0.6 + 2.0 {
        return vec3<f32>(0.0);
    }
    let head = ph * 1.7;
    let tail = head - 0.85;
    var bWs: f32 = 0.0;
    var best: f32 = 1.0e3;
    var bf: f32 = 0.0;
    var s: f32;
    // only the living stretch of the arc, its two ends sliding smoothly: the rope never jumps a segment
    let f0 = clamp(tail, 0.0, 1.0);
    let f1 = clamp(head, 0.0, 1.0);
    if f1 - f0 < 0.002 {
        return vec3<f32>(0.0);
    }
    var prev = around(0.5 + tall * sin(3.1416 * f0), a + 0.03 * sin(6.28 * f0), y + span * f0);
    for (var j = 1; j <= 9; j++) {
        let f = mix(f0, f1, f32(j) / 9.0);
        let q = around(0.5 + tall * sin(3.1416 * f), a + 0.03 * sin(6.28 * f), y + span * f);
        let dd = raySeg(ro, rd, prev, q, &s);
        {
            let wN = bW(dd);
            bWs += wN;
            best = min(best, dd);
            bf += (mix(f0, f1, (f32(j) - 1.0 + s) / 9.0) - bf) * wN / bWs;
        }
        prev = q;
    }
    if best > 3.0 {
        return vec3<f32>(0.0);
    }
    let at = clamp((bf - tail) / max(head - tail, 0.01), 0.0, 1.0);
    let ww = mix(0.05, 0.27, at * at);
    let fade = smoothstep(0.0, 0.25, at);
    let col = (H * halo(best, max(ww * 0.28, px)) * (0.5 + 1.3 * at) + mix(R, O, at * 0.5) * halo(best, ww) * 1.4 + R * (halo(best, ww * 3.0) * 0.75 + halo(best, 1.3) * 0.2));
    return col * fade * (1.0 - smoothstep(1.4, 1.7, head));
}

fn sig_vol_w2(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    let aft = rxLife(0.2, 0.9, 0.35);
    if aft <= 0.01 {
