fn kMoment() -> f32 {
    return rxCycle(26.0, 15.0, 17.2, 19.2, 22.2);
}

fn kLine(ro: vec3<f32>, rd: vec3<f32>, px: f32, a: vec3<f32>, c: vec3<f32>, sag: f32, w: f32, hot: vec3<f32>, col: vec3<f32>, flow: f32) -> vec3<f32> {
    var tm: f32;
    if rayPtRaw(ro, rd, mix(a, c, 0.5), &tm) > 0.5 * length(c - a) + abs(sag) + 1.2 {
        return vec3<f32>(0.0);
    }
    var prev = a;
    var bWs: f32 = 0.0;
    var best: f32 = 1.0e3;
    var bf: f32 = 0.0;
    var s: f32;
    for (var i = 1; i <= 7; i++) {
        let f = f32(i) / 7.0;
        let q = mix(a, c, f) + vec3(0.0, sag * 4.0 * f * (1.0 - f), 0.0);
        let d = raySeg(ro, rd, prev, q, &s);
        {
            let wN = bW(d);
            bWs += wN;
            best = min(best, d);
            bf += ((f32(i) - 1.0 + s) / 7.0 - bf) * wN / bWs;
        }
        prev = q;
    }
    let bead = pow(0.5 + 0.5 * sin(bf * 9.0 - uClock * flow), 6.0);
    return (hot * halo(best, max(w, px)) * (0.5 + 1.2 * bead) + col * halo(best, w * 5.0) * (0.3 + 0.6 * bead)) * smoothstep(0.0, 0.08, bf) * (1.0 - smoothstep(0.85, 1.0, bf));
}

fn sig_vol_34(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return fx;
    }
    let L = uLength;
    let T = uTime;
    let C = uClock;
    var t: f32;
    let aft = rxLife(0.15, 0.7, 0.35);
    if aft <= 0.01 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    let mom = kMoment();
    if part(2.0) > 0.5 {
        fx += 1.0 * fxMotes(ro, rd, px, L * 0.05, L * 0.95, 1.3, 2.2, 8.0, 0.22, 74.0, A);
    }
    if part(3.0) > 0.5 {
        fx += 0.22 * syMist(ro, rd, L * 0.1, L * 0.95, 3.2, 0.2, 7.0, A * 0.45, D);
    }
    if part(2.0) > 0.5 {
        for (var i = 0; i < 5; i++) {
            let k = f32(i);
            fx += 0.9 * rxTongue(ro, rd, L * (0.09 + 0.18 * k), k * 0.41 + 0.01 * C, 3.2, 1.3, 0.4, k + 6.0, H, M, A);
        }
    }
    if part(2.0) > 0.5 {
        for (var i = 0; i < 2; i++) {
            let k = f32(i);
            let cyc = C * (0.19 + 0.05 * k) + k * 0.47;
            let n = floor(cyc);
            let q = fract(cyc);
            let rk = smoothstep(0.0, 0.14, q) * pow(1.0 - q, 2.0);
            if rk > 0.01 {
                let a0 = h11(n * 3.1 + k);
                let y0 = L * (0.2 + 0.6 * h11(n * 1.7 + k));
                for (var j = 0; j < 3; j++) {
                    let m = f32(j);
                    fx += 1.6 * rk * kLine(ro, rd, px, around(1.0, a0 - 0.05, y0 + 2.6 + m * 0.8), around(2.2, a0 + 0.15, y0 - 2.6 + m * 0.8), 0.25, 0.05, H, M, 1.0);
                }
            }
        }
    }
    // effects rise with the blade as it lights and sink with it as it goes out
    var sa: f32;
    _ = raySeg(ro, rd, vec3<f32>(0.0, 0.0, 0.0), vec3(0.0, L + 4.0, 0.0), &sa);
    let grownTop = (L + 6.0) * rxLife(0.0, 0.55, 0.32);
    fx *= 1.0 - smoothstep(grownTop - 4.0, grownTop, sa * (L + 4.0));
    // nothing over the point
    fx *= tipFade(ro, rd);
    return fx * aft * uFx * hiltFade(ro, rd);
}

