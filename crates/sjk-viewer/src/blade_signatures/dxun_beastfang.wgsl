fn k_half(y: f32, sd: f32) -> f32 {
    let L = uLength;
    let T = uTime;
    let C = uClock;
    let s = clamp(y / max(L, 1.0), 0.0, 1.0);
    let w = 0.5 + 0.12 * sin(y * 0.22 + sd) + 0.24 * smoothstep(0.92, 0.35, s) * smoothstep(0.0, 0.2, s) * 0.2;
    let top = L * rxLife(0.0, 0.45, 0.32);
    if y > top {
        return 0.0;
    }
    let e = 1.0 - clamp((top - y) / max(w * 1.0, 0.05), 0.0, 1.0);
    return w * sqrt(max(1.0 - e * e, 0.0));
}

fn sig_glow_34(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
