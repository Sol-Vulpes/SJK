fn k_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    if b.y < -0.3 || b.y > L + 0.3 {
        return o;
    }
    let half = k_half(b.y, select(1.0, -1.0, b.x < 0.0));
    let cov = (1.0 - smoothstep(half - 0.05 - px, half + 0.03 + px, abs(b.x))) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    let ang = asin(u);
    let nz = sqrt(max(1.0 - u * u, 0.0));
    let x = b.x;
    let y = b.y;
    let s = clamp(y / max(L, 1.0), 0.0, 1.0);
    let T = uTime;
    let C = uClock;
    var col = M;
    if part(0.0) > 0.5 {
        let w = y * 0.22 + ang * 0.75 + 1.2 * kf(ang * 0.7, y * 0.1);
        let bar = smoothstep(0.35, 0.65, sin(w * 2.0)) * smoothstep(-0.8, 0.2, sin(y * 0.31 + ang * 1.3));
        col = mix(M * (0.72 + 0.4 * kf(x * 7.0, y * 0.8)), D, bar);
        if part(1.0) > 0.5 {
            col *= 0.82 + 0.3 * sin(T * 0.9 + y * 0.1);
        }
    }
    col *= (0.45 + 0.7 * nz) * 1.35;
    col += M * pow(1.0 - nz, 3.0) * 0.5;
    col = mix(col, H, (1.0 - smoothstep(0.0, 0.55, abs(u))) * 0.6);
    col += H * halo(max(b.y, 0.0), 0.5) * 0.5;
    col = mix(col, H, 0.45 * clamp(uClash, 0.0, 1.0));
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let r = k_solid(o, b, px);
