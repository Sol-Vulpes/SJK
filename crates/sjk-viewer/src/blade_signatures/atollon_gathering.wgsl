fn sw_extra(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, 0.0, uLength) > 16.0 {
