}

fn sig_vol_raw(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx = sig_vol_base(ro, rd, px);
    if uFx > 0.0 && part(5.0) > 0.5 {
        fx += gs_lights(ro, rd, px) * uFx * rxLife(0.3, 1.0, 0.6);
    }
    return fx * hiltFade(ro, rd);
}

// Gathered lights (update 19): large soft spheres of the sky's light drift in from far round the
// blade, each with a slow bright heart, climbing a long curve; each is drawn out toward the blade as
// it nears, a thread of light joining them, and the blade flares where it pours in.
fn gs_lights(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, 0.0, uLength) > 16.0 {
        return acc;
    }
    var t: f32;
    var s: f32;
    for (var i = 0; i < 6; i++) {
        let k = f32(i);
        let cyc = uClock * (0.09 + 0.03 * h11(k * 3.7)) + h11(k * 6.1);
        let n = floor(cyc);
        let q = fract(cyc);
        let e = q * q * (3.0 - 2.0 * q);
        let a = h11(n * 2.9 + k) + 0.55 * e;
        let y0 = uLength * (0.1 + 0.5 * h11(n * 5.3 + k));
        let c = around(mix(6.4, 0.6, e), a, y0 + 8.0 * e);
        let R = (0.55 + 0.5 * h11(n * 1.7 + k)) * (1.0 - 0.55 * e);
        let life = smoothstep(0.0, 0.14, q) * (1.0 - smoothstep(0.88, 1.0, q));
        let d = rayPt(ro, rd, c, &t);
        let br = 0.8 + 0.2 * sin(uClock * 2.3 + k * 2.0);
        acc += (GS_WHITE * halo(d, max(R * 0.42, px)) * 1.25 + GS_SKY * halo(d, R * 1.5) * 0.55 + GS_DEEP * halo(d, R * 3.6) * 0.16) * br * life * roomFade(mix(6.4, 0.6, e));
        // the thread to the blade, once it is near
        let near = smoothstep(0.45, 0.8, e) * life;
        if near > 0.01 {
            let dt = raySeg(ro, rd, c, around(0.45, a + 0.05, c.y + 1.5), &s);
            acc += (GS_PALE * halo(dt, max(0.05, px)) * 0.9 + GS_SKY * halo(dt, 0.25) * 0.3) * near * sin(3.1416 * clamp(s, 0.0, 1.0));
        }
    }
    return acc;
}

// (update 26) the body starts softly in the emitter, no hard end above the hilt
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let r = sig_solid_raw(o, b, px);
    let j = smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, r.rgb, j), mix(o.a, r.a, j));
}

// (update 28, Creyon: its effects stopped short of the tip) the gathering reaches the point
fn sig_vol_tc(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let fx = sig_vol_raw(ro, rd, px);
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, uLength) > 16.0 {
        return fx;
    }
    let L = uLength;
    var up: vec3<f32> = vec3<f32>(0.0);
    for (var i = 0; i < 3; i++) {
        let k = f32(i);
        up += 1.1 * xBeads(ro, rd, 2.6 - 0.4 * k, 0.95, 0.5, k / 3.0 + 0.01 * uTime, L * 0.5, L * 0.99, 0.06, k + 3.0, GS_WHITE, GS_SKY);
    }
    up += 1.2 * gxKin(ro, rd, 3.0, 9.0, 3.20, 0.080, 0.12, 0.08, 0.96, -1.0, 7078.0, GS_WHITE, GS_SKY);
    var s: f32;
    _ = raySeg(ro, rd, vec3<f32>(0.0), vec3(0.0, L + 4.0, 0.0), &s);
    return fx + up * rxLife(0.3, 1.0, 0.4) * uFx * tipFade(ro, rd);
}

// (update 29, Creyon: nothing past the tip) every effect ends at the blade's end
fn sig_vol_34(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let fx = sig_vol_tc(ro, rd, px);
    var s: f32;
    _ = raySeg(ro, rd, vec3<f32>(0.0), vec3(0.0, uLength + 4.0, 0.0), &s);
    return fx * tipFade(ro, rd);
}

fn sig_glow_t1(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_tc(g, b, r, px) * tipFadeB(b);
}

