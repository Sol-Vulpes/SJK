    }
    fx += 1.0 * shStrands(ro, rd, 1.25, 1.0, uLength - 0.6, 3.0, 0.02, 0.03, 0.14, 2.5, 81.0, XH, XM);
    for (var ci = 0; ci < 2; ci++) {
