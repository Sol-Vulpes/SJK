// Atollon Gathering: the energy of everything round it, lent to one blade. Pale sky-blue streams of
// energy curve in from all round and flow into the blade, motes of light drift slowly inward to
// it, and over a slow cycle its upper half fills with what it gathers, glowing brighter and
// pulsing as it gathers, until it lets it go in a soft wave of light down the blade and a gentle
// ring outward. Inside it light swirls slowly up. Nothing gathers on its tip: it all goes into
// the blade itself. No figures.
const GS_SKY: vec3<f32> = vec3<f32>(0.55, 0.82, 1.0);

const GS_PALE: vec3<f32> = vec3<f32>(0.85, 0.95, 1.0);

const GS_DEEP: vec3<f32> = vec3<f32>(0.2, 0.45, 0.9);

const GS_WHITE: vec3<f32> = vec3<f32>(0.98, 1.0, 1.0);

// The gathering on a 22-second cycle: how full the blade's upper half is (0 to 1, rising
// slowly over fourteen seconds) and the release (0 to 1 over its wave), smooth both ways.
fn gs_full(release: ptr<function, f32>) -> f32 {
    (*release) = -1.0;
    if part(2.0) < 0.5 {
        return 0.0;
    }
    let c = glsl_mod((uTime * 0.5) + uSeed * 4.0, 22.0);
    let full = smoothstep(2.0, 16.0, c) * (1.0 - smoothstep(16.0, 17.5, c));
    if part(3.0) > 0.5 && c >= 16.0 && c < 19.5 {
        (*release) = (c - 16.0) / 3.5;
    }
    return full;
}

fn gs_half(y: f32) -> f32 {
    let tip = clamp((uLength + 0.3 - y) / 2.0, 0.0, 1.0);
    return 0.5 * sqrt(tip);
}

fn sig_glow_tc(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    var release: f32;
    let full = gs_full(&release);
    let top = uLength + 0.3;
    let y = clamp(b.y, 0.0, top);
    let d = max(length(vec2(b.x, b.y - y)) - gs_half(y), 0.0);
    let upper = smoothstep(uLength * 0.4, uLength * 0.65, b.y);
    // (update 16) a steady speed: one that followed the moment jumped by the blade's whole age
    let pulse = 0.5 + 0.5 * sin(uTime * 0.6);
    var col = recol(g, GS_SKY) * 0.55;
    // effect 3: the gathering, the blade's upper half glowing brighter and pulsing as it fills
    col += (GS_SKY * halo(d, 0.9 + 0.8 * full) + GS_PALE * halo(d, 0.25) * 0.6) * upper * full * (0.6 + 0.4 * pulse);
    // effect 4: the release, a soft wave of light rolling down the blade from its upper half
    if release >= 0.0 {
        let wy = mix(uLength * 0.85, -1.0, release);
        let fade = (1.0 - release) * smoothstep(0.0, 0.08, release);
        col += (GS_WHITE * halo(abs(b.y - wy), 1.2) * halo(d, 1.0) + GS_SKY * halo(abs(b.y - wy), 3.0) * halo(d, 2.5) * 0.5) * fade;
    }
    // nothing over the point (Creyon): what it draws fades out just past its tip
    col *= tipFadeB(b);
    return col * roomFade(abs(b.x));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.5;
}

// effect 5: the inner swirl, light swirling slowly up inside it, brighter in its upper half as
// it fills
fn sig_solid_raw(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let top = uLength + 0.3;
    if b.y < -0.2 || b.y > top {
        return o;
    }
    let half = gs_half(b.y);
    let x = abs(b.x);
    let cov = fillD(x - half, px) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(x / max(half, 0.01), 0.0, 1.0);
    var release: f32;
    let full = gs_full(&release);
    var col = mix(GS_PALE * 1.05, GS_SKY, smoothstep(0.3, 1.0, u));
    if part(4.0) > 0.5 {
        let sw = 0.5 + 0.5 * sin(b.x * 5.0 + b.y * 0.6 - (uTime * 0.4) * 1.4 + 2.0 * sin(b.y * 0.15 - (uTime * 0.4) * 0.5));
        col = mix(col, GS_DEEP * 1.1, pow(sw, 3.0) * 0.35);
        col += GS_WHITE * pow(sw, 10.0) * 0.4;
    }
    let upper = smoothstep(uLength * 0.4, uLength * 0.65, b.y);
    col = mix(col, GS_WHITE, upper * full * 0.45);
    let a = cov;
    return vec4(mix(o.rgb, col, a), max(o.a, a));
}

// effects 1 and 2: streams of energy curving in from all round and flowing into the blade's
// upper half (light running along them inward), and motes drifting slowly in to it
// The 3D structure round it (1/11/2026, Creyon: the lower tiers filled out so they are never
// plain, each its own shape): the gathering: countless motes of pale light drifting in from far round it and falling into the blade, thin rays of light reaching in after them, a pale haze drawn in round the emitter. Lit, it grows in; let go, it fades.
fn cx_more(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    let aft = rxLife(0.2, 1.0, 0.6);
    if part(0.0) < 0.5 || aft <= 0.01 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    {
        fx += 1.2 * syMistSpin(ro, rd, 0.3, L * 0.95, 6.0, 1.5, 0.03, 3.0, GS_PALE, GS_SKY * 0.4);
        var t: f32;
        var s: f32;
        for (var i = 0; i < 24; i++) {
            let k = f32(i);
            let cyc = tCalm() * (0.15 + 0.08 * h11(k * 2.3)) + h11(k * 7.1);
            let n = floor(cyc);
            let q = fract(cyc);
            let a = h11(n * 3.7 + k);
            let r = mix(5.5 + 0.8 * h11(n * 2.9 + k), 0.5, q * q);
            let p = around(r, a, L * (0.1 + 0.8 * h11(n * 5.1 + k)));
            let life = smoothstep(0.0, 0.25, q) * (1.0 - smoothstep(0.9, 1.0, q));
            fx += (GS_WHITE * halo(rayPt(ro, rd, p, &t), max(0.06, px)) * 1.4 + GS_SKY * halo(rayPt(ro, rd, p, &t), 0.35) * 0.3) * life * roomAt(p);
            if i < 8 {
                let tail = around(r + 1.8 * (1.0 - q), a, p.y);
                let d = raySeg(ro, rd, p, tail, &s);
                fx += GS_PALE * halo(d, max(0.03, px)) * (1.0 - s) * life * 0.6 * roomAt(tail);
            }
        }
    }
    return fx * aft;
}

fn sig_vol_base(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return fx;
    }
    let L = uLength;
    var s: f32;
    var t: f32;
    if fxNear(ro, rd, 0.0, L + 2.0) > 8.5 {
        return fx + cx_more(ro, rd, px) * uFx;
    }
    var release: f32;
    let full = gs_full(&release);
    if part(0.0) > 0.5 {
        for (var i = 0; i < 5; i++) {
            let k = f32(i);
            let cyc = (uTime * 0.4) * 0.09 + h11(k * 3.3);
            let n = floor(cyc);
            let q = fract(cyc);
            let life = smoothstep(0.0, 0.2, q) * (1.0 - smoothstep(0.75, 1.0, q));
            let a = h11(n * 2.1 + k * 1.7);
            let yIn = L * (0.5 + 0.4 * h11(n * 4.7 + k));
            var bWs: f32 = 0.0;
            var best: f32 = 1.0e3;
            var bf: f32 = 0.0;
            var prev = around(7.0, a, yIn - 3.0 + 6.0 * h11(n + k));
            for (var j = 1; j <= 16; j++) {
                let f = f32(j) / 16.0;
                let e = f * f * (3.0 - 2.0 * f);
                let p = around(mix(7.0, 0.55, e), a + 0.18 * e, mix(yIn - 3.0 + 6.0 * h11(n + k), yIn, e));
                let dd = raySeg(ro, rd, prev, p, &s);
                {
                    let wN = bW(dd);
                    bWs += wN;
                    best = min(best, dd);
                    bf += ((f32(j) - 1.0 + s) / 16.0 - bf) * wN / bWs;
                }
                prev = p;
            }
            let run = pow(0.5 + 0.5 * sin(bf * 14.0 - (uTime * 0.4) * 3.0 - k), 6.0);
            let taper = smoothstep(0.0, 0.35, bf);
            fx += (GS_PALE * halo(best, max(0.06, px)) * (0.4 + 1.0 * run) + GS_SKY * halo(best, 0.35) * 0.35) * life * taper * (0.6 + 0.6 * full);
        }
    }
    if part(1.0) > 0.5 {
        for (var i = 0; i < 18; i++) {
            let k = f32(i);
            let cyc = (uTime * 0.4) * (0.1 + 0.07 * h11(k * 2.9)) + h11(k * 5.3);
            let n = floor(cyc);
            let q = fract(cyc);
            let e = q * q;
            let p = around(mix(6.0 + 1.5 * h11(n + k), 0.6, e), h11(n * 3.1 + k) + 0.1 * q, L * (0.35 + 0.6 * h11(n * 6.7 + k)) + (1.0 - e) * 1.5);
            let d = rayPt(ro, rd, p, &t);
            let life = smoothstep(0.0, 0.2, q) * (1.0 - smoothstep(0.85, 1.0, q));
            fx += (GS_WHITE * halo(d, max(0.06, px)) * 1.3 + GS_SKY * halo(d, 0.3) * 0.35) * life * roomAt(p);
        }
    }
    // the release: a soft flare of gathered light along the blade (no ring)
    if release >= 0.0 {
        let d = fxNear(ro, rd, L * 0.2, L * 0.8);
        fx += (GS_PALE * halo(d, 0.5 + 1.5 * release) * 0.9 + GS_SKY * halo(d, 2.0 + 2.5 * release) * 0.3) * sin(3.1416 * min(release * 2.0, 1.0)) * (1.0 - release) * roomFade(d);
    }
    return (fx * uFx) + cx_more(ro, rd, px) * uFx;
}

