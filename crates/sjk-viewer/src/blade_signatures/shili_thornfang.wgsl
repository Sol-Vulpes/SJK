fn kLeaf(ro: vec3<f32>, rd: vec3<f32>, px: f32, y: f32, a: f32, len: f32, curl: f32, w: f32, hot: vec3<f32>, col: vec3<f32>) -> vec3<f32> {
    var bWs: f32 = 0.0;
    var best: f32 = 1.0e3;
    var bf: f32 = 0.0;
    var s: f32;
    var prev = around(0.5, a, y);
    for (var i = 1; i <= 6; i++) {
        let f = f32(i) / 6.0;
        let q = around(0.5 + len * f * 0.75, a + 0.04 * sin(uClock * 0.5 + a * 20.0) * f, y + len * f * (0.85 - curl * f));
        let d = raySeg(ro, rd, prev, q, &s);
        {
            let wN = bW(d);
            bWs += wN;
            best = min(best, d);
            bf += ((f32(i) - 1.0 + s) / 6.0 - bf) * wN / bWs;
        }
        prev = q;
    }
    let ww = w * (1.0 - bf * bf) * smoothstep(0.0, 0.12, bf) + 0.01;
    return hot * (1.0 - smoothstep(ww * 0.6, ww + px, best)) * 0.85 + col * halo(best, ww * 3.0) * 0.42;
}

