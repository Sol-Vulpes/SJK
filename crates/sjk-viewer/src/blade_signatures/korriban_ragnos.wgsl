// Korriban Ragnos: the instant a strike lands perfectly, held in a blade forged in the Sith
// tombs of Korriban. Its own body is obsidian black with a crimson rim, fine red cracks of light
// breathing through it; cursed flames of black and red lick up its edges; the air round it ripples
// as if space bends near it, and its image splits for a heartbeat into red and blue ghosts each
// time black sparks crackle off its edges. Red-black cinders drift slowly round it. Every 18
// seconds the black flash itself: the space round the blade darkens and draws in, the cracks
// glow hotter and turn from red to violet, then it strikes: black lightning wreathed in red
// bursts out of the blade's whole body all round, the blade blazes white-violet for a moment and
// the cursed flames flare tall, and it settles back to black. It opens like a crack of red light
// splitting up from the emitter, and goes out as its black falls apart into drifting cinders. Swung,
// the air ripples harder behind it. A clash is a small black flash. Its trail is the black flash
// (`@trail ragnos`). No figures, no rings.
const BF_RED: vec3<f32> = vec3<f32>(0.95, 0.06, 0.08);

const BF_DEEP: vec3<f32> = vec3<f32>(0.35, 0.0, 0.03);

const BF_BLACK: vec3<f32> = vec3<f32>(0.02, 0.0, 0.01);

const BF_HOT: vec3<f32> = vec3<f32>(1.0, 0.55, 0.5);

const BF_WHITE: vec3<f32> = vec3<f32>(1.0, 0.93, 0.92);

fn bf_life() -> f32 {
    if uAge >= 2000.0 {
        return 1.0 - smoothstep(0.0, 0.9, uAge - 2000.0);
    }
    return smoothstep(0.0, 0.45, uAge);
}

fn bf_after() -> f32 {
    if uAge >= 2000.0 {
        return 1.0 - smoothstep(0.0, 0.4, uAge - 2000.0);
    }
    return smoothstep(0.4, 1.3, uAge);
}

fn bf_top() -> f32 {
    return (uLength + 0.4) * bf_life();
}

fn bf_flow(p: vec2<f32>) -> f32 {
    var v = sin(p.x + 1.5 * sin(p.y * 0.9 + 0.4));
    v += 0.8 * sin(p.y * 1.3 + 1.2 * sin(p.x * 1.2 + 1.9));
    v += 0.5 * sin((p.x - p.y) * 2.0 + 1.0 * sin(p.y * 2.1 + 0.7));
    return 0.5 + v / 4.6;
}

// The black flash on its 18-second cycle: `draw` the space darkening and drawing in before it,
// `strike` (0 to 1 over its burst, below 0 when none), smooth both ways.
fn bf_flash(draw: ptr<function, f32>) -> f32 {
    (*draw) = 0.0;
    if part(3.0) < 0.5 {
        return -1.0;
    }
    let c = glsl_mod(uClock + uSeed * 8.0, 18.0);
    let on = bf_after();
    (*draw) = smoothstep(11.0, 13.5, c) * (1.0 - smoothstep(13.4, 14.3, c)) * on;
    return select(-1.0, (c - 13.5) / 2.0, (c >= 13.5 && c < 15.5 && on > 0.5));
}

fn bf_half(y: f32, top: f32) -> f32 {
    let s = clamp(y / max(uLength, 1.0), 0.0, 1.0);
    let w = 0.58 + 0.1 * smoothstep(0.0, 0.12, s);
    let tip = clamp((top - y) / 2.8, 0.0, 1.0);
    return w * sqrt(tip);
}

fn bf_out(b: vec2<f32>, top: f32, half: ptr<function, f32>) -> f32 {
    let y = clamp(b.y, 0.0, max(top, 0.0));
    (*half) = bf_half(y, top);
    return length(vec2(max(abs(b.x) - (*half), 0.0), b.y - y));
}

fn sig_glow_tc(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = bf_top();
    var col: vec3<f32> = vec3<f32>(0.0);
    if top > 0.15 {
        var half: f32;
        let d = bf_out(b, top, &half);
        var draw: f32;
        let strike = bf_flash(&draw);
        col = BF_RED * halo(d, 0.45) * 0.9 + BF_DEEP * halo(d, 1.3) * 0.7 + BF_HOT * halo(d, 0.12) * 0.4;
        // effect 2: dark heat (1/11/2026, replacing the rippling rings Creyon disliked): dark red
        // heat rising off the blade in slow wavering columns, stronger as it is swung and as the
        // flash draws in
        if part(1.0) > 0.5 && uFx > 0.0 {
            let sw = smoothstep(0.1, 0.8, clamp(uSwing, 0.0, 1.0));
            let col1 = bf_flow(vec2(b.x * 0.35 + clamp(b.x * 2.0, -1.0, 1.0) * 3.0, b.y * 0.12 - tCalm() * 0.45));
            // (update 16) torn, flame-like columns instead of soft round glows
            let heat = smoothstep(0.55, 0.72, col1) * (1.0 - smoothstep(0.4, 2.4 + 1.0 * sw + 1.0 * draw, d)) * smoothstep(0.15, 0.6, d);
            col += BF_DEEP * heat * (0.6 + 0.6 * sw + 0.8 * draw) * smoothstep(-0.5, 1.5, b.y) * (1.0 - smoothstep(top - 2.0, top + 0.5, b.y)) * uFx;
        }
        // effect 6 (with Black sparks): the split, each time sparks crackle its image splits for a
        // heartbeat into a red ghost on one side and a blue one on the other
        if part(2.0) > 0.5 && uFx > 0.0 {
            let beat = pow(0.5 + 0.5 * sin((uTime * 0.5) * 0.9 * 6.2832 + uSeed * 3.0), 12.0) + 0.8 * draw;
            if beat > 0.01 {
                let off = 0.35 + 0.25 * beat;
                let yy = clamp(b.y, 0.0, top);
                let dl = length(vec2(b.x + off, b.y - yy));
                let dr2 = length(vec2(b.x - off, b.y - yy));
                col += (vec3<f32>(1.0, 0.05, 0.1) * halo(dl, 0.35) + vec3<f32>(0.15, 0.3, 1.0) * halo(dr2, 0.35)) * beat * 0.6 * uFx;
            }
        }
        // the space drawing in before the flash: the light round it dims
        col *= 1.0 - 0.5 * draw * (1.0 - halo(d, 0.6));
        if strike >= 0.0 {
            col += (BF_HOT * halo(d, 1.5 + 3.0 * strike) + BF_RED * halo(d, 4.0) * 0.6) * (1.0 - strike) * (1.0 - strike) * 1.2;
        }
    }
    // effect 9: the crimson ember, a red glow smouldering round the emitter, breathing slowly
    {
        let br = 0.75 + 0.25 * sin((uTime * 0.5) * 0.9);
        let de = length(vec2(b.x * 0.8, max(b.y, 0.0)));
        col += BF_RED * halo(de, 1.4) * 0.5 * br * (1.0 - smoothstep(-1.0, 3.0, b.y) * 0.6);
    }
    col += lvl(g) * BF_RED * (1.0 - smoothstep(0.3, 2.0, abs(b.y))) * 0.5;
    // nothing over the point (Creyon): what it draws fades out just past its tip
    col *= tipFadeB(b);
    return col * roomFade(abs(b.x)) * (1.0 + 0.8 * clamp(uClash, 0.0, 1.0));
}

fn sig_core_d(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * vec3<f32>(1.0, 0.4, 0.4) * 0.25 * (1.0 - smoothstep(0.3, 2.0, b.y));
}

// effect 1: the obsidian body, black glass with a crimson rim and fine red cracks of light
// breathing through it (warped sines, so no grid); it opens as a red crack splitting up from the
// emitter; at the flash it blazes white-red
// effect 5: cursed flames, black flames with red edges licking up off both its sides in smooth
// tongues (warped sines), flaring tall at the black flash
fn bf_flames(b: vec2<f32>, d: f32, top: f32, strike: f32) -> vec4<f32> {
    // (update 18, Creyon: not round; they must come and fade, and not look childish) real fire: a
    // field of warped currents rising along the blade eats away at a body of flame that thins with
    // distance, so tongues form, tear free and burn out by themselves; black where the fire is deep,
    // through crimson to a last red light at its thin edges
    if part(4.0) < 0.5 || uFx <= 0.0 || d > 6.0 || b.y < 0.8 {
        return vec4<f32>(0.0);
    }
    let side = select(0.0, 2.7, b.x < 0.0);
    let flare = select(0.0, sin(3.1416 * min(strike * 1.3, 1.0)), strike >= 0.0);
    let tm = uClock * 0.85;
    let p = vec2(side + d * 0.62, b.y * 0.24 - tm * 1.05 - d * 0.2);
    let w = vec2(rxFlow(p * 1.3 + 11.0), rxFlow(p * 1.7 + 29.0)) - 0.5;
    let v = 0.68 * rxFlow(p + w * 1.5) + 0.36 * rxFlow(p * 2.5 + w * 2.4 + 7.0);
    // the fire comes and goes along the blade in slow waves
    let come = smoothstep(0.28, 0.66, rxFlow(vec2(b.y * 0.1 - tm * 0.32, side * 1.3 + tm * 0.11)));
    let reach = (1.1 + 3.4 * come) * (1.0 + 0.7 * flare) * bf_after();
    let f = v - 0.2 - d / max(reach, 0.05) * 0.72;
    let a = smoothstep(0.0, 0.26, f);
    let span = smoothstep(0.8, 4.5, b.y) * (1.0 - smoothstep(top - 3.5, top - 0.1, b.y));
    // hot at its thin edges, as fire round a black coal
    var col = mix(vec3<f32>(1.0, 0.45, 0.2), BF_RED * 1.05, smoothstep(0.0, 0.05, f));
    col = mix(col, BF_DEEP * 1.1, smoothstep(0.04, 0.16, f));
    col = mix(col, BF_BLACK, smoothstep(0.08, 0.3, f));
    return vec4(col, a * 0.9 * span);
}

fn sig_solid_raw(o_in: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    var o = o_in;
    let top = bf_top();
    if top < 0.15 || b.y < -0.3 || b.y > top + 0.5 {
        return o;
    }
    var half: f32;
    let dOut = bf_out(b, top, &half);
    {
        var dr0: f32;
        let st0 = bf_flash(&dr0);
        let fl = bf_flames(b, dOut, top, st0);
        o = vec4(mix(o.rgb, fl.rgb, fl.a), max(o.a, fl.a));
    }
    let x = abs(b.x);
    let cov = fillD(x - half, min(px, 0.05)) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(x / max(half, 0.01), 0.0, 1.0);
    var draw: f32;
    let strike = bf_flash(&draw);
    var col = mix(BF_BLACK, BF_DEEP * 0.6, smoothstep(0.5, 0.95, u));
    col += BF_RED * smoothstep(0.78, 1.0, u) * 1.1;
    if part(0.0) > 0.5 {
        let c1 = abs(bf_flow(vec2(b.x * 3.5 + 2.0, b.y * 0.35 + (uTime * 0.5) * 0.15)) - 0.5);
        let c2 = abs(bf_flow(vec2(b.x * 5.0 - 1.0, b.y * 0.6 - (uTime * 0.5) * 0.1 + 4.0)) - 0.5);
        let crack = (1.0 - smoothstep(0.0, 0.035, c1)) + (1.0 - smoothstep(0.0, 0.025, c2)) * 0.6;
        let breathe = 0.55 + 0.45 * sin((uTime * 0.5) * 0.8 + b.y * 0.1);
        col += mix(BF_RED, vec3<f32>(0.7, 0.2, 1.0), draw) * crack * breathe * (0.8 + 1.5 * draw);
        col += BF_HOT * crack * crack * 0.3 * breathe;
    }
    // opening: a red crack splitting up it before the black fills in
    let opening = select(0.0, 1.0 - smoothstep(0.3, 1.0, uAge), uAge < 2000.0);
    col = mix(col, BF_RED * 1.2 + BF_HOT * halo(b.x, 0.15), opening * 0.85);
    // going out: its black breaking up into cinders from the edges in
    if uAge >= 2000.0 {
        col += BF_RED * smoothstep(0.4, 1.0, u) * clamp((uAge - 2000.0) / 0.6, 0.0, 1.0);
    }
    if strike >= 0.0 {
        col = mix(col, mix(BF_WHITE, vec3<f32>(0.85, 0.7, 1.0), 0.5), smoothstep(0.0, 0.06, strike) * (1.0 - smoothstep(0.05, 0.7, strike)) * 0.85);
    }
    col += BF_HOT * halo(top - b.y, 0.8) * 0.4 + BF_HOT * halo(max(b.y, 0.0), 0.8) * 0.6;
    col = mix(col, BF_WHITE, 0.5 * clamp(uClash, 0.0, 1.0));
    let a = cov;
    return vec4(mix(o.rgb, col, a), max(o.a, a));
}

// A jagged bolt from a to c through the ray (12 kinks, sideways and in depth, widest at its
// middle); f returns where along it the nearest point is.
fn bf_bolt(ro: vec3<f32>, rd: vec3<f32>, a: vec3<f32>, c: vec3<f32>, seed: f32, jag: f32, f: ptr<function, f32>) -> f32 {
    let ab = c - a;
    let len = length(ab);
    let side = normalize(cross(ab, vec3<f32>(0.31, 0.12, 0.94)) + vec3<f32>(1.0e-4));
    let up = normalize(cross(side, ab) + vec3<f32>(1.0e-4));
    var bWs: f32 = 0.0;
    var best: f32 = 1.0e3;
    var s: f32;
    (*f) = 0.0;
    var prev = a;
    for (var i = 1; i <= 12; i++) {
        let k = f32(i) / 12.0;
        let env = sin(3.1416 * k);
        var p = a + ab * k;
        if i < 12 {
            p += (side * (h11(seed * 7.3 + k * 29.0) - 0.5) + up * (h11(seed * 2.9 + k * 13.0) - 0.5)) * jag * len * env;
        }
        let d = raySeg(ro, rd, prev, p, &s);
        {
            let wN = bW(d);
            bWs += wN;
            best = min(best, d);
            (*f) += ((f32(i) - 1.0 + s) / 12.0 - (*f)) * wN / bWs;
        }
        prev = p;
    }
    return best;
}

// black lightning: a black thread (drawn as missing light: the red glow round it, its heart
// dark) wrapped in crimson
fn bf_black_bolt(d: f32, px: f32, w: f32) -> vec3<f32> {
    return BF_RED * (halo(d, w * 5.0 + 0.25) * 0.9 - halo(d, max(w, px)) * 0.6) + BF_HOT * halo(d, w * 2.0) * 0.15;
}

// effect 3: black sparks, short forks of black lightning with red halos crackling off the edges
fn bf_sparks(ro: vec3<f32>, rd: vec3<f32>, px: f32, draw: f32) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    var f: f32;
    if fxNear(ro, rd, 0.0, L) > 16.0 {
        return acc;
    }
    for (var i = 0; i < 5; i++) {
        let k = f32(i);
        let cyc = (uTime * 0.5) * (0.9 + 0.3 * h11(k * 3.1)) + h11(k * 5.7);
        let n = floor(cyc);
        let q = fract(cyc);
        if q > 0.4 {
            continue;
        }
        let life = smoothstep(0.0, 0.04, q) * (1.0 - smoothstep(0.12, 0.4, q)) * (1.0 + draw);
        let a = h11(n * 4.3 + k * 1.9);
        let y = L * (0.1 + 0.85 * h11(n * 1.7 + k));
        let pa = around(0.6, a, y);
        let pc = around(1.8 + 1.5 * h11(n * 8.3 + k), a + 0.06 * (h11(n * 6.1 + k) - 0.5), y + (h11(n * 2.9 + k) - 0.5) * 3.0);
        let d = bf_bolt(ro, rd, pa, pc, n * 13.7 + k * 3.0, 0.3, &f);
        acc += bf_black_bolt(d, px, 0.05) * life * (1.0 - 0.5 * f);
    }
    return acc;
}

// effect 4: the black flash's burst, black lightning wreathed in red thrown out of the blade's
// body all round, and a ring of red pressure rolling out
fn bf_burst(ro: vec3<f32>, rd: vec3<f32>, px: f32, strike: f32) -> vec3<f32> {
    if strike < 0.0 {
        return vec3<f32>(0.0);
    }
    var acc: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    var f: f32;
    let fade = (1.0 - strike) * (1.0 - strike) * smoothstep(0.0, 0.04, strike);
    for (var i = 0; i < 9; i++) {
        let k = f32(i);
        let a = (k + 0.5) / 9.0 + 0.05 * h11(k * 3.3);
        let y = L * (0.25 + 0.6 * h11(k * 5.9));
        let reach = (3.0 + 5.0 * sqrt(strike)) * (0.7 + 0.3 * h11(k * 1.3));
        let pa = around(0.6, a, y);
        let pc = around(reach, a + 0.04, y + (h11(k * 7.7) - 0.5) * 6.0);
        let d = bf_bolt(ro, rd, pa, pc, k * 11.0 + floor(strike * 5.0), 0.3, &f);
        acc += bf_black_bolt(d, px, 0.07) * fade * (1.0 - 0.4 * f) * roomFade(reach) * 1.4;
    }
    return acc;
}

// effects 5 and 6: opening, red light spilling up out of the crack as it splits; going out,
// cinders of its black, red at their edges, drifting off and falling away
fn bf_moments(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    var t: f32;
    if uAge < 0.9 {
        let on = smoothstep(0.0, 0.1, uAge) * (1.0 - smoothstep(0.4, 0.9, uAge));
        let y = bf_top();
        let d = rayPt(ro, rd, vec3(0.0, y, 0.0), &t);
        acc += (BF_HOT * halo(d, 0.4) + BF_RED * halo(d, 1.5) * 0.6) * on;
    } else if uAge >= 2000.0 && uAge < 2001.6 {
        let q = clamp((uAge - 2000.0) / 1.5, 0.0, 1.0);
        for (var i = 0; i < 10; i++) {
            let k = f32(i);
            let p = around(0.6 + 1.8 * q * h11(k * 4.1), h11(k * 6.3) + 0.1 * q, uLength * h11(k * 2.9) + 1.0 * q - 3.0 * q * q);
            let d = rayPt(ro, rd, p, &t);
            let s = 0.1 + 0.08 * h11(k * 1.7);
            acc += (BF_RED * halo(d, s * 0.8) * 1.2 + BF_DEEP * halo(d, s * 2.5) * 0.4) * (1.0 - q) * roomAt(p);
        }
    }
    return acc;
}

// effect 9: red-black cinders drifting slowly round the blade, glowing at their edges
fn bf_cinders(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    var t: f32;
    if fxNear(ro, rd, 0.0, L) > 16.0 {
        return acc;
    }
    for (var i = 0; i < 6; i++) {
        let k = f32(i);
        let a = h11(k * 3.1) + (uTime * 0.5) * (0.025 + 0.02 * h11(k * 1.7));
        let y = L * (0.1 + 0.85 * fract(h11(k * 7.7) + (uTime * 0.5) * 0.012));
        let p = around(1.4 + 1.6 * h11(k * 5.5), a, y);
        let d = rayPt(ro, rd, p, &t);
        let s = 0.09 + 0.06 * h11(k * 2.2);
        acc += (BF_RED * halo(d, s * 0.8) * 1.0 + BF_DEEP * halo(d, s * 3.0) * 0.3) * (0.6 + 0.4 * sin((uTime * 0.5) * 1.3 + k)) * roomAt(p);
    }
    return acc;
}

// effect 7: the clash, a small black flash: a red flare and three forks of black lightning
fn bf_clash(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let cl = clamp(uClash, 0.0, 1.0);
    if cl <= 0.01 {
        return vec3<f32>(0.0);
    }
    let at = vec3(0.0, uLength * 0.6, 0.0);
    var t: f32;
    var f: f32;
    if rayPtRaw(ro, rd, at, &t) > 7.0 {
        return vec3<f32>(0.0);
    }
    var acc = BF_HOT * halo(rayPt(ro, rd, at, &t), 0.9) * cl * 1.3;
    for (var i = 0; i < 4; i++) {
        let k = f32(i);
        let pc = at + around(2.5 + 2.0 * (1.0 - cl), k / 4.0 + 0.1, (h11(k * 3.3) - 0.5) * 3.0);
        let d = bf_bolt(ro, rd, at, pc, k * 7.0 + floor(cl * 6.0), 0.3, &f);
        acc += bf_black_bolt(d, px, 0.06) * cl;
    }
    return acc;
}

// Sith lightning leaping off the blade (update 16): four forked bolts, each lit for a third of a
// second about once a second, thrown two to five units out from anywhere along the blade, a fork
// splitting off its middle; white-hot cores in a heavy crimson glow
fn bf_leap(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    if fxNear(ro, rd, 0.0, L) > 16.0 {
        return acc;
    }
    for (var i = 0; i < 3; i++) {
        let k = f32(i);
        let cyc = uTime * (0.85 + 0.3 * h11(k * 3.1)) + h11(k * 5.7);
        let n = floor(cyc);
        let q = fract(cyc);
        if q > 0.33 {
            continue;
        }
        let life = smoothstep(0.0, 0.03, q) * (1.0 - smoothstep(0.1, 0.33, q));
        let a = h11(n * 4.3 + k * 1.9);
        let y = L * (0.08 + 0.85 * h11(n * 1.7 + k));
        let pa = around(0.55, a, y);
        let pc = around(2.5 + 2.5 * h11(n * 8.3 + k), a + 0.05 * (h11(n * 6.1 + k) - 0.5), y + (h11(n * 2.9 + k) - 0.4) * 4.0);
        let pm = mix(pa, pc, 0.5);
        let pf = pm + around(1.2 + 1.2 * h11(n * 3.3 + k), a + 0.12, (h11(n * 7.1 + k) - 0.5) * 3.0);
        let d = min(bolt3(ro, rd, pa, pc, n * 13.7 + k * 3.0, 0.3, px), bolt3(ro, rd, pm, pf, n * 5.9 + k, 0.35, px));
        acc += (vec3<f32>(1.0, 0.85, 0.85) * halo(d, max(0.05, px)) * 2.0 + BF_RED * halo(d, 0.35) * 1.0 + BF_RED * halo(d, 1.3) * 0.25) * life;
    }
    return acc;
}

fn sig_vol_base(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return fx;
    }
    let after = bf_after();
    var draw: f32;
    let strike = bf_flash(&draw);
    if part(4.0) > 0.5 && after > 0.01 {
        fx += bf_cinders(ro, rd, px) * after;
    }
    fx += bf_burst(ro, rd, px, strike);
    fx += bf_moments(ro, rd, px) + bf_clash(ro, rd, px);
    // the Sith lightning (1/11/2026, lighter: crimson bolts on the lab's shells, one look-up a
    // pixel, where the old black bolts cost a loop of 3D segments twice over)
    if part(2.0) > 0.5 && after > 0.01 {
        let flare = select(0.0, 1.0 - strike, strike >= 0.0);
        let y1 = uLength - 0.8;
        // (update 16, Creyon: "the lightning is really weak and sad") Sith lightning over the whole
        // blade to its point: white-hot forks in a strong crimson glow crawling over it at a steady
        // quick crackle (its rate no longer jumps with the flash; the flash brightens it), longer
        // bolts further out, and forked bolts leaping off it
        let boost = 1.0 + 1.5 * flare + 1.5 * clamp(uClash, 0.0, 1.0);
        let top = bf_top();
        // (update 31, Creyon) its lightning turns with the blade under an RGB
        uTurnFx += 2.4 * boost * shBolts(ro, rd, px, 0.75, 0.4, top - 0.15, 4.0, 6.0, 2.5, 0.35, 3.0, mix(BF_HOT, vec3<f32>(1.0), 0.5), BF_RED * 1.3) * after * uFx * tipFade(ro, rd) * hiltFade(ro, rd);
        uTurnFx += (bf_leap(ro, rd, px) * boost * after) * uFx * tipFade(ro, rd) * hiltFade(ro, rd);
    }
    return fx * uFx;
}

// dark smoke curling up off the cursed flames, from well above the hilt
fn sig_vol_solid_base(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    if uFx <= 0.0 || part(4.0) < 0.5 || bf_after() <= 0.01 || fxNear(ro, rd, 0.0, uLength) > 16.0 {
        return vec4<f32>(0.0);
    }
    // (update 16, Creyon: the effects round it looked round) the smoke shells are gone; the cursed
    // flames (drawn in the blade's picture, jagged) carry the dark
    return vec4<f32>(0.0);
}

fn sig_vol_tc(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx = sig_vol_base(ro, rd, px);
    if uFx > 0.0 && part(5.0) > 0.5 {
        fx += x14_korriban_ragnos(ro, rd, px) * uFx * rxLife(0.3, 1.0, 0.6);
    }
    return fx * hiltFade(ro, rd);
}

fn sig_vol_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    let o = sig_vol_solid_base(ro, rd, px);
    return o * hiltFade(ro, rd);
}

// effect 6 (1/11/2026, update 14): the bleeding crystal, the blade bleeding as a Sith crystal does:
// beads of red light well up on its face, run slowly down it leaving a glowing trail, gather into
// a drop and fall away into the dark
fn x14_korriban_ragnos(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, 0.0, uLength) > 16.0 {
        return acc;
    }
    var t: f32;
    var s: f32;
    for (var i = 0; i < 4; i++) {
        let k = f32(i);
        let cyc = uTime * (0.1 + 0.04 * h11(k * 3.1)) + h11(k * 7.7);
        let n = floor(cyc);
        let q = fract(cyc);
        let a = h11(n * 4.3 + k * 1.9);
        let y0 = uLength * (0.45 + 0.45 * h11(n * 2.7 + k));
        let run = smoothstep(0.1, 0.7, q);
        let yRun = y0 - run * uLength * 0.25;
        let head = around(0.6, a, yRun);
        let tail = around(0.6, a, mix(y0, yRun, 0.35));
        let d = raySeg(ro, rd, tail, head, &s);
        let swell = smoothstep(0.0, 0.1, q) * (1.0 - smoothstep(0.7, 0.76, q));
        acc += (vec3<f32>(1.0, 0.3, 0.22) * halo(d, max(0.07 + 0.09 * s, px)) * 2.2 + vec3<f32>(0.7, 0.0, 0.03) * halo(d, 0.3) * 0.45) * swell * (0.25 + 0.75 * s);
        if q > 0.7 {
            let f = (q - 0.7) / 0.3;
            let drop = around(0.6 + 0.4 * f, a, yRun - 9.0 * f * f);
            let dd = rayPt(ro, rd, drop, &t);
            acc += (vec3<f32>(1.0, 0.4, 0.32) * halo(dd, max(0.16, px)) * 2.4 + vec3<f32>(0.8, 0.0, 0.05) * halo(dd, 0.45) * 0.4) * (1.0 - f);
        }
    }
    return acc;
}

// (update 26) the body starts softly in the emitter, no hard end above the hilt
fn sig_solid_l(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let r = sig_solid_raw(o, b, px);
    let j = smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, r.rgb, j), mix(o.a, r.a, j));
}

// (update 29, Creyon: nothing past the tip) every effect ends at the blade's end
fn sig_vol_34(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let fx = sig_vol_tc(ro, rd, px);
    var s: f32;
    _ = raySeg(ro, rd, vec3<f32>(0.0), vec3(0.0, uLength + 4.0, 0.0), &s);
    return fx * tipFade(ro, rd);
}

fn sig_glow_34(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_tc(g, b, r, px) * tipFadeB(b);
}

// >>> update 34: this blade's signature piece
const SX_HOT: vec3<f32> = vec3<f32>(0.950, 0.080, 0.100);

const SX_DEEP: vec3<f32> = vec3<f32>(0.350, 0.000, 0.030);

const SX_PALE: vec3<f32> = vec3<f32>(1.000, 0.450, 0.420);

fn sig_vol_p1(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let fx = sig_vol_34(ro, rd, px);
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, uLength) > 16.0 {
        return fx;
    }
    let L = uLength;
    let C = uClock;
    var a: vec3<f32> = vec3<f32>(0.0);
    a += sxDrops(ro, rd, px, 10.0, 1.3, 0.09, 51.0, SX_HOT, SX_DEEP);
    a += 1.1 * sxStrike(ro, rd, px, 2.0, 0.23, 6.0, 52.0, SX_HOT);
    return fx + a * rxLife(0.35, 1.3, 0.35) * uFx * tipFade(ro, rd) * hiltFade(ro, rd);
}

fn sig_glow_d(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    var col = sig_glow_34(g, b, r, px);
    if uFx > 0.0 {
        col += (0.85 * sxFlames(b, 0.85, 2.6, 1.7, SX_HOT, SX_DEEP * 0.5)) * rxLife(0.35, 1.3, 0.35) * tipFadeB(b) * uFx;
    }
    return col;
}

// <<< update 34
// >>> update 42: this blade's great effects in the air
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var a: vec3<f32> = vec3<f32>(0.0);
    let base = sig_vol_p1(ro, rd, px);
    let L = uLength;
    let C = uClock;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return base;
    }
    // the tomb of Marka Ragnos: great slabs of obsidian lifting off the ground and turning slowly up past the blade, lit red along their edges,
    // and the old Sith's souls climbing among them as dark red lights
    a += 1.35 * gxTumble(ro, rd, px, 9.0, 5.2, 2.0, 0.0, 0.72, 31.0, vec3<f32>(1.0, 0.42, 0.26), vec3<f32>(0.42, 0.015, 0.03));
    a += 1.2 * gxLanterns(ro, rd, px, 5.0, 4.4, 32.0, vec3<f32>(1.0, 0.5, 0.34), vec3<f32>(0.62, 0.03, 0.05));
    a += 0.95 * syMistSpin(ro, rd, 0.3, L * 0.96, 1.2, 5.0, 0.012, 11.0, vec3<f32>(0.34, 0.02, 0.03), vec3<f32>(0.03, 0.002, 0.006));
    return base + a * rxLife(0.3, 1.0, 0.35) * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

// <<< update 42
// >>> dim: less glow, so its effects and body can be seen
fn sig_glow_grown(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_d(g, b, r, px) * (0.82 + 0.38 * sin(b.y * 0.3 - uClock * 2.4));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return sig_core_d(c, b, px) * 1.0;
}

// <<< dim
// >>> life: waves of light running along its body
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let r = sig_solid_l(o, b, px);
    if r.a <= 0.0 {
        return r;
    }
    return vec4(r.rgb * (0.85 + 0.9 * pow(0.5 + 0.5 * sin(b.y * 0.3 - uClock * 2.4), 3.0)), r.a);
}

// <<< life
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_grown(g, b, r, px) * growGlow(b);
}
