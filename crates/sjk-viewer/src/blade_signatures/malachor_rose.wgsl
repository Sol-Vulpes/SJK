// Malachor Rose (id saber_malachor_rose): the Force as it was wielded on Malachor V, drawn to a single thin edge: a body of pale rose light clouded with white, climbing the blade, a fine sheen along its outline and a narrow tear in space around it. Long crescents of white light and crimson wheel round it in dark red air, with small stars.
const RK_WHITE: vec3<f32> = vec3<f32>(1.0, 0.95, 1.0);

const RK_PALE: vec3<f32> = vec3<f32>(0.98, 0.72, 0.96);

const RK_LAV: vec3<f32> = vec3<f32>(0.82, 0.5, 0.95);

const RK_PURPLE: vec3<f32> = vec3<f32>(0.48, 0.14, 0.72);

const RK_PINK: vec3<f32> = vec3<f32>(1.0, 0.3, 0.72);

const RK_DARK: vec3<f32> = vec3<f32>(0.045, 0.004, 0.03);

// how far it has come out: a little slower than a saber, smooth at both ends
fn rk_life() -> f32 {
    if uAge >= 2000.0 {
        return 1.0 - smoothstep(0.0, 0.45, uAge - 2000.0);
    }
    return smoothstep(0.0, 0.55, uAge);
}

// (update 30, Creyon: no black line, a cool effect instead) the rose aura: a flame of rose light round the blade
fn rk_aura_on() -> f32 {
    if part(0.0) < 0.5 || uFx <= 0.0 {
        return 0.0;
    }
    return select(smoothstep(0.45, 1.5, uAge), 1.0 - smoothstep(0.0, 0.25, uAge - 2000.0), uAge >= 2000.0);
}

// its two edges across the blade at y, its whole length L: x one edge, y the other
fn rk_edges(y: f32, L: f32) -> vec2<f32> {
    // (update 30, Creyon: make the hilt normal) the blade leaves the emitter at nearly its whole width
    // (update 30, Creyon's picture) the crescent: the whole blade one long bow, thin at both ends, its belly out away
    // from the inside. Over the other shapes when it is on; both off, it is the straight blade
    var w = 1.12 * mix(0.62, 1.0, smoothstep(0.0, 1.4, y));
    // the sword: a long parallel run, straight lines to the point
    w = min(w, 1.12 * max(L - y, 0.0) / 5.2);
    let ed = vec2(-w, w);
    return ed;
}

// how far b lies outside the blade (negative inside); a clean edge
fn rk_d(b: vec2<f32>, L: f32, e: ptr<function, vec2<f32>>) -> f32 {
    let yc = clamp(b.y, 0.0, L);
    (*e) = rk_edges(yc, L);
    let inside = max((*e).x - b.x, b.x - (*e).y);
    let past = max(b.y - L, -b.y);
    return select(inside, length(vec2(max(inside, 0.0), past)), past > 0.0);
}

// torn space (update 30, after Creyon's picture): behind the blade the air opens on a crimson and violet
// night with small stars in it, and long tapered strokes of red energy sweep along the blade
// Its great moment: the light gathers slowly, the sheen, the storm and the crescents swell for a while, and it breathes out again.
fn gk_surge() -> f32 {
    return rxCycle(44.0, 16.0, 23.0, 29.0, 38.0);
}

fn rk_rift_on() -> f32 {
    if part(1.0) < 0.5 || uFx <= 0.0 {
        return 0.0;
    }
    let g = select(smoothstep(0.7, 2.4, uAge), 1.0 - smoothstep(0.0, 0.25, uAge - 2000.0), uAge >= 2000.0);
    return g;
}

fn sig_glow_tc(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let L = (uLength + 0.2) * rk_life();
    if L < 0.15 {
        return vec3<f32>(0.0);
    }
    var e: vec2<f32>;
    let d = max(rk_d(b, L, &e), 0.0);
    // only what a burning edge gives off: thin, close, never a cloud
    // a fine sheen hugging its outline
    var col = vec3<f32>(1.0, 0.62, 0.9) * (halo(d, 0.1) * 1.15 + halo(d, 0.32) * 0.72) + vec3<f32>(0.95, 0.2, 0.62) * halo(d, 0.85) * 0.42;
    if part(0.0) > 0.5 {
        col += vec3<f32>(0.62, 0.03, 0.2) * (halo(d, 1.1) * 0.3 + halo(d, 3.0) * 0.09);
    }
    if part(0.0) > 0.5 && uFx > 0.0 {
        let on = select(smoothstep(0.5, 2.2, uAge), 1.0 - smoothstep(0.0, 0.25, uAge - 2000.0), uAge >= 2000.0);
        let w0 = 0.75 + 0.75 * rxFlow(vec2(b.y * 0.14 - uClock * 0.3, select(6.0, 2.0, b.x > e.x)));
        let wall = 1.0 - smoothstep(w0 * 0.55, w0 * 1.15, d);
        let inner = 0.55 + 0.45 * rxFlow(vec2(b.x * 0.9 + uClock * 0.1, b.y * 0.2 - uClock * 0.35));
        let ends = smoothstep(0.0, 2.5, b.y) * (1.0 - smoothstep(L - 0.5, L + 1.2, b.y));
        col += vec3<f32>(0.5, 0.02, 0.14) * wall * inner * 0.22 * on * ends;
    }
    // the crimson aura: tall soft flames streaming up both edges, dark red like the picture
    let aura = rk_aura_on();
    if aura > 0.01 && d < 4.0 {
        let side = select(8.0, 2.0, b.x > 0.5 * (e.x + e.y));
        let f1 = rxFlow(vec2(b.y * 0.3 - uClock * 1.1, side));
        let f2 = rxFlow(vec2(b.y * 0.75 - uClock * 1.7, side + 3.0));
        let along = smoothstep(0.5, 3.5, b.y) * (1.0 - smoothstep(L - 3.0, L - 0.5, b.y));
        let reach = 0.6 + 2.2 * f1 * f1 + 0.7 * f2 * f2;
        let q = clamp(d / max(reach, 0.05), 0.0, 1.0);
        let fl = (1.0 - q) * (1.0 - q) * along;
        col += mix(vec3<f32>(0.3, 0.006, 0.08), vec3<f32>(0.8, 0.04, 0.2), fl) * fl * aura * 0.5;
    }
    col *= 1.0 + 0.7 * gk_surge();
    // the sickles: long strokes of white light and red energy sweeping along it, following its own curve, tapered at both ends
    if false {
        let on = select(smoothstep(0.9, 2.6, uAge), 1.0 - smoothstep(0.0, 0.25, uAge - 2000.0), uAge >= 2000.0);
        for (var i = 0; i < 6; i++) {
            let k = f32(i);
            let white = 1.0 - glsl_mod(k, 2.0);
            let sd = select(-1.0, 1.0, k < 2.5);
            let run = uClock * (0.085 + 0.02 * h11(k * 5.3)) + h11(k * 7.7);
            let cyc = floor(run);
            let q = fract(run);
            let at = 0.25 + 0.7 * h11(k * 3.1 + cyc);
            let cy = L * (q * 1.4 - 0.2);
            let len = L * (0.3 + 0.16 * h11(k * 2.9 + cyc));
            let u0 = clamp((b.y - cy) / len, -1.0, 1.0);
            let taper = max(1.0 - u0 * u0, 0.0);
            let off = select(1.0e3, d - at, sd * (b.x - 0.5 * (e.x + e.y)) > 0.0);
            let wide = 0.025 + 0.09 * taper * taper;
            let hot = mix(vec3<f32>(1.0, 0.1, 0.28), vec3<f32>(1.0, 0.92, 1.0), white);
            let soft = mix(vec3<f32>(0.6, 0.01, 0.13), vec3<f32>(0.75, 0.36, 1.0), white);
            col += (hot * halo(abs(off), wide) * 0.7 + soft * halo(abs(off), wide * 3.0) * 0.22) * taper * taper * sin(3.1416 * q) * on;
        }
    }
    return col * roomFade(abs(b.x)) * (1.0 + 0.6 * clamp(uClash, 0.0, 1.0));
}

fn sig_core_d(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

// How far the edge's white band frays here, small flames running up it.
fn detail_jag(b: vec2<f32>, px: f32) -> f32 {
    return 0.13 * (1.0 - smoothstep(0.08, 0.3, px)) * pow(rxFlow(vec2(b.y * 2.2 - uClock * 1.5, select(7.0, 2.0, b.x > 0.0))), 2.0);
}

fn sig_solid_flat(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = (uLength + 0.2) * rk_life();
    if L < 0.15 || b.y < -0.5 || b.y > L + 2.5 {
        return o;
    }
    var e: vec2<f32>;
    let d = rk_d(b, L, &e);
    var res = o;
    let ends = smoothstep(0.0, 1.5, b.y);
    // the torn space behind it: a wound in the air flowing outward from the blade: black voids, crimson cloud with glowing
    // filaments in it, two depths of small twinkling stars, a hot edge against the blade. Everything soft where it ends.
    let rift = rk_rift_on();
    if rift > 0.01 && d > -0.05 && d < 4.2 {
        let side = select(8.0, 3.0, b.x > 0.5 * (e.x + e.y));
        // its outline is torn, not a smooth shape: two sizes of fray, all of it feathered, and it opens and closes slowly
        let tq = vec2(d * 0.35 + side * 3.0, b.y * 0.13 - uClock * 0.035);
        let frayed = d + (rxFlow(tq) - 0.5) * 0.5 + (rxFlow(tq * 2.7 + 4.0) - 0.5) * 0.26;
        let reach = (0.65 + 1.15 * rxFlow(vec2(b.y * 0.09 - uClock * 0.06, side))) * smoothstep(0.0, L * 0.12, b.y) * (1.0 - smoothstep(L * 0.9, L * 1.04, b.y));
        let a = (1.0 - smoothstep(reach * 0.25, reach * 1.2, frayed)) * rift * 0.62 * roomFade(abs(b.x));
        if a > 0.003 {
            // the far side of the tear: a black night, crimson gas drawn slowly in towards the blade, a magenta heart in the gas
            let q = vec2(d * 0.5 + uClock * 0.12 + side, b.y * 0.15 + 0.05 * sin(uClock * 0.13 + side));
            let warp = vec2(rxFlow(q * 1.1 + 3.0), rxFlow(q * 1.3 + 7.0)) - 0.5;
            let n1 = rxFlow(q + warp * 1.5);
            let n2 = rxFlow(q * 2.1 + warp * 2.2 + 5.0);
            var night = mix(vec3<f32>(0.008, 0.002, 0.02), vec3<f32>(0.2, 0.008, 0.075), smoothstep(0.42, 0.85, n1));
            night = mix(night, vec3<f32>(0.55, 0.05, 0.22), 0.6 * smoothstep(0.74, 0.98, 0.7 * n1 + 0.3 * n2));
            night *= 1.0 - 0.85 * smoothstep(0.42, 0.72, n2);
            // fine soft veins in the gas, never a drawn line
            night += vec3<f32>(1.0, 0.16, 0.42) * pow(max(1.0 - 2.0 * abs(n1 - 0.5), 0.0), 6.0) * 0.22 * (1.0 - 0.7 * smoothstep(0.52, 0.78, n2));
            // the lip of the tear, lit like an ember where the world ends, and the heat against the blade
            night += vec3<f32>(1.0, 0.35, 0.75) * halo(d, 0.5) * 0.4;
            res = vec4(mix(res.rgb, night, a), max(res.a, a));
        }
    }
    let fr = detail_jag(b, px) * 0.4;
    let cov = (1.0 - smoothstep(-0.34 - px + fr, 0.1 + px + fr, d)) * smoothstep(-0.25, 0.2, b.y);
    if cov <= 0.0 {
        return res;
    }
    // the body itself: its picture (`assets/blade_body/malachor_rose.png`, made by `scripts/blade_body.py`), lengthwise along the blade, climbing it, a second slower layer so it never repeats
    let across = clamp((b.x - e.x) / max(e.y - e.x, 0.05), 0.02, 0.98);
    let t1 = skinBody(vec2(b.y / 13.0 - uClock * 0.13, across));
    let t2 = skinBody(vec2(b.y / 21.0 - uClock * 0.055 + 0.37, 0.1 + 0.8 * across));
    let RK_MEAN: vec3<f32> = vec3<f32>(0.93, 0.71, 0.94);
    var col = clamp(RK_MEAN + 1.3 * (mix(t1, t2, 0.35) - RK_MEAN), vec3<f32>(0.0), vec3<f32>(1.0));
    col = mix(col, RK_MEAN, smoothstep(0.14, 0.6, px));
    // a thin torn white edge
    let tear = detail_jag(b, px);
    col = mix(col, RK_WHITE, (1.0 - smoothstep(0.02 + tear * 0.3, 0.4 + tear, -d)) * 0.7);
    col = mix(col, RK_WHITE, 0.5 * clamp(uClash, 0.0, 1.0));
    let keep = max(res.a, cov);
    return vec4(mix(res.rgb, col, cov / max(keep, 0.001)), keep);
}

fn sig_vol_tc(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, uLength) > 16.0 {
        return fx;
    }
    // the mist: pink energy turning slowly round it from the hand to the point (with the aura's switch)
    // the torn space's breath: red and violet air turning round it
    var t: f32;
    let cl = clamp(uClash, 0.0, 1.0);
    if cl > 0.01 {
        fx += RK_WHITE * halo(rayPt(ro, rd, vec3(0.0, uLength * 0.6, 0.0), &t), 1.0) * cl * 0.9;
    }
    return fx * rxLife(0.4, 1.0, 0.3) * hiltFade(ro, rd);
}

// (update 29, Creyon: nothing past the tip) every effect ends at the blade's end
fn sig_vol_34(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let fx = sig_vol_tc(ro, rd, px);
    var s: f32;
    _ = raySeg(ro, rd, vec3<f32>(0.0), vec3(0.0, uLength + 4.0, 0.0), &s);
    return fx * tipFade(ro, rd);
}

fn sig_glow_d(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_tc(g, b, r, px) * tipFadeB(b);
}

