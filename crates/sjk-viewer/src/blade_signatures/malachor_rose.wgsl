// >>> update 42: this blade's great effects in the air
fn sig_vol_r24(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var a: vec3<f32> = vec3<f32>(0.0);
    let base = sig_vol_p1(ro, rd, px);
    let L = uLength;
    let C = uClock;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return base;
    }
    // the dark red air round it
    if part(0.0) > 0.5 {
        a += 0.55 * syMistSpin(ro, rd, 0.3, L, 1.6, 4.4, 0.014, 332.0, vec3<f32>(0.42, 0.015, 0.12), vec3<f32>(0.06, 0.004, 0.02));
    }
    // storm behind them: dark red clouds lit from within in rose, and now and then a great star
    if part(4.0) > 0.5 {
        a += 1.25 * gxThunderheads(ro, rd, px, 5.0, 5.0, 23.0, vec3<f32>(1.0, 0.45, 0.75), vec3<f32>(0.55, 0.02, 0.16));
        a += 1.1 * gxFlares(ro, rd, px, 5.0, 5.2, 24.0, vec3<f32>(1.0, 0.86, 0.98), vec3<f32>(0.85, 0.2, 0.55));
    }
    // as in the pictures: long crescents of white light and crimson wheeling round it in the air, tapered at both ends
    if part(2.0) > 0.5 {
        for (var i = 0; i < 8; i++) {
            let k = f32(i);
            let white = 1.0 - glsl_mod(k, 2.0);
            let run = C * (0.13 + 0.014 * k) + h11(k * 7.7);
            let cyc = floor(run);
            let q = fract(run);
            let a0 = h11(k * 3.1 + cyc) + C * 0.04;
            let y0 = L * (-0.1 + 0.86 * q);
            let Rk = 2.4 + 1.5 * h11(k * 2.9 + cyc);
            let span = L * (0.26 + 0.14 * h11(k * 6.1));
            var bWs: f32 = 0.0;
            var best: f32 = 1.0e3;
            var bs: f32 = 0.0;
            var s0: f32;
            var prev = around(Rk * 0.72, a0, y0);
            for (var j = 1; j <= 8; j++) {
                let f = f32(j) / 8.0;
                let p = around(Rk * (0.72 + 0.5 * sin(3.1416 * f)), a0 + 0.24 * f, y0 + span * f);
                let dd = raySegRaw(ro, rd, prev, p, &s0);
                {
                    let wN = bW(dd);
                    bWs += wN;
                    best = min(best, dd);
                    bs += ((f32(j) - 1.0 + s0) / 8.0 - bs) * wN / bWs;
                }
                prev = p;
            }
            let taper = pow(sin(3.1416 * clamp(bs, 0.0, 1.0)), 1.4);
            let wd = max(0.03 + 0.16 * taper, px);
            let hot = mix(vec3<f32>(1.0, 0.12, 0.3), vec3<f32>(1.0, 0.94, 1.0), white);
            let soft = mix(vec3<f32>(0.62, 0.01, 0.14), vec3<f32>(0.8, 0.4, 1.0), white);
            a += (hot * halo(best, wd) * 1.05 + soft * halo(best, wd * 3.2) * 0.42) * taper * gxEnv(q);
        }
    }
    if part(3.0) > 0.5 {
        a += 1.5 * gxKin(ro, rd, 1.0, 7.0, 2.40, 0.120, 0.14, 0.08, 0.96, 1.0, 8131.0, vec3<f32>(1.0, 0.86, 1.0), vec3<f32>(0.8, 0.4, 1.0));
    }
    let sg = gk_surge();
    if sg > 0.0 {
        a += sg * 1.3 * gxHelix(ro, rd, px, 18.0, 2.2, 2.4, 0.08, 25.0, vec3<f32>(1.0, 0.86, 0.98), vec3<f32>(0.85, 0.2, 0.55));
    }
    a *= 1.0 + 0.8 * sg;
    return base + a * rxLife(0.3, 1.0, 0.35) * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

// <<< update 42
// >>> dim: less glow, so its effects and body can be seen
fn sig_glow_grown(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_d(g, b, r, px) * (0.82 + 0.4 * sin(b.y * 0.32 - uClock * 2.1));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return sig_core_d(c, b, px) * 1.0;
}

// <<< dim
// >>> life: waves of light running along its body
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let r = sig_solid_l(o, b, px);
    if r.a <= 0.0 {
        return r;
    }
    return vec4(r.rgb * (0.92 + 0.16 * pow(0.5 + 0.5 * sin(b.y * 0.32 - uClock * 2.1), 2.0)), r.a);
}

// <<< life
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_grown(g, b, r, px) * growGlow(b);
}

// >>> how it answers: as it lights, in a swing, in a clash
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_r24(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return base;
    }
    let ig = select(0.0, 1.0 - smoothstep(0.3, 3.0, uAge), uAge < 2000.0);
    let sw = clamp(uSwing, 0.0, 1.0);
    a += ig * 1.4 * gxHelix(ro, rd, px, 18.0, 2.2, 2.6, 0.16, 311.0, vec3<f32>(1.00, 0.88, 0.98), vec3<f32>(0.90, 0.20, 0.55));
    a += 1.45 * gxBurst(ro, rd, px, 12.0, 5.0, 0.0, 0.34, 312.0, vec3<f32>(1.00, 0.80, 0.95), vec3<f32>(0.80, 0.08, 0.35));
    a += 1.2 * gxBurst(ro, rd, px, 9.0, 3.6, 2.0, 0.0, 313.0, vec3<f32>(1.00, 0.92, 1.00), vec3<f32>(0.85, 0.25, 0.60));
    a += sw * 1.1 * gxComets(ro, rd, px, 3.0, 3.6, 0.08, 2.0, 314.0, vec3<f32>(1.00, 0.86, 0.98), vec3<f32>(0.85, 0.15, 0.50));
    return base + a * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}
