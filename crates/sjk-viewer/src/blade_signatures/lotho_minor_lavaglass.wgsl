// Lotho Minor Lavaglass (new 2/11/2026, update 22, in place of Lotho Minor Furnace; Lotho Minor is a junk
// world whose fires never go out): a tall tube of dark glass with molten rock in it, a lamp of lava. Soft
// round blobs of orange-gold melt rise slowly up it, stretch, join when they touch and part again,
// cool to deep red at the top and sink back. The glass is clear, a thin bright line down its edge,
// and heat shimmers off it.
const LG_GLASS: vec3<f32> = vec3<f32>(0.03, 0.02, 0.03);

const LG_RED: vec3<f32> = vec3<f32>(0.8, 0.09, 0.02);

const LG_ORANGE: vec3<f32> = vec3<f32>(1.0, 0.42, 0.05);

const LG_GOLD: vec3<f32> = vec3<f32>(1.0, 0.8, 0.3);

fn lg_top() -> f32 {
    return (uLength + 0.2) * rxLife(0.0, 0.5, 0.4);
}

fn lg_half(y0: f32, top: f32) -> f32 {
    return rxHalf(clamp(y0, 0.0, top), top, 0.72, 1.0);
}

// the melt's field at b: above 1 inside a blob; `height` how far up the hottest one is
fn lg_melt(b: vec2<f32>, tint: ptr<function, vec3<f32>>) -> f32 {
    let L = uLength;
    var f: f32 = 0.0;
    (*tint) = vec3<f32>(0.0);
    for (var i = 0; i < 9; i++) {
        let k = f32(i);
        let cyc = uClock * (0.05 + 0.025 * h11(k * 2.3)) + h11(k * 6.7);
        let q = fract(cyc);
        // up slowly and down slowly, a little off its path
        let tri = 1.0 - abs(2.0 * q - 1.0);
        let y = L * (tri * tri * (3.0 - 2.0 * tri)) * 0.98 + 0.2;
        let x = 0.28 * sin(uClock * 0.45 + k * 2.3) + 0.12 * sin(y * 0.5 + k);
        let R = 0.34 + 0.2 * h11(k * 3.1);
        let d = (b - vec2(x, y)) / vec2(1.0, 1.7 + 0.5 * h11(k * 8.3));
        let fi = R * R / (dot(d, d) + 0.02);
        f += fi;
        // (update 30, Creyon) under an RGB each blob has its own random colour, new at each trip up
        (*tint) += hsv(h11(k * 13.7 + floor(cyc) * 3.1) + 0.25 * uTurn, 0.9, 1.0) * fi;
    }
    return f;
}

fn sig_glow_tc(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = lg_top();
    var col: vec3<f32> = vec3<f32>(0.0);
    if top > 0.15 {
        let yc = clamp(b.y, 0.0, top);
        let d = max(length(vec2(b.x, b.y - yc)) - lg_half(yc, top), 0.0);
        let s = b.y / max(uLength, 1.0);
        col = mix(LG_ORANGE, LG_RED, s) * (halo(d, 0.14) * 0.34 + halo(d, 0.7) * 0.08);
        if part(3.0) > 0.5 && uFx > 0.0 {
            let w = rxFlow(vec2(b.x * 2.4, b.y * 0.5 - uClock * 0.9));
            col += LG_ORANGE * smoothstep(0.55, 0.95, w) * halo(d, 1.2) * smoothstep(0.08, 0.4, d) * 0.2 * uFx;
        }
    }
    col += lvl(g) * LG_ORANGE * (1.0 - smoothstep(0.3, 1.4, abs(b.y))) * 0.25;
    col *= 1.0 - smoothstep(uLength + 0.2, uLength + 1.5, b.y);
    return col * roomFade(abs(b.x));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

fn sig_solid_raw(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let top = lg_top();
    if top < 0.15 || b.y < -0.2 || b.y > top + 0.2 {
        return o;
    }
    let half = lg_half(b.y, top);
    let x = abs(b.x);
    let cov = fillD(x - half, min(px, 0.03)) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(x / max(half, 0.01), 0.0, 1.0);
    let s = clamp(b.y / max(uLength, 1.0), 0.0, 1.0);
    let turned = uTurn != 0.0;
    let hue = hsv(uTurn, 0.88, 1.0);
    if turned {
        uOwn = 1.0;
    }
    let lgRed = select(LG_RED, hue * 0.8, turned);
    let lgOrange = select(LG_ORANGE, hue, turned);
    let lgGold = select(LG_GOLD, mix(hue, vec3<f32>(1.0), 0.55), turned);
    var col = select(lgRed * 0.15, LG_GLASS + lgRed * 0.1 * (1.0 - s), part(0.0) > 0.5);
    // the light of the base climbing through the liquid
    if part(2.0) > 0.5 {
        col += lgOrange * exp(-b.y * 0.28) * 0.8;
    }
    if part(1.0) > 0.5 {
        var tint: vec3<f32>;
        let f = lg_melt(vec2(clamp(b.x / max(half, 0.01), -1.0, 1.0) * 0.72, b.y), &tint);
        let m = smoothstep(0.85, 1.25, f);
        let hot = smoothstep(1.2, 3.4, f);
        var melt = mix(mix(LG_ORANGE, LG_RED, smoothstep(0.35, 1.0, s)), LG_GOLD * 1.15, hot);
        if turned {
            tint /= max(f, 0.001);
            melt = mix(tint * mix(1.0, 0.72, smoothstep(0.35, 1.0, s)), mix(tint, vec3<f32>(1.0), 0.5) * 1.15, hot);
        }
        col = mix(col, melt, m);
        col += (select(LG_RED, hue * 0.7, turned)) * smoothstep(0.45, 0.9, f) * (1.0 - m) * 0.5;
    }
    // the glass: a thin bright line down one side, a soft edge on the other
    col += vec3<f32>(0.9) * halo(abs(b.x / max(half, 0.01) + 0.62), 0.05) * 0.55 * (1.0 - smoothstep(0.0, 1.0, u) * 0.2);
    col += lgGold * smoothstep(0.88, 1.0, u) * 0.3;
    col = mix(col, lgGold, 0.45 * clamp(uClash, 0.0, 1.0));
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

fn sig_vol_tc(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var t: f32;
    let cl = clamp(uClash, 0.0, 1.0);
    if cl <= 0.01 {
        return vec3<f32>(0.0);
    }
    return (LG_GOLD * halo(rayPt(ro, rd, vec3(0.0, uLength * 0.6, 0.0), &t), 0.8) * 1.2 + LG_ORANGE * halo(rayPt(ro, rd, vec3(0.0, uLength * 0.6, 0.0), &t), 2.4) * 0.35) * cl * hiltFade(ro, rd);
}

// (update 26) the body starts softly in the emitter, no hard end above the hilt
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let r = sig_solid_raw(o, b, px);
    let j = smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, r.rgb, j), mix(o.a, r.a, j));
}

// (update 29, Creyon: nothing past the tip) every effect ends at the blade's end
fn sig_vol_34(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let fx = sig_vol_tc(ro, rd, px);
