fn kVine(ro: vec3<f32>, rd: vec3<f32>, px: f32, r0: f32, r1: f32, y0: f32, y1: f32, turns: f32, a0: f32, wob: f32, w: f32, hot: vec3<f32>, col: vec3<f32>, k: f32) -> vec3<f32> {
    if fxNear(ro, rd, min(y0, y1), max(y0, y1)) > max(r0, r1) + wob + 1.2 {
        return vec3<f32>(0.0);
    }
    var bWs: f32 = 0.0;
    var best: f32 = 1.0e3;
    var bf: f32 = 0.0;
    var s: f32;
    var prev = around(r0, a0, y0);
    for (var i = 1; i <= 26; i++) {
        let f = f32(i) / 26.0;
        let q = around(mix(r0, r1, f) + wob * sin(f * 9.0 + uClock * 0.7 + k), a0 + turns * f, mix(y0, y1, f));
        let d = raySeg(ro, rd, prev, q, &s);
        {
            let wN = bW(d);
            bWs += wN;
            best = min(best, d);
            bf += ((f32(i) - 1.0 + s) / 26.0 - bf) * wN / bWs;
        }
        prev = q;
    }
    let pulse = pow(0.5 + 0.5 * sin(bf * 11.0 - uClock * 1.3 + k), 4.0);
    let ww = mix(w, w * 0.3, bf);
    return (hot * halo(best, max(ww, px)) * (0.6 + 0.9 * pulse) + col * halo(best, ww * 4.5) * (0.35 + 0.5 * pulse)) * smoothstep(0.0, 0.06, bf) * (1.0 - smoothstep(0.82, 1.0, bf));
}

