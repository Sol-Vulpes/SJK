fn ds_strikes(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, 0.0, uLength) > 16.0 {
        return acc;
    }
    var t: f32;
    for (var i = 0; i < 3; i++) {
        let k = f32(i);
        let cyc = uClock * (0.42 + 0.14 * h11(k * 3.1)) + h11(k * 5.7);
        let n = floor(cyc);
        let q = fract(cyc);
        if q > 0.3 {
            continue;
        }
        let life = smoothstep(0.0, 0.02, q) * (1.0 - smoothstep(0.08, 0.3, q));
        let a = h11(n * 4.3 + k);
        let y = uLength * (0.2 + 0.68 * h11(n * 1.7 + k));
        let hit = around(0.6, a, y);
        let from_ = around(7.2, a + 0.05 * (h11(n * 2.1 + k) - 0.5), y + 3.0 + 3.0 * h11(n * 6.1 + k));
        let mid = mix(hit, from_, 0.55);
        let fork = mid + around(2.4, a + 0.17, -1.6 + 3.2 * h11(n * 7.7 + k));
        let d = liveBolt(ro, rd, from_, mid, hit, 0.6, n * 3.3 + k, px);
        let heart = max(halo(d, 0.38) * 1.7 - halo(d, max(0.07, px)) * 1.6, 0.0);
        acc += (DS_EDGE * heart + DS_PALE * halo(d, 1.1) * 0.17) * life * roomFade(7.2);
        acc += (DS_EDGE * halo(rayPt(ro, rd, hit, &t), 0.55) * 1.6 + DS_PALE * halo(rayPt(ro, rd, hit, &t), 1.8) * 0.5) * life;
    }
    return acc;
}

// (update 30, Creyon) polished beskar: a slow silver gleam over the black face; and black flame in the white
fn ds_more(o_in: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    var o = o_in;
    let L = uLength;
    let y = b.y;
    let on = rxLife(0.35, 1.3, 0.3);
    let half = ds_half(y, L);
    let x = abs(b.x);
    if y > 0.0 && y < L && x < half {
        let u = b.x / max(half, 0.01);
        let gl = sin(u * 1.3 + y * 0.09 - uClock * 0.5) + 0.5 * sin(y * 0.21 + uClock * 0.31);
        let gleam = mix(vec3<f32>(0.3, 0.33, 0.4), vec3<f32>(0.85, 0.9, 1.0), smoothstep(1.1, 1.45, gl));
        let sig_t0 = gleam * smoothstep(0.7, 1.45, gl) * 0.33 * (1.0 - abs(u) * 0.5) * on * step(0.5, part(0.0));
        o.r += sig_t0.x;
        o.g += sig_t0.y;
        o.b += sig_t0.z;
    }
    // black flame licking up its edges, standing in the white flame
    if part(3.0) < 0.5 || uFx <= 0.0 || y < 0.5 || y > L {
        return o;
    }
    let side = select(8.0, 2.0, b.x > 0.0);
    let f3 = rxFlow(vec2(y * 0.42 - uClock * 2.4, side + 5.0));
    let reach = (0.16 + 0.95 * f3 * f3) * smoothstep(0.5, 3.0, y) * (1.0 - smoothstep(L - 2.2, L - 0.2, y)) * on;
    let dd = x - half;
    if dd <= 0.0 || dd > reach {
        return o;
    }
    let qb = dd / max(reach, 0.05);
    let a = (1.0 - smoothstep(0.45, 1.0, qb)) * 0.95;
    let keep = max(o.a, a);
    return vec4(mix(o.rgb, vec3<f32>(0.01, 0.01, 0.015), a / max(keep, 0.001)), keep);
}

fn sig_solid_l(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let r = ds_more(sig_solid_raw(o, b, px), b, px);
    let j = smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, r.rgb, j), mix(o.a, r.a, j));
}

