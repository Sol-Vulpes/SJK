// Kalevala Darksaber: the black blade of the Mandalorian kings, as it might burn in a legend of
// their home system. Its own body is black, truly black, drawn in the solid layer, a flat blade
// whose white edge crackles with energy all round it; white current crawls along that edge and
// leaps off it in short arcs, wisps of black flame curl off it and fade, silver sparks spit off the
// edge and a cold pale haze hangs round it. Every 22 seconds the blade's will flares: its edge
// blazes white along its whole length and a ripple of light runs up it, the arcs leaping wider.
// Lit, it cuts out of the emitter with a white flash at its edge; let go, it snaps back in. A clash
// throws silver sparks. Its trail is the darksaber (`@trail darksaber`). No figures, no rings.
const DS_BLACK: vec3<f32> = vec3<f32>(0.015, 0.015, 0.02);

const DS_EDGE: vec3<f32> = vec3<f32>(0.95, 0.97, 1.0);

const DS_PALE: vec3<f32> = vec3<f32>(0.6, 0.65, 0.8);

fn ds_top() -> f32 {
    return (uLength + 0.4) * rxLife(0.0, 0.2, 0.25);
}

fn ds_flare() -> f32 {
    return select(0.0, rxCycle(22.0, 14.0, 16.2, 17.4, 20.4) * rxLife(0.2, 0.6, 0.3), part(4.0) > 0.5);
}

// a flat blade: a little wider than it is thick, with a squared-off point drawn round
fn ds_half(y: f32, top: f32) -> f32 {
    // (update 19) the Darksaber's own shape: a flat sword, broad above the hilt, narrowing steadily
    // along its length to a long sharp point; never a lightsaber's tube
    let s = clamp(y / max(uLength, 1.0), 0.0, 1.0);
    let w = mix(0.95, 0.56, smoothstep(0.02, 0.86, s));
    let point = clamp((top - y) / 5.0, 0.0, 1.0);
    return w * pow(point, 0.72);
}

fn sig_glow_tc(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = ds_top();
    var col: vec3<f32> = vec3<f32>(0.0);
    if top > 0.15 {
        let half = ds_half(b.y, top);
        let d = rxOut(b, top, half);
        let fl = ds_flare();
        let crawl = rxFlow(vec2(b.y * 1.5 - tCalm() * 4.0, clamp(b.x * 2.0, -1.0, 1.0) * 5.0));
        col = DS_EDGE * halo(d, 0.12 + 0.08 * crawl + 0.15 * fl) * (0.8 + 0.6 * crawl + fl) + DS_PALE * halo(d, 0.9) * 0.35 * (1.0 + fl);
        let wave = halo(abs(b.y - glsl_mod(uTime * 12.0, uLength + 20.0) + 6.0), 2.0) * fl;
        col += DS_EDGE * wave * halo(d, 0.8) * 1.2;
        // (update 30, Creyon: make it mythical) white flame: tall sharp licks of white fire stream up both its edges
        if part(3.0) > 0.5 && uFx > 0.0 {
            let side = select(8.0, 2.0, b.x > 0.0);
            let f1 = rxFlow(vec2(b.y * 0.3 - uClock * 2.5, side));
            let f2 = rxFlow(vec2(b.y * 0.8 - uClock * 3.6, side + 3.0));
            let along = smoothstep(0.5, 3.5, b.y) * (1.0 - smoothstep(top - 3.0, top - 0.5, b.y));
            let reach = 0.5 + 3.6 * f1 * f1 + 1.1 * f2 * f2;
            let qf = clamp(d / max(reach, 0.05), 0.0, 1.0);
            let fl2 = (1.0 - qf) * (1.0 - qf);
            col += mix(DS_PALE * 0.8, DS_EDGE * 1.3, fl2) * (fl2 * 1.3 + (1.0 - qf) * 0.14) * along * (1.0 + 0.5 * fl) * rxLife(0.3, 1.1, 0.3);
        }
    }
    col *= tipFadeB(b);
    return col * roomFade(abs(b.x)) * (1.0 + 0.8 * clamp(uClash, 0.0, 1.0));
}

fn sig_core_d(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.15 * (1.0 - smoothstep(0.3, 2.0, b.y));
}

// effect 1: the black blade, black glass-dark with a faint cold sheen; effect 2 its white edge
fn sig_solid_raw(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let top = ds_top();
    if top < 0.15 || b.y < -0.3 || b.y > top + 0.3 {
        return o;
    }
    let half = ds_half(b.y, top);
    let x = abs(b.x);
    let cov = fillD(x - half, min(px, 0.05)) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(x / max(half, 0.01), 0.0, 1.0);
    var col = DS_BLACK + DS_PALE * 0.06 * halo(abs(b.y - glsl_mod(tCalm() * 3.0, uLength + 10.0) + 5.0), 3.0);
    // the fuller, a thin bright groove down its middle, fading before the point
    col += DS_PALE * halo(b.x, 0.05) * 0.28 * (1.0 - smoothstep(0.7, 0.92, b.y / max(uLength, 1.0)));
    if part(1.0) > 0.5 {
        let crawl = rxFlow(vec2(b.y * 1.5 - tCalm() * 4.0, clamp(b.x * 2.0, -1.0, 1.0) * 5.0));
        col = mix(col, DS_EDGE, smoothstep(0.82 - 0.08 * crawl - 0.1 * ds_flare(), 1.0, u));
    }
    col = mix(col, DS_EDGE, 0.4 * clamp(uClash, 0.0, 1.0));
    let a = cov;
    return vec4(mix(o.rgb, col, a), max(o.a, a));
}

