    }
    return fx * uFx;
}

// The blades that came before: three black swords of shadow standing in the air round it, each edged in white, turning slowly.
// How far sword k has gone into the blade, one after another, and out again the other way round.
fn ks_in(k: f32) -> f32 {
    let t = glsl_mod(uClock, 54.0);
    return smoothstep(18.0 + 4.0 * k, 23.0 + 4.0 * k, t) * (1.0 - smoothstep(44.0 - 3.0 * k, 49.0 - 3.0 * k, t));
}

fn ks_all() -> f32 {
    return (ks_in(0.0) + ks_in(1.0) + ks_in(2.0)) / 3.0;
}

fn ks_a(k: f32) -> vec3<f32> {
    return around((2.9 + 0.25 * sin(uClock * 0.16 + k * 2.1)) * (1.0 - 0.9 * ks_in(k)), k / 3.0 + uClock * 0.016, 1.2 + 0.7 * sin(uClock * 0.2 + k * 2.0));
}

fn ks_b(k: f32) -> vec3<f32> {
    return around((2.9 + 0.25 * sin(uClock * 0.16 + k * 2.1)) * (1.0 - 0.9 * ks_in(k)), k / 3.0 + uClock * 0.016 + 0.015 * sin(uClock * 0.3 + k), uLength * (0.62 + 0.14 * h11(k * 3.1)) + 0.7 * sin(uClock * 0.2 + k * 2.0));
}

