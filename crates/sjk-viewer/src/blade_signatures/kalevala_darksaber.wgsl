        }
    }
    // effect 4: silver sparks spitting off the edge
    if part(3.0) > 0.5 {
    }
    // at the flare, long blades of cold light stand out from its edge
    if part(4.0) > 0.5 && fl > 0.01 {
        fx += 0.9 * fl * rxRays(ro, rd, px, 9.0, 2.0, L - 2.0, 7.0, 0.31, DS_EDGE, DS_PALE * 0.6) * aft;
    }
    // a cold pale haze
    fx += 0.4 * syMist(ro, rd, 0.5, L * 0.95, 3.4, 0.08, 44.0, DS_PALE, DS_PALE * 0.3) * aft;
    // moments: lit, a white flash along its edge; a clash, silver sparks
