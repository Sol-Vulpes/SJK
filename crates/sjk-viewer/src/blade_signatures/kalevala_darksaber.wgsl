    return base + a * rxLife(0.3, 1.2, 0.4) * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

fn sig_solid(o_in: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    var o = o_in;
    // the smoke of Mandalore's burning hanging behind it
    if uFx > 0.0 && b.y > 0.0 && b.y < uLength {
        let d = abs(b.x);
        let side = select(6.0, 2.0, b.x > 0.0);
        let reach = (2.4 + 2.0 * rxFlow(vec2(b.y * 0.1 - uClock * 0.05, side))) * smoothstep(0.0, uLength * 0.2, b.y) * (1.0 - smoothstep(uLength * 0.72, uLength, b.y));
        let a = (1.0 - smoothstep(reach * 0.25, reach, d)) * 0.86 * rxLife(0.3, 1.4, 0.3);
        if a > 0.003 {
            let q = vec2(d * 0.65 - uClock * 0.05 + side, b.y * 0.17 - uClock * 0.06);
            let n = rxFlow(q + 0.9 * (rxFlow(q * 1.3 + 4.0) - 0.5));
            let dark = mix(vec3<f32>(0.006, 0.007, 0.012), vec3<f32>(0.075, 0.08, 0.1), smoothstep(0.4, 0.8, n));
            o = vec4(mix(o.rgb, dark, a), max(o.a, a));
        }
    }
    return sig_solid_e2(o, b, px);
}

// >>> what this blade has in the air of its own
fn sig_vol_r24(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_own(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return base;
    }
    let L = uLength;
    a += 0.95 * gxVortex(ro, rd, px, 11.0, 5.0, 216.0, vec3<f32>(0.950, 0.970, 1.000), vec3<f32>(0.850, 0.900, 1.000));
    a += 1.25 * gxTumble(ro, rd, px, 12.0, 5.0, 1.0, 1.0, 0.28, 16.0, vec3<f32>(0.950, 0.970, 1.000), vec3<f32>(0.850, 0.900, 1.000));
    return base + a * rxLife(0.8, 3.0, 0.45) * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

// <<<
// >>> how it answers: as it lights, in a swing, in a clash
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_r24(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return base;
    }
    let ig = select(0.0, 1.0 - smoothstep(0.3, 3.0, uAge), uAge < 2000.0);
    let sw = clamp(uSwing, 0.0, 1.0);
    a += ig * 1.1 * gxVortex(ro, rd, px, 12.0, 5.0, 315.0, vec3<f32>(0.95, 0.97, 1.00), vec3<f32>(0.40, 0.42, 0.48));
    a += 1.35 * gxBurst(ro, rd, px, 11.0, 4.6, 0.0, 0.34, 316.0, vec3<f32>(1.00, 1.00, 1.00), vec3<f32>(0.45, 0.47, 0.55));
    return base + a * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}
