            let wN = bW(d);
            bWs += wN;
            best = min(best, d);
            bf += ((f32(i) - 1.0 + s) / 15.0 - bf) * wN / bWs;
        }
        prev = q;
    }
    let pulse = pow(0.5 + 0.5 * sin(bf * 11.0 - uClock * 1.3 + k), 4.0);
    let ww = mix(w, w * 0.3, bf);
    return (hot * halo(best, max(ww, px)) * (0.6 + 0.9 * pulse) + col * halo(best, ww * 4.5) * (0.35 + 0.5 * pulse)) * smoothstep(0.0, 0.06, bf) * (1.0 - smoothstep(0.82, 1.0, bf));
}

fn kLeaf(ro: vec3<f32>, rd: vec3<f32>, px: f32, y: f32, a: f32, len: f32, curl: f32, w: f32, hot: vec3<f32>, col: vec3<f32>) -> vec3<f32> {
