// Ziost Silence (Legendary, 3/11/2026): Ziost as the Emperor eats it: pale stone split by black cracks, torn open in three wounds. Long rivers of life bend in to them from far off, an aurora of drained souls hangs round it and pieces of the world tear loose and spiral in. Then the silence: everything stops, and a cold shell is all that is left.
const C1: vec3<f32> = vec3<f32>(0.500, 0.800, 1.000);

const C2: vec3<f32> = vec3<f32>(0.200, 0.420, 0.950);

const Kk: vec3<f32> = vec3<f32>(0.006, 0.008, 0.016);

const H: vec3<f32> = vec3<f32>(1.000, 1.000, 1.000);

fn zi_top() -> f32 {
    return uLength * rxLife(0.0, 0.45, 0.32);
}

fn zi_hush() -> f32 {
    return select(0.0, rxCycle(21.0, 13.0, 15.5, 17.0, 20.0), part(3.0) > 0.5);
}

// The wound: where it all goes, wandering slowly along the blade.
fn zi_wy() -> f32 {
    return uLength * (0.5 + 0.17 * sin(uClock * 0.27));
}

fn zi_wk(k: f32) -> f32 {
    return uLength * (0.2 + 0.3 * k) + 1.4 * sin(uClock * 0.27 + k * 2.1);
}

fn zi_beat(y: f32) -> f32 {
    return pow(0.5 + 0.5 * sin(abs(y - zi_wy()) * 0.55 - uClock * 2.6), 3.0);
}

fn zi_pull(y: f32) -> f32 {
    let dy = (y - zi_wy()) / 5.0;
    return exp(-dy * dy);
}

fn sig_glow_grown(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let h = zi_hush();
    let top = zi_top();
    let yc = clamp(b.y, 0.0, top);
    let d = max(length(vec2(b.x, b.y - yc)), 0.0);
    let pull = zi_pull(b.y);
    var col = g * (1.0 - 0.8 * h) * (0.55 + 0.4 * pull + 0.5 * zi_beat(b.y) + 0.6 * clamp(uClash, 0.0, 1.0));
    col += C2 * (halo(d, 1.7) * (0.14 * (1.0 - h) + 0.06) + halo(d, 4.6) * (0.04 + 0.16 * h));
    // the wound's own light
    for (var i = 0; i < 3; i++) {
        let dw = length(vec2(b.x, (b.y - zi_wk(f32(i))) * 0.55));
        col += (H * halo(dw, 0.5) * 0.65 + C1 * (halo(dw, 1.5) * 0.36 + halo(dw, 3.8) * 0.08)) * (1.0 - h) * rxLife(0.4, 1.0, 0.3);
    }
    // as it lights: white fire at the point of the crack going up it
    let rising = 1.0 - smoothstep(0.55, 1.0, rxLife(0.0, 0.6, 0.32));
    col += (H * halo(length(vec2(b.x, b.y - top)), 0.7) * 1.5 + C1 * halo(length(vec2(b.x, b.y - top)), 2.6) * 0.8) * rising;
    return col * tipFadeB(b) * roomFade(abs(b.x));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    let top = zi_top();
    if b.y < -0.3 || b.y > L + 0.3 || b.y > top + 0.2 {
        return o;
    }
    let e = 1.0 - clamp((top - b.y) / 2.0, 0.0, 1.0);
    let half = 0.54 * sqrt(max(1.0 - e * e, 0.0));
    let cov = (1.0 - smoothstep(half - 0.05 - px, half + 0.03 + px, abs(b.x))) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    let nz = sqrt(max(1.0 - u * u, 0.0));
    let sh = rxFlow(vec2(b.x * 1.3 + 0.3 * sin(uClock * 0.5), b.y * 0.08 - uClock * 0.14));
    var col = mix(vec3<f32>(0.62, 0.68, 0.76), vec3<f32>(0.93, 0.97, 1.0), smoothstep(0.25, 0.75, sh));
    col *= 0.5 + 0.62 * nz;
    let from_ = abs(b.y - zi_wy());
    if part(0.0) > 0.5 {
        // black cracks with a torn line: wide and narrow by turns, branching, light bleeding from their lips, spreading from the wound
        let reach = 3.0 + 11.0 * fract(uClock * 0.045);
        let front = max(1.0 - smoothstep(reach - 4.0, reach, from_), 1.0 - smoothstep(0.6, 2.2, uAge));
        let tear = 0.16 * vec2(vn(vec2(b.x * 3.2, b.y * 1.1)) - 0.5, vn(vec2(b.x * 2.1 + 7.0, b.y * 0.8)) - 0.5);
        let v1 = rxFlow(vec2(b.x * 1.6 + 0.3 + tear.x * 2.0, b.y * 0.13 - 0.05 * uClock + tear.y));
        let v2 = rxFlow(vec2(b.x * 3.3 + 7.0 + tear.y * 3.0, b.y * 0.28 + 2.0 + tear.x));
        let v3 = rxFlow(vec2(b.x * 6.0 + 2.0 + tear.x * 5.0, b.y * 0.55 + tear.y * 2.0));
        let w1 = 0.018 + 0.05 * vn(vec2(b.y * 0.34, 5.0));
        let w2 = 0.012 + 0.03 * vn(vec2(b.y * 0.6, 9.0));
        let c1 = 1.0 - smoothstep(w1 * 0.45, w1, abs(v1 - 0.5));
        let c2 = 1.0 - smoothstep(w2 * 0.45, w2, abs(v2 - 0.5));
        let c3 = (1.0 - smoothstep(0.006, 0.018, abs(v3 - 0.5))) * smoothstep(0.52, 0.68, vn(vec2(b.y * 0.45, 3.0)));
        let crack = max(max(c1, 0.9 * c2), 0.75 * c3) * max(front, 0.2);
        let lip = (1.0 - smoothstep(w1, w1 * 4.2, abs(v1 - 0.5))) * (1.0 - c1) + 0.6 * (1.0 - smoothstep(w2, w2 * 4.0, abs(v2 - 0.5))) * (1.0 - c2);
        col = mix(col, Kk, crack);
        col += mix(C1, H, 0.35) * lip * front * (0.42 + 0.6 * zi_beat(b.y));
    }
    // the wound: the stone torn open and blazing
    var wo: f32 = 0.0;
    for (var i = 0; i < 3; i++) {
        wo = max(wo, 1.0 - smoothstep(0.1, 1.2, length(vec2(b.x * 1.4, (b.y - zi_wk(f32(i))) * 0.5))));
    }
    col = mix(col, H, wo * (1.0 - zi_hush()));
    col += C1 * smoothstep(0.72, 1.0, abs(u)) * (0.3 + 0.8 * zi_beat(b.y));
    col = mix(col, C1 * 1.1, 0.3 * zi_beat(b.y) * (1.0 - abs(u)));
    col = mix(col, col * 0.34, 0.85 * zi_hush());
    col = mix(col, H, 0.5 * clamp(uClash, 0.0, 1.0));
    col *= smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

// A river of life: from far off, bending, into the wound.
fn zi_river(ro: vec3<f32>, rd: vec3<f32>, px: f32, k: f32, hush: f32) -> vec3<f32> {
    let L = uLength;
    let wy = zi_wk(glsl_mod(k, 3.0));
    let run = uClock * 0.1 + k * 0.37;
    let cyc = floor(run);
    let ph = fract(run);
    let a = k / 8.0 + 0.11 * h11(k * 2.3 + cyc * 1.7) + 0.05 * uClock;
    let side = select(-1.0, 1.0, glsl_mod(k, 2.0) < 0.5);
    let R = 5.2 + 3.0 * h11(k * 3.1 + cyc);
    let span = (5.0 + 6.0 * h11(k * 5.3 + cyc)) * side;
    let y0 = clamp(wy + span, 1.5, L - 1.5);
    var tm: f32;
    if rayPtRaw(ro, rd, around(R * 0.5, a + 0.14, mix(y0, wy, 0.5)), &tm) > R * 0.8 + abs(y0 - wy) * 0.65 + 2.0 {
        return vec3<f32>(0.0);
    }
    var bWs: f32 = 0.0;
    var best: f32 = 1.0e3;
    var bf: f32 = 0.0;
    var s: f32;
    var prev = around(R, a, y0);
    for (var j = 1; j <= 10; j++) {
        let f = f32(j) / 10.0;
        let e = f * f * (3.0 - 2.0 * f);
        let q = around(mix(R, 0.25, e) + 0.3 * sin(f * 8.0 - uClock * 1.6 + k) * (1.0 - f), a + 0.3 * f, mix(y0, wy, sqrt(f)));
        let dd = raySeg(ro, rd, prev, q, &s);
        {
            let wN = bW(dd);
            bWs += wN;
            best = min(best, dd);
            bf += ((f32(j) - 1.0 + s) / 10.0 - bf) * wN / bWs;
        }
        prev = q;
    }
    let life = sin(3.1416 * ph);
    let bead = pow(0.5 + 0.5 * sin(bf * 24.0 - uClock * 6.0 + k * 2.0), 4.0);
    let ww = mix(0.13, 0.04, bf);
    let col = H * halo(best, max(ww * 0.55, px)) * (0.5 + 1.5 * bead) + C1 * (halo(best, ww * 2.4) * (0.7 + 0.8 * bead) + halo(best, 0.85) * 0.2);
    return col * smoothstep(0.0, 0.3, bf) * life * (1.0 + 1.2 * smoothstep(0.65, 1.0, bf)) * (1.0 - hush);
}

fn sig_vol_w2(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    let aft = rxLife(0.3, 1.0, 0.35);
    if aft <= 0.01 {
        return fx;
    }
    let h = zi_hush();
    if part(1.0) > 0.5 {
        for (var i = 0; i < 8; i++) {
            fx += zi_river(ro, rd, px, f32(i), h);
        }
    }
    if part(2.0) > 0.5 {
        fx += (1.0 - 0.85 * h) * 1.5 * shFlakes(ro, rd, 3.6, 0.5, L - 0.4, 26.0, 2.8, 0.9, 0.16, 0.16, 0.42, 0.5, 41.0, C1 * 0.85, Kk * 12.0);
        fx += (1.0 - h) * 0.8 * syMistSpin(ro, rd, 0.3, L * 0.97, 1.3, 5.0, 0.04, 42.0, C2 * 0.32, Kk * 10.0);
        fx += (1.0 - h) * 0.9 * syMistSpin(ro, rd, 0.3, L * 0.97, 1.8, 5.8, -0.03, 43.0, C1 * 0.2, C2 * 0.16);
    }
    if part(3.0) > 0.5 {
        fx += h * (1.05 * rxAuraShell(ro, rd, -0.3, L + 0.3, 2.5, 3.0, Kk * 5.0, C1));
    }
    // going out: the stone falls away as ash
    if uAge >= 2000.0 {
        fx += (1.0 - smoothstep(0.0, 0.45, uAge - 2000.0)) * 2.2 * shFlakes(ro, rd, 2.2, 0.5, L - 0.4, 24.0, 2.2, -5.0, 0.1, 0.14, 0.7, 0.0, 44.0, H, C1);
    }
    return fx * (aft + (select(0.0, 1.0 - aft, uAge >= 2000.0)) * 0.0) * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

// Pieces of Ziost's stone torn off the world and dragged in spirals toward the wounds, cracking as they go.
fn sig_vol_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    var o: vec4<f32> = vec4<f32>(0.0);
    let L = uLength;
    if uFx <= 0.0 || part(2.0) < 0.5 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return o;
    }
    var best: f32 = 1.0e9;
    let h = zi_hush();
    for (var i = 0; i < 10; i++) {
        let k = f32(i);
        var t: f32;
        let run = uClock * (0.085 + 0.02 * h11(k * 1.7)) + k * 0.27;
        let n = floor(run);
        let q = fract(run);
        let wy = zi_wk(glsl_mod(k, 3.0));
        let ya = clamp(wy + (5.0 + 3.0 * h11(k + n)) * (select(-1.0, 1.0, glsl_mod(k + n, 2.0) < 0.5)), 1.0, L - 1.0);
        let c = around(mix(5.2 + 1.2 * h11(k * 3.1 + n), 0.8, q * q), h11(k * 5.3 + n) + 0.55 * q, mix(ya, wy, q * q));
        let d0 = rayPt(ro, rd, c, &t);
        if t > best {
            continue;
        }
        let R0 = (0.42 + 0.46 * h11(k * 9.1 + n)) * (1.0 - 0.6 * q * q) * smoothstep(0.0, 0.22, q) * (1.0 - smoothstep(0.78, 1.0, q));
        if R0 < 0.02 {
            continue;
        }
        if d0 > R0 * 1.5 + 0.08 {
            continue;
        }
        // a torn lump of rock: its outline noise taken round the view ray, so no seam and no figure
        let w0 = ro + rd * t - c;
        let e1 = normalize(cross(rd, vec3<f32>(0.0, 1.0, 0.0)));
        let e2 = cross(rd, e1);
        let dir = vec2(dot(w0, e1), dot(w0, e2)) / max(d0, 0.001);
        let spin = uClock * (0.5 + 0.5 * h11(k));
        let tdir = rot(spin) * dir;
        let rag = R0 * (0.52 + 0.75 * vn(tdir * 1.5 + vec2(k * 3.0, n)));
        let cov = 1.0 - smoothstep(rag - 0.03 - px, rag + 0.03 + px, d0);
        if cov <= 0.0 {
            continue;
        }
        best = t;
        let lit = 0.5 + 0.5 * dot(dir, normalize(vec2<f32>(0.3, 1.0)));
        let rim = smoothstep(rag * 0.68, rag, d0);
        let col = mix(vec3<f32>(0.07, 0.085, 0.12), vec3<f32>(0.34, 0.39, 0.47), lit) * (1.0 - 0.6 * h) + C1 * rim * (0.5 + 1.5 * q) * (1.0 - 0.8 * h);
        o = vec4(col, cov * (1.0 - behindBlade(ro, rd, t)));
    }
    o.a *= uFx * rxLife(0.3, 1.0, 0.35) * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
    return o;
}

fn sig_glow_w2(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_grown(g, b, r, px) * growGlow(b);
}

fn sig_vol_own(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_w2(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    let C = uClock;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return base;
    }
    if part(3.0) > 0.5 {
        a += 1.4 * syBubbles(ro, rd, 10.0, 4.14, 0.055, 1057.0, vec3<f32>(0.620, 0.840, 1.000), vec3<f32>(0.200, 0.420, 0.950));
    }
    return base + a * rxLife(0.3, 1.2, 0.4) * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    var col = sig_glow_w2(g, b, r, px);
    let d = max(abs(b.x) - 0.5, 0.0);
    let C = uClock;
    let on = rxLife(0.3, 1.3, 0.35) * uFx * tipFadeB(b) * growGlow(b) * roomFade(abs(b.x)) * smoothstep(0.0, 4.0, b.y);
    if part(3.0) > 0.5 {
        col += vec3<f32>(0.0);
    }
    return col;
}

// >>> what this blade has in the air of its own
fn sig_vol_m26(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_own(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return base;
    }
    let L = uLength;
    a += 1.27 * gxKin(ro, rd, 5.0, 4.0, 3.00, 0.030, 0.70, 0.08, 0.96, 1.0, 9493.0, vec3<f32>(0.620, 0.840, 1.000), vec3<f32>(0.200, 0.420, 0.950));
    a += 1.0 * gxVortex(ro, rd, px, 12.0, 6.0, 218.0, vec3<f32>(0.620, 0.840, 1.000), vec3<f32>(0.200, 0.420, 0.950));
    a += 1.3 * gxTumble(ro, rd, px, 12.0, 6.0, 2.0, 0.0, 0.55, 18.0, vec3<f32>(0.620, 0.840, 1.000), vec3<f32>(0.200, 0.420, 0.950));
    return base + a * rxLife(0.8, 3.0, 0.45) * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

// <<<
// >>> its own moment
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_m26(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return base;
    }
    let m = rxCycle(56.0, 20.0, 30.0, 36.0, 46.0);
    let L = uLength;
    a += 1.45 * gxField(ro, rd, px, 16.0, m, 1.3, 6.0, 0.25, -1.0, 0.0, 0.5, 1114.0, vec3<f32>(0.620, 0.840, 1.000), vec3<f32>(0.200, 0.420, 0.950));
    return base * 1.0 + a * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}
