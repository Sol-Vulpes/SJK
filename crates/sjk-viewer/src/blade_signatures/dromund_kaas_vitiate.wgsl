fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var a: vec3<f32> = vec3<f32>(0.0);
    let base = sig_vol_p1(ro, rd, px);
    let L = uLength;
    let C = uClock;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return base;
    }
    a += 1.5 * sxStrike(ro, rd, px, 2.0, 0.42, 7.0, 431.0, vec3<f32>(1.0, 0.5, 1.0));
    a += 1.1 * liveArcs(ro, rd, px, L * 0.08, L * 0.95, 3.0, 2.6, 6.5, 432.0, vec3<f32>(1.0, 0.42, 1.0));
    a += 0.8 * fxFall(ro, rd, px, 1.0, L - 0.8, 3.6, 16.0, 4.6, 1.4, 0.08, 433.0, vec3<f32>(0.7, 0.55, 0.85));
    a += 0.9 * syMistSpin(ro, rd, 0.3, L * 0.97, 1.3, 5.2, 0.06, 434.0, vec3<f32>(0.32, 0.03, 0.34), vec3<f32>(0.03, 0.003, 0.05));
    return base + a * rxLife(0.3, 1.0, 0.35) * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

