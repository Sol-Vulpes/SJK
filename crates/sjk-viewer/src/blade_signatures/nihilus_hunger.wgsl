// Nihilus Hunger (Mythical, rebuilt on Sol's glow and core 3/11/2026): Darth Nihilus, a wound in the Force that eats worlds: a hollow black blade with a thin red edge and red veins draining toward the hand. Long soft streams of stolen life bend in from all round it and sink into the blade, dark fire rises off it and a slow red mist is pulled in. When it feeds, everything is drawn in faster.
const Rd: vec3<f32> = vec3<f32>(0.950, 0.040, 0.030);

const Dp: vec3<f32> = vec3<f32>(0.300, 0.004, 0.012);

const Bk: vec3<f32> = vec3<f32>(0.008, 0.004, 0.006);

const Pl: vec3<f32> = vec3<f32>(1.000, 0.700, 0.620);

fn ni_top() -> f32 {
    return uLength * rxLife(0.0, 0.5, 0.32);
}

fn ni_feed() -> f32 {
    return select(0.0, rxCycle(16.0, 8.3, 10.5, 12.5, 15.5), part(5.0) > 0.5);
}

fn ni_half(y: f32) -> f32 {
    let top = ni_top();
    if y > top {
        return 0.0;
    }
    let e = 1.0 - clamp((top - y) / 2.2, 0.0, 1.0);
    return (0.5 + 0.03 * sin(y * 0.5 + uClock * 1.6)) * sqrt(max(1.0 - e * e, 0.0));
}

fn sig_glow_grown(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = ni_top();
    let yc = clamp(b.y, 0.0, top);
    let fd = ni_feed();
    let d = max(length(vec2(b.x, b.y - yc)) - ni_half(yc), 0.0);
    let w = 0.5 + 0.5 * sin(b.y * 0.36 + uClock * 2.2);
    var col = g * (0.28 + 0.22 * w + 0.5 * fd + 0.7 * clamp(uClash, 0.0, 1.0));
    col += Rd * (halo(d, 0.12) * (0.7 + 0.3 * w)) + Dp * (halo(d, 0.7) * (0.42 + 0.5 * fd) + halo(d, 2.8) * (0.1 + 0.2 * fd));
    return col * tipFadeB(b) * roomFade(abs(b.x));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

fn sig_solid_e2(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    if b.y < -0.3 || b.y > L + 0.3 {
        return o;
    }
    // its body breathes and is eaten: the edge wanders as if something were drawing on it from within
    let bite = rxFlow(vec2(b.y * 0.21 - uClock * 0.32, select(7.0, 2.0, b.x > 0.0))) - 0.5;
    let half = ni_half(b.y) * (1.0 + 0.2 * bite + 0.06 * sin(b.y * 0.5 + uClock * 0.9));
    let cov = (1.0 - smoothstep(half - 0.14 - px, half + 0.07 + px, abs(b.x))) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    let nz = sqrt(max(1.0 - u * u, 0.0));
    let fd = ni_feed();
    // a round black mass: light only reaches its sides, and deep inside something red moves, slower than its surface
    let deep = rxFlow(vec2(asin(u) * 0.9 + 3.0, b.y * 0.09 + uClock * 0.17));
    var col = Bk + Dp * (0.35 + 0.9 * deep * deep) * nz;
    if part(1.0) > 0.5 {
        // what it feeds on, running inward and up: veins that thicken and thin, pulled toward the hand, wrapped on the roundness
        var w0 = vec2(asin(u) * 1.5, b.y * 0.14 + uClock * 0.42);
        w0 += 0.35 * vec2(rxFlow(w0 * 0.8 + 4.0) - 0.5, rxFlow(w0 * 0.9 + 8.0) - 0.5);
        let v = rxFlow(w0);
        let v2 = rxFlow(w0 * 1.9 + 5.0);
        let thick = 0.03 + 0.06 * rxFlow(vec2(b.y * 0.1 - uClock * 0.25, 2.0));
        let vein = max(1.0 - smoothstep(0.0, thick, abs(v - 0.5)), 0.6 * (1.0 - smoothstep(0.0, thick * 0.7, abs(v2 - 0.5))));
        let wave = 0.3 + 0.7 * pow(0.5 + 0.5 * sin(b.y * 0.36 + uClock * 2.2), 2.0);
        col += mix(Dp * 2.0, Rd, wave) * vein * (0.5 + 0.6 * nz) * (1.1 + fd);
    }
    if part(0.0) > 0.5 {
        col += Rd * pow(1.0 - nz, 3.0) * 0.75 * (0.7 + 0.5 * deep);
    }
    col = mix(col, Rd, 0.5 * clamp(uClash, 0.0, 1.0));
    col *= smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

// A black splinter of a dead world: long and sharp, one face catching a dull red light.
fn ni_splinter(ro: vec3<f32>, rd: vec3<f32>, px: f32, c: vec3<f32>, R: f32, k: f32) -> vec4<f32> {
    var tm: f32;
    let d = rayPtRaw(ro, rd, c, &tm);
    if d > R * 1.7 {
        return vec4<f32>(0.0);
    }
    let e1 = normalize(cross(rd, vec3<f32>(0.0, 1.0, 0.0)));
    let e2 = cross(rd, e1);
    let w0 = ro + rd * tm - c;
    let u = rot(uClock * 0.07 * (0.5 + h11(k)) + k * 1.9) * vec2(dot(w0, e1), dot(w0, e2)) / R;
    let kite = abs(u.x) * 2.6 + abs(u.y) * 0.72;
    let cov = (1.0 - smoothstep(0.94 - px / R, 1.0 + px / R, kite)) * (1.0 - behindBlade(ro, rd, tm));
    let col = mix(Bk, Dp * 0.8, select(0.1, 0.65, u.x > 0.0)) + Rd * smoothstep(0.78, 1.0, kite) * 0.4;
    return vec4(col, cov);
}

// Pieces of dead worlds: black shards hanging in the air, each slowly falling inward and being carried round it.
// The world it is eating: a dead planet hanging beside it, cracked, its life streaming off it toward the blade in a line of dying sparks.
// The world's life: whole, then it bursts, and slowly gathers again from nothing.
fn ni_year() -> f32 {
    return fract(uClock / 34.0);
}

fn ni_whole() -> f32 {
    let y = ni_year();
    return smoothstep(0.9, 0.995, y) + (1.0 - smoothstep(0.6, 0.64, y)) * step(y, 0.84);
}

fn ni_world() -> vec3<f32> {
    return around(4.0 + 0.9 * sin(uClock * 0.13), 0.62 + uClock * 0.022, uLength * (0.56 + 0.26 * sin(uClock * 0.09 + 1.0)));
}

fn ni_shard(k: f32, R: ptr<function, f32>) -> vec3<f32> {
    let L = uLength;
    let h1 = h11(k * 3.1);
    let h2 = h11(k * 7.7);
    let h3 = h11(k * 5.3);
    (*R) = 0.42 + 0.7 * h3;
    return around(2.2 + 1.9 * h1 + 0.5 * sin(uClock * 0.13 + k), h2 + uClock * (0.012 + 0.012 * h3), L * (0.08 + 0.84 * fract(k * 0.618)) + 0.7 * sin(uClock * 0.15 + k * 2.3));
}

fn sig_vol_e3(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    let C = uClock;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    let aft = rxLife(0.3, 1.1, 0.35);
    if aft <= 0.01 {
        return fx;
    }
    let fd = ni_feed();
    if part(2.0) > 0.5 {
        // what it has taken, sinking toward the hand as sparks of red
        fx += (1.4 + fd) * xDust(ro, rd, 3.2, 1.4, 0.6, -C * 0.04, L * 0.04, L, 0.9, 305.0, Rd + Pl * 0.3, Dp * 1.6);
        fx += 1.5 * vec3<f32>(0.0);
    }
    // the glow of the shards turning round it
    if part(3.0) > 0.5 {
        var t: f32;
        for (var i = 0; i < 9; i++) {
            let k = f32(i);
            var R: f32;
            let c = ni_shard(k, &R);
            fx += Rd * 0.5 * halo(rayPt(ro, rd, c, &t), R * 2.3) * 0.5 * (0.6 + 0.4 * sin(C * 0.5 + k * 2.0));
        }
    }
    if part(4.0) > 0.5 {
        fx += (0.9 + 0.5 * fd) * syMistSpin(ro, rd, 0.3, L, 1.2, 5.2, -0.022, 303.0, Dp * 1.1, Bk * 5.0);
    }
    return fx * aft * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_grown(g, b, r, px) * growGlow(b);
}

fn sig_vol_solid_e3(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    var o: vec4<f32> = vec4<f32>(0.0);
    if uFx <= 0.0 || part(3.0) < 0.5 || fxNear(ro, rd, 0.0, uLength) > 16.0 {
        return o;
    }
    for (var i = 0; i < 9; i++) {
        let k = f32(i);
        var R: f32;
        let c = ni_shard(k, &R);
        let q = ni_splinter(ro, rd, px, c, R, k);
        if q.a > o.a {
            o = q;
        }
    }
    o.a *= uFx * rxLife(0.3, 1.3, 0.35) * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
    return o;
}

fn sig_solid(o_in: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    var o = o_in;
    // the hunger itself: a black cloud behind it being drawn in toward the blade, red veins of what it feeds on running inward through it
    if part(4.0) > 0.5 && uFx > 0.0 && b.y > 0.0 && b.y < uLength {
        let d = abs(b.x);
        let side = select(6.0, 2.0, b.x > 0.0);
        let reach = (2.8 + 2.2 * rxFlow(vec2(b.y * 0.1 + uClock * 0.04, side))) * smoothstep(0.0, uLength * 0.14, b.y) * (1.0 - smoothstep(uLength * 0.86, uLength * 1.02, b.y));
        let a = (1.0 - smoothstep(reach * 0.25, reach, d)) * 0.9 * rxLife(0.4, 1.4, 0.3);
        if a > 0.003 {
            let q = vec2(d * 0.62 + uClock * 0.11 + side, b.y * 0.17 + 0.03 * sin(uClock * 0.2));
            let w0 = vec2(rxFlow(q * 1.2 + 3.0), rxFlow(q * 1.4 + 7.0)) - 0.5;
            let n = rxFlow(q + w0 * 1.5);
            var dark = mix(vec3<f32>(0.006, 0.002, 0.004), Dp * 0.5, smoothstep(0.42, 0.8, n));
            dark += Rd * (1.0 - smoothstep(0.0, 0.1, abs(n - 0.5))) * 0.2 * (0.6 + 0.6 * ni_feed());
            o = vec4(mix(o.rgb, dark, a), max(o.a, a));
        }
    }
    return sig_solid_e2(o, b, px);
}

fn sig_vol_r24(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_e3(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    let C = uClock;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return base;
    }
    if part(5.0) > 0.5 {
        let w0 = ni_world();
        var t: f32;
        let dm = rayPtRaw(ro, rd, w0, &t);
        a += (Rd * 0.42 * halo(dm, 2.3) + Dp * halo(dm, 4.0) * 0.5) * (0.7 + 0.3 * sin(C * 0.5)) * (1.0 - behindBlade(ro, rd, t));
        // its life torn away: sparks leaving it one after another and falling into the blade
        for (var i = 0; i < 14; i++) {
            let k = f32(i);
            let q = fract(C * 0.07 + k / 14.0);
            let to = vec3(0.0, w0.y * (0.55 + 0.04 * sin(k * 2.0)), 0.0);
            let side = 0.7 * sin(k * 1.7 + C * 0.2) * (1.0 - q) * q * 4.0;
            let pos = mix(w0, to, q * q) + vec3(side * 0.5, side, -side * 0.4);
            let dp = rayPt(ro, rd, pos, &t);
            a += (Pl * halo(dp, 0.05) * 1.5 + Rd * halo(dp, 0.2) * 0.85) * smoothstep(0.0, 0.08, q) * (1.0 - smoothstep(0.86, 1.0, q)) * ni_whole();
        }
        // it bursts: a slow bloom of red light, its pieces fly out and race round the blade until they fade
        let yr = ni_year();
        let burst = smoothstep(0.58, 0.64, yr) * (1.0 - smoothstep(0.66, 0.8, yr));
        a += (Pl * halo(dm, 1.0) * 0.8 + Rd * halo(dm, 2.2) * 0.5) * burst;
        // out from the ball, round the blade, back into it
        let qb = (yr - 0.6) / 0.4;
        if qb > 0.0 && qb < 1.0 {
            let leave = 1.0 - pow(1.0 - clamp(qb * 4.5, 0.0, 1.0), 3.0);
            let race = smoothstep(0.08, 0.3, qb) * (1.0 - smoothstep(0.62, 0.86, qb));
            let life = smoothstep(0.0, 0.03, qb) * (1.0 - smoothstep(0.97, 1.0, qb));
            for (var i = 0; i < 14; i++) {
                let k = f32(i);
                let h0 = h11(k * 3.1 + 7.0);
                let h1 = h11(k * 5.3 + 2.0);
                let h2 = h11(k * 8.7 + 4.0);
                let sg = select(-1.0, 1.0, glsl_mod(k, 2.0) < 0.5);
                let dir = normalize(vec3(h0 - 0.5, h1 - 0.5, h2 - 0.5) + 0.001);
                let near_ = w0 + dir * (1.0 + 2.6 * h0) * leave * (1.0 - smoothstep(0.8, 1.0, qb));
                // each its own path: quick round the blade, climbing and sinking at its own beat
                let path = around(2.4 + 2.4 * h1 + 0.8 * sin(C * 0.6 + k * 2.0), h2 + sg * C * (0.42 + 0.28 * h0), L * (0.5 + 0.38 * sin(C * (0.35 + 0.3 * h1) + k * 2.4)));
                a += 1.8 * gxPiece(ro, rd, px, mix(near_, path, race), (0.3 + 0.24 * h0) * (1.0 - 0.6 * smoothstep(0.86, 1.0, qb)), k + 40.0, 0.0, Pl, Rd) * life;
            }
        }
    }
    return base + a * rxLife(0.3, 1.2, 0.4) * uFx * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}

fn sig_vol_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    var o = sig_vol_solid_e3(ro, rd, px);
    if uFx > 0.0 && part(5.0) > 0.5 && fxNear(ro, rd, 0.0, uLength) < 6.6 {
        var tm: f32;
        let R = 1.7 * rxLife(0.6, 2.2, 0.35) * ni_whole();
        let c = ni_world();
        let d = rayPtRaw(ro, rd, c, &tm);
        if R > 0.05 && d < R + 0.1 {
            let e1 = normalize(cross(rd, vec3<f32>(0.0, 1.0, 0.0)));
            let e2 = cross(rd, e1);
            let w0 = ro + rd * tm - c;
            let u = vec2(dot(w0, e1), dot(w0, e2)) / R;
            let r0 = length(u);
            let nz = sqrt(max(1.0 - r0 * r0, 0.0));
            let p = u / (0.55 + 0.45 * nz) + vec2(uClock * 0.004, 0.0);
            let v = rxFlow(p * 2.1 + 4.0);
            let v2 = rxFlow(p * 4.4 + 9.0);
            let crack = max(1.0 - smoothstep(0.0, 0.03, abs(v - 0.5)), 0.7 * (1.0 - smoothstep(0.0, 0.022, abs(v2 - 0.5))));
            let lit = 0.22 + 0.65 * clamp(dot(vec3(u, nz), normalize(vec3<f32>(-0.6, 0.5, 0.6))), 0.0, 1.0);
            let col = mix(vec3<f32>(0.02, 0.012, 0.014), vec3<f32>(0.15, 0.09, 0.09), smoothstep(0.3, 0.7, vn(p * 3.0))) * (0.5 + 1.6 * lit) + Rd * crack * (0.75 + 0.5 * ni_feed()) + Rd * smoothstep(0.55, 0.95, r0) * 0.25;
            var cov = (1.0 - smoothstep(0.86 - px / R, 1.0 + px / R, r0)) * (1.0 - behindBlade(ro, rd, tm));
            cov *= uFx * tipFade(ro, rd) * hiltFade(ro, rd);
            if cov > o.a {
                o = vec4(col, cov);
            }
        }
    }
    return o;
}

// >>> how it answers: as it lights, in a swing, in a clash
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let base = sig_vol_r24(ro, rd, px);
    var a: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return base;
    }
    let ig = select(0.0, 1.0 - smoothstep(0.3, 3.0, uAge), uAge < 2000.0);
    let sw = clamp(uSwing, 0.0, 1.0);
    a += ig * 1.35 * gxVortex(ro, rd, px, 14.0, 6.0, 305.0, Pl, Rd);
    a += 1.45 * gxBurst(ro, rd, px, 11.0, 4.8, 0.0, 0.36, 306.0, Pl, Rd);
    a += sw * 1.1 * gxVortex(ro, rd, px, 10.0, 4.6, 307.0, Pl, Rd);
    return base + a * tipFade(ro, rd) * hiltFade(ro, rd) * growMask(ro, rd);
}
