            dv.y *= 1.0 - 0.35 * smoothstep(0.0, 0.3, fall);
            let a = (1.0 - smoothstep(rr * 0.3, rr * 1.1, length(dv))) * smoothstep(0.0, 0.2, q) * (1.0 - smoothstep(0.85, 1.0, q));
            res = vec4(mix(res.rgb, IS_INK, a * 0.9), max(res.a, a * 0.9));
        }
    }
    // effect 5: the ink splash, swung, long curved splashes of ink flung off its upper half
    let sw = smoothstep(0.2, 0.9, clamp(uSwing, 0.0, 1.0));
    if part(4.0) > 0.5 && sw > 0.01 && b.y > uLength * 0.4 && b.y < top + 2.0 {
        let lane = is_flow(vec2(b.y * 0.6, (uTime * 0.4) * 0.5));
        let reach = (1.5 + 3.0 * lane) * sw;
        let streak = abs(sin(b.y * 1.4 + x * 0.6 + 2.0 * lane));
        let a = (1.0 - smoothstep(0.0, 0.18, streak)) * (1.0 - smoothstep(reach * 0.3, reach, max(dEdge, 0.0))) * smoothstep(0.0, 0.2, dEdge) * 0.8;
        res = vec4(mix(res.rgb, IS_INK, a), max(res.a, a));
    }
    // the body: rice-paper white glowing from within, grey ink veins drifting up through it
    if b.y >= -0.2 && b.y <= top {
        let cov = fillD(x - half, min(px, 0.05)) * smoothstep(0.02, 0.12 + px, half);
        if cov > 0.0 {
            let u = clamp(x / max(half, 0.01), 0.0, 1.0);
            var col = mix(IS_PAPER * 1.05, IS_PAPER * 0.85, smoothstep(0.4, 1.0, u));
            if part(0.0) > 0.5 {
                let vein = abs(is_flow(vec2(b.x * 3.0 + 1.0, b.y * 0.25 - (uTime * 0.4) * 0.25)) - 0.5);
                col = mix(col, IS_GREY, (1.0 - smoothstep(0.0, 0.06, vein)) * 0.55);
            }
            col = mix(col, IS_GREY * 0.7, smoothstep(0.85, 1.0, u) * 0.5);
            let a = cov;
            res = vec4(mix(res.rgb, col, a), max(res.a, a));
        }
    }
    return res;
}

// Incense round it: broad pale breaths turning slowly up the blade, never near its middle, gold dust
// settling down through them, one long stroke of light drawn round it now and then.
fn sig_vol_tc(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return fx;
    }
    let L = uLength;
    var t0: f32;
    let aft = rxLife(0.0, 0.3, 0.6);
    if aft <= 0.01 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    if part(5.0) > 0.5 {
        for (var i = 0; i < 4; i++) {
            let k = f32(i);
            let y0 = L * (0.04 + 0.22 * k);
            fx += 0.26 * xPuffs(ro, rd, 1.2, 2.5 + 0.6 * h11(k * 3.3), 0.45, k * 0.29 + 0.0035 * uTime, y0, y0 + L * 0.36, 1.6, k + 7.0, IS_PAPER, IS_GREY);
        }
    }
    if part(1.0) > 0.5 {
        fx += gxKin(ro, rd, 4.0, 6.0, 3.00, 0.040, 0.26, 0.08, 0.96, 1.0, 7858.0, vec3<f32>(1.0, 0.86, 0.5), IS_INK);
        for (var i = 0; i < 2; i++) {
            let k = f32(i);
            fx += 0.8 * xComets(ro, rd, 1.5, 2.1, 0.8, k * 0.5 + 0.004 * uTime, L * (0.1 + 0.3 * k), L * (0.5 + 0.3 * k), 0.28, k + 31.0, vec3<f32>(1.0, 0.88, 0.55), IS_INK);
        }
    }
    // great strokes of gold drawn round it by an unseen brush, up to its very point
    if part(4.0) > 0.5 {
        for (var i = 0; i < 3; i++) {
            let k = f32(i);
            var sa: f32;
            let q0 = fract(uClock * 0.09 + k / 3.0);
            var bWs: f32 = 0.0;
            var best: f32 = 1.0e3;
            var bf: f32 = 0.0;
            var prev = around(0.9, k * 0.37 + q0 * 0.2, L * (0.05 + 0.1 * k));
            for (var j = 1; j <= 10; j++) {
                let g = f32(j) / 10.0;
                let q = around(0.9 + 1.0 * sin(3.1416 * g), k * 0.37 + q0 * 0.2 + 0.8 * g, mix(L * (0.05 + 0.1 * k), L + 0.1, g));
                let d = raySeg(ro, rd, prev, q, &sa);
                {
                    let wN = bW(d);
                    bWs += wN;
                    best = min(best, d);
                    bf += ((f32(j) - 1.0 + sa) / 10.0 - bf) * wN / bWs;
                }
                prev = q;
            }
            let wd = mix(0.11, 0.015, bf);
            let life = sin(3.1416 * q0);
            fx += (vec3<f32>(1.0, 0.9, 0.62) * (1.0 - smoothstep(wd * 0.5, wd + max(px, 0.02), best)) * 0.9 + IS_INK * halo(best, wd * 3.5) * 0.6) * life * (1.0 - smoothstep(q0 * 1.6, q0 * 1.6 + 0.1, bf));
        }
    }
    let tipl = halo(rayPt(ro, rd, vec3(0.0, L, 0.0), &t0), 1.1);
    fx += IS_INK * tipl * 0.5;
    // gold stars of the old library hanging in the incense, and leaf falling slowly through them
    if part(3.0) > 0.5 {
        for (var i = 0; i < 6; i++) {
            let k = f32(i);
            let p = around(2.5, 0.012 * uClock + 0.5 * glsl_mod(k, 2.0), L * (0.12 + 0.15 * k));
            fx += fxFlare(ro, rd, p, px, 0.15, 1.5, 4.0, 0.06, IS_INK * 1.2);
        }
        fx += 1.2 * shFlakes(ro, rd, 2.3, 0.8, L, 22.0, 2.6, -0.55, 0.14, 0.11, 0.4, 0.5, 33.0, vec3<f32>(1.0, 0.88, 0.55), IS_INK * 0.5);
    }
    // the lighting: a brush of gold runs up with the blade, shedding sparks; what is round it follows after
    let rise = smoothstep(0.0, 0.75, uAge);
    let reveal = (L + 6.0) * smoothstep(0.1, 1.3, uAge);
    var sr: f32;
    _ = raySeg(ro, rd, vec3<f32>(0.0), vec3(0.0, L + 4.0, 0.0), &sr);
    if uAge < 2000.0 {
        fx *= 1.0 - smoothstep(reveal - 5.0, reveal, sr * (L + 4.0));
    }
    var lit = fx;
    if uAge < 1.6 {
        let gone = 1.0 - smoothstep(0.75, 1.5, uAge);
        let head = vec3(0.0, L * rise, 0.0);
        let dh = rayPt(ro, rd, head, &t0);
        lit += (vec3<f32>(1.0, 0.92, 0.7) * halo(dh, 0.5) * 1.3 + IS_INK * halo(dh, 1.7) * 0.7) * gone;
        lit += 1.4 * rxSparkShower(ro, rd, px, head, clamp(uAge / 1.5, 0.0, 1.0), 26.0, 3.0, 3.0, vec3<f32>(1.0, 0.92, 0.7), IS_INK);
    }
    return lit * aft * uFx * hiltFade(ro, rd);
}

