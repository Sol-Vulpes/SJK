}

// One brush stroke on side s: a curve sweeping up from the blade's edge, out and back in, its
// width thick at its start and drying to a fine tail; its alpha (0 to 1) at b.
fn is_stroke(b: vec2<f32>, k: f32, s: f32) -> f32 {
    let L = uLength;
    let cyc = (uTime * 0.4) * 0.07 + h11(k * 3.3);
    let n = floor(cyc);
    let q = fract(cyc);
    var y0 = L * (0.04 + 0.7 * h11(n * 2.1 + k));
    let len = L * (0.25 + 0.2 * h11(n * 4.3 + k));
    if y0 + len > L + 0.3 {
        y0 = L + 0.3 - len;
    }
    let f = (b.y - y0) / len;
    if f < -0.05 || f > 1.05 {
        return 0.0;
    }
    let ff = clamp(f, 0.0, 1.0);
    // painted on, then fading: the stroke grows along its length and dries away
    let drawn = smoothstep(0.0, 0.25, q);
    let dry = 1.0 - smoothstep(0.6, 1.0, q);
    let x = s * (0.6 + (1.3 + 0.8 * h11(n + k * 5.0)) * sin(3.1416 * ff) * (0.8 + 0.2 * sin((uTime * 0.4) * 0.3 + k)));
    let w = mix(0.6, 0.05, pow(ff, 0.8));
    let dd = abs(b.x - x);
    // its dry-brush texture: thin streaks along it
    let bristle = 0.86 + 0.14 * sin(dd * 9.0 / max(w, 0.03) + ff * 3.0);
    var a = (1.0 - smoothstep(w * 0.6, w, dd)) * bristle;
    a *= smoothstep(-0.05, 0.05, f) * (1.0 - smoothstep(drawn - 0.05, drawn, ff)) * (1.0 - smoothstep(0.95, 1.05, f));
    return a * dry;
}

// effects 1 to 5, painted over the glow
fn sig_solid_raw(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let top = uLength + 0.3;
    if b.y < -1.0 || b.y > top + 4.0 {
