        }
        ink *= 0.92;
        res = vec4(mix(res.rgb, IS_INK, ink), max(res.a, ink));
    }
    // effect 4: falling ink, drops gathering on its edge and falling away
    if part(3.0) > 0.5 {
        for (var i = 0; i < 5; i++) {
            let k = f32(i);
            let cyc = (uTime * 0.4) * (0.12 + 0.05 * h11(k * 2.7)) + h11(k * 6.1);
            let n = floor(cyc);
            let q = fract(cyc);
            let s = select(-1.0, 1.0, h11(n * 3.9 + k) > 0.5);
            let y0 = uLength * (0.2 + 0.7 * h11(n * 5.3 + k));
            let fall = max(q - 0.4, 0.0) / 0.6;
            let c = vec2(s * (0.6 + 0.3 * fall), y0 - 9.0 * fall * fall);
            let rr = 0.12 + 0.08 * smoothstep(0.0, 0.4, q);
            // a drop, a little longer than round as it falls
