    let dEdge = x - half;
    if part(2.0) > 0.5 && b.y > 0.0 && b.y < top && dEdge > 0.0 && dEdge < 1.5 {
        let bleed = is_flow(vec2(b.y * 0.4 - (uTime * 0.4) * 0.15, b.x * 1.5 + 3.0));
        let wash = (1.0 - smoothstep(0.1, 0.5 + 0.8 * bleed, dEdge)) * 0.45 * bleed;
        res = vec4(mix(res.rgb, IS_GREY * 0.5, wash), max(res.a, wash));
