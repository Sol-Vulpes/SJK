// Kathol Rift (new 2/11/2026, update 30): the Kathol Rift, the strange storm of space where the Aing-Tii monks walk
// through time. No tube of light at all: the blade is one long ribbon, twisted like a Mobius band, forever turning
// on itself. One face is deep space with slow stars in it; the other is liquid gold. Where it turns edge-on it
// pinches thin and burns with every colour. Time is wrong around it: the twist runs on, slows, stops and runs
// backward; ghosts of the ribbon as it was a moment ago hang beside it; two streams of light wind round it the
// opposite way; motes fall upward and then back down. Lit, the ribbon unscrews out of the hilt; let go, it winds back.
const KA_NIGHT: vec3<f32> = vec3<f32>(0.02, 0.015, 0.075);

const KA_TEAL: vec3<f32> = vec3<f32>(0.05, 0.42, 0.55);

const KA_VIOLET: vec3<f32> = vec3<f32>(0.42, 0.16, 0.95);

const KA_GOLD: vec3<f32> = vec3<f32>(1.0, 0.68, 0.18);

const KA_PALE: vec3<f32> = vec3<f32>(1.0, 0.93, 0.72);

fn ka_life() -> f32 {
    if uAge >= 2000.0 {
        return 1.0 - smoothstep(0.0, 0.5, uAge - 2000.0);
    }
    return smoothstep(0.0, 0.6, uAge);
}

// the twist's own time: it runs on, slows, stops and runs back a little
fn ka_time(t: f32) -> f32 {
    return t * 0.85 + 1.9 * sin(t * 0.37) + 0.9 * sin(t * 0.61 + 1.0);
}

// the ribbon's turn at y at time t; lit, it spins fast and settles; let go, it winds back
fn ka_phi(y: f32, t: f32) -> f32 {
    let wind = select(7.0 * (1.0 - smoothstep(0.0, 0.8, uAge)), 7.0 * smoothstep(0.0, 0.5, uAge - 2000.0), uAge >= 2000.0);
    return y * (0.36 + 0.05 * sin(t * 0.13)) - ka_time(t) + wind;
}

fn ka_half(y: f32, top: f32, phi: f32) -> f32 {
    let e = 1.0 - clamp((top - y) / 0.9, 0.0, 1.0);
    let end = sqrt(max(1.0 - e * e, 0.0));
    return (0.86 + 0.09 * cos(phi)) * end * mix(0.55, 1.0, smoothstep(0.0, 1.2, y));
}

fn sig_glow_tc(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = (uLength + 0.2) * ka_life();
    if top < 0.15 {
        return vec3<f32>(0.0);
    }
    let yc = clamp(b.y, 0.0, top);
    let phi = ka_phi(yc, uClock);
    let d = max(length(vec2(b.x, b.y - yc)) - ka_half(yc, top, phi), 0.0);
    let c = cos(phi);
    let tone = mix(KA_VIOLET, KA_GOLD, 0.5 + 0.5 * c / (abs(c) + 0.2));
    var col = tone * (halo(d, 0.2) * 0.6 + halo(d, 0.9) * 0.2 + halo(d, 2.4) * 0.07);
    col += lvl(g) * tone * (1.0 - smoothstep(0.3, 1.2, abs(b.y))) * 0.25;
    // echoes: the ribbon as it was a moment ago, hanging beside it, clear as a breath on glass
    if part(2.0) > 0.5 && uFx > 0.0 {
        let show = rxLife(0.5, 1.5, 0.3) * (0.55 + 0.45 * smoothstep(-0.2, 0.7, sin(uClock * 0.29)));
        for (var i = 0; i < 2; i++) {
            let k = f32(i) + 1.0;
            let dt = uClock - k * 0.85;
            let ph = ka_phi(yc, dt);
            let off = (k * 0.7 + 0.25 * sin(yc * 0.21 + dt * 0.5)) * (select(-1.0, 1.0, i == 0));
            let de = abs(abs(b.x - off) - ka_half(yc, top, ph));
            let hue = fract(yc * 0.012 + ph * 0.05 + 0.13 * k);
            col += hsv(hue, 0.65, 1.0) * (halo(de, 0.16) * 0.2 + halo(de, 0.45) * 0.08) * show * (1.0 - smoothstep(top - 1.5, top, b.y)) * smoothstep(0.0, 3.0, b.y) / k;
        }
    }
    return col * roomFade(abs(b.x)) * (1.0 + 0.7 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let top = (uLength + 0.2) * ka_life();
    if top < 0.15 || b.y < -0.3 || b.y > top + 0.2 {
        return o;
    }
    let phi = select(0.0, ka_phi(b.y, uClock), part(0.0) > 0.5);
    let half = ka_half(b.y, top, phi);
    let cov = (1.0 - smoothstep(half - 0.04 - px, half + 0.03 + px, abs(b.x))) * smoothstep(0.02, 0.12 + px, half) * smoothstep(-0.25, 0.1, b.y);
    if cov <= 0.0 {
        return o;
    }
    // (update 30, Creyon: odd, cheap) one blade: two ribbons wound round it, night and gold, sliding along each other
    let wrap = phi + asin(clamp(b.x / max(half, 0.01), -1.0, 1.0)) * 1.15;
    let c = cos(wrap);
    let s0 = sin(wrap);
    // which face you see, soft where it turns edge-on
    let face = 0.5 + 0.5 * c / (abs(c) + 0.28);
    let u = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    // round the band: it tilts toward you on one side as it turns
    let lit = 0.62 + 0.55 * sqrt(max(1.0 - u * u, 0.0));
    var col = mix(vec3<f32>(0.62, 0.3, 0.95), KA_GOLD, face);
    if part(1.0) > 0.5 {
        // the night face: deep space, slow clouds, small round stars carried along the band
        let q = vec2(u * 1.1, b.y * 0.09 - ka_time(uClock) * 0.13);
        let n = rxFlow(q + 0.7 * rxFlow(q * 0.8 + 5.0));
        var night = mix(KA_NIGHT, mix(KA_VIOLET * 0.75, KA_TEAL, smoothstep(0.35, 0.8, rxFlow(q * 1.4 + 2.0))), smoothstep(0.42, 0.95, n));
        let sc = vec2(u * 2.0 + 3.0, b.y * 0.8 - ka_time(uClock) * 1.0);
        let si = floor(sc);
        let sp = si + 0.2 + 0.6 * h22(si);
        night += vec3<f32>(0.9, 0.95, 1.0) * halo(length(sc - sp), 0.13) * step(0.6, h21(si + 2.0)) * (0.75 + 0.25 * sin(uClock * 1.4 + h21(si) * 17.0));
        // the gold face: thick liquid, slow bright currents folding over each other
        let g0 = vec2(u * 1.6 + 0.5 * sin(b.y * 0.15 + uClock * 0.3), b.y * 0.16 + ka_time(uClock) * 0.42);
        let gf = rxFlow(g0 + 0.9 * rxFlow(g0 * 0.75 + 9.0));
        var gold = mix(vec3<f32>(0.92, 0.52, 0.1), KA_GOLD * 1.25, smoothstep(0.2, 0.6, gf));
        gold = mix(gold, KA_PALE * 1.15, smoothstep(0.58, 0.9, gf));
        col = mix(night, gold, face);
    }
    col *= lit;
    // edge-on, it burns with every colour
    let edgeOn = 1.0 - smoothstep(0.0, 0.3, abs(c));
    col = mix(col, hsv(fract(b.y * 0.03 - uClock * 0.12), 0.72, 1.0) * 1.25, edgeOn * 0.6);
    col = mix(col, KA_PALE * 1.1, (1.0 - smoothstep(0.0, 0.42, abs(u))) * (0.22 + 0.3 * face));
    // a thin bright line along both its edges, soft, the colour of the side it borders
    col += mix(KA_VIOLET * 1.2, KA_PALE, face) * (1.0 - smoothstep(0.0, 0.17, half - abs(b.x))) * 0.75;
    col += KA_PALE * halo(max(b.y, 0.0), 0.5) * 0.4;
    col = mix(col, KA_PALE, 0.5 * clamp(uClash, 0.0, 1.0));
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

fn sig_vol_tc(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
