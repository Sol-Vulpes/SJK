    col *= (0.45 + 0.7 * nz) * 1.5;
    col += M * pow(1.0 - nz, 3.0) * 0.5;
    col = mix(col, H, (1.0 - smoothstep(0.0, 0.55, abs(u))) * 0.75);
    col += H * halo(max(b.y, 0.0), 0.5) * 0.5;
    col = mix(col, H, 0.45 * clamp(uClash, 0.0, 1.0));
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

