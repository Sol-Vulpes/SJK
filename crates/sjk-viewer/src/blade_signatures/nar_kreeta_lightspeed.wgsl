    let aft = rxLife(0.15, 0.7, 0.35);
    if aft <= 0.01 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    let mom = kMoment();
    if part(1.0) > 0.5 {
        for (var i = 0; i < 16; i++) {
            let k = f32(i);
            let rr = 1.2 + 3.0 * h11(k * 3.1);
            let a = h11(k * 5.3);
            let sp = (3.0 + 2.4 * h11(k * 2.2)) * (1.0 + 1.5 * mom);
            let yy = glsl_mod(C * sp + k * 7.3, L + 8.0) - 4.0;
            let ln = (2.0 + 2.5 * h11(k * 7.1)) * (1.0 + 1.5 * mom);
            let p0 = around(rr, a, yy);
            let p1 = around(rr, a, yy + ln);
            var s2: f32;
            let d = raySeg(ro, rd, p0, p1, &s2);
            let hue = mix(M, A, step(0.5, h11(k * 9.9)));
            fx += (H * halo(d, max(0.03, px)) * 1.2 + hue * halo(d, 0.16) * 0.65) * s2 * smoothstep(0.0, 2.0, yy) * (1.0 - smoothstep(L - 2.0, L + 2.0, yy + ln));
        }
    }
    if part(2.0) > 0.5 {
        fx += mom * 0.25 * fxAura(ro, rd, 0.0, L, 2.4, M);
        fx += 1.0 * fxCoils(ro, rd, px, 1.0, L - 1.0, 1.15, 0.35, 0.22, 2.0, M);
    }
    if part(3.0) > 0.5 {
        for (var i = 0; i < 3; i++) {
            let k = f32(i);
            fx += 1.1 * rxComet(ro, rd, px, 1.6 + 0.8 * k, L * 0.05, L * 0.9, 5.0 + 1.3 * k, k + 3.0, H, A);
        }
    }
    // effects rise with the blade as it lights and sink with it as it goes out
    var sa: f32;
    _ = raySeg(ro, rd, vec3<f32>(0.0, 0.0, 0.0), vec3(0.0, L + 4.0, 0.0), &sa);
    let grownTop = (L + 6.0) * rxLife(0.0, 0.55, 0.32);
    fx *= 1.0 - smoothstep(grownTop - 4.0, grownTop, sa * (L + 4.0));
    // nothing over the point
    fx *= tipFade(ro, rd);
    return fx * aft * uFx * hiltFade(ro, rd);
}

