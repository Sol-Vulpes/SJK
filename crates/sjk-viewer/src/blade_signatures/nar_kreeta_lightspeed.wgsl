fn k_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    if b.y < -0.3 || b.y > L + 0.3 {
        return o;
    }
    let half = k_half(b.y, select(1.0, -1.0, b.x < 0.0));
    let cov = (1.0 - smoothstep(half - 0.05 - px, half + 0.03 + px, abs(b.x))) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    let ang = asin(u);
    let nz = sqrt(max(1.0 - u * u, 0.0));
    let x = b.x;
    let y = b.y;
    let s = clamp(y / max(L, 1.0), 0.0, 1.0);
    let T = uTime;
    let C = uClock;
    var col = M;
    if part(0.0) > 0.5 {
        let run = kf(x * 1.5, y * 0.1 - T * 0.55) + 0.5 * kf(x * 2.8, y * 0.2 - T * 0.8);
        col = mix(D, M, smoothstep(0.2, 0.85, run));
        col += H * smoothstep(0.95, 1.3, run) * 0.9;
