// Crait Salt Flats (reworked 1/11/2026, update 16: Creyon asked four times; it looked too like
// Bleeding Kyber, a pale blade with red rising up it through cracks): now the other way round and
// moving its own way. Its body is the crystal under Crait's salt, deep blue with a darker grain drifting
// in it, and white salt grows over it from its edges in a fine crystalline frost that glints. Every
// 14 seconds a gust of wind sweeps up the blade from the emitter to the point in a second and a
// half and blows the salt off it: the crust lifts away as white salt powder that spirals off round
// the blade and thins out, leaving the crystal bare, and the frost slowly creeps back over it. A
// fine salt wind streams round the blade all the time, leaning as it climbs. Swung, the salt is
// scraped off in long blue streaks. No cracks, no red at all, no plumes to one
// side. No figures.
// Update 24 (Creyon: make it RGB, improve it): the speeder's furrow of Crait: a burning line winds up the
// salt and scores it open down to the colour beneath, red dust climbs off the blade in slow plumes, and
// fine white salt skims round it. Its edges no longer break into steps when seen along the blade.
const CR_SALT: vec3<f32> = vec3<f32>(0.95, 0.94, 0.92);

const CR_RED: vec3<f32> = vec3<f32>(0.42, 0.62, 1.0);

const CR_DEEP: vec3<f32> = vec3<f32>(0.06, 0.12, 0.42);

const CR_DUST: vec3<f32> = vec3<f32>(0.58, 0.68, 0.95);

// the gust's front on its 14-second cycle, sweeping up the blade in a second and a half (below the
// emitter when there is none), and how long ago it passed height y (seconds; large when long ago)
fn cr_front() -> f32 {
    if part(3.0) < 0.5 {
        return -100.0;
    }
    let t = glsl_mod(uClock + uSeed * 7.0, 14.0);
    return select((select(-100.0, uLength + 1.0 + (t - 1.5) * 20.0, t < 2.5)), (uLength + 2.0) * (t / 1.5) - 1.0, t < 1.5);
}

fn cr_since(y: f32) -> f32 {
    if part(3.0) < 0.5 {
        return 100.0;
    }
    let t = glsl_mod(uClock + uSeed * 7.0, 14.0);
    let passed = clamp((y + 1.0) / (uLength + 2.0), 0.0, 1.0) * 1.5;
    return select(t + 14.0 - passed, t - passed, t >= passed);
}

// how much salt crust lies at height y, 0 to 1: blown off as the gust passes, creeping back over
// eight seconds
fn cr_crust(y: f32) -> f32 {
    if part(0.0) < 0.5 {
        return 0.0;
    }
    // (update 20, Creyon: it looked as if it lagged, and the red climbing was ugly) the salt comes and
    // goes in long slow drifts along the blade, never a front; no steps
    let a = rxFlow(vec2(y * 0.07 - uClock * 0.1, 1.0));
    let g = select(0.0, 0.25 * sin(uClock * 0.45 + y * 0.05), part(3.0) > 0.5);
    return smoothstep(0.2, 0.75, a + g);
}

fn sig_glow_tc(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let L = uLength;
    // (update 20) its outline is the salt's: small crystals grown out of the edge
    let yc = clamp(b.y, 0.0, L);
    let half = rxHalf(yc, L, 0.56 + 0.2 * pow(rxFlow(vec2(yc * 0.42, select(9.0, 3.0, b.x < 0.0))), 2.0), 1.0);
    let d = rxOut(b, L, half);
    let crust = cr_crust(b.y);
    let sw = smoothstep(0.2, 0.9, clamp(uSwing, 0.0, 1.0));
    // the red earth's glow, brighter where the salt is off it
    var col = recol(g, CR_RED) * (0.55 + 0.45 * (1.0 - crust)) + CR_RED * halo(d, 0.7) * (0.3 + 0.35 * (1.0 - crust) + 0.3 * sw);
    col += CR_SALT * halo(d, 0.18) * 0.25 * crust;
    col *= tipFadeB(b);
    return col * roomFade(abs(b.x));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.55;
}

// effects 1 and 2: the scarlet body under its salt frost (growing in from both edges, glinting),
// and, swung, the salt scraped off in long blue streaks
fn sig_solid_raw(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    if b.y < -0.2 || b.y > L {
        return o;
    }
    // (update 20) its outline is the salt's: small crystals grown out of the edge
    let yc = clamp(b.y, 0.0, L);
    let half = rxHalf(yc, L, 0.56 + 0.2 * pow(rxFlow(vec2(yc * 0.42, select(9.0, 3.0, b.x < 0.0))), 2.0), 1.0);
    let x = abs(b.x);
    let cov = fillD(x - half, min(px, 0.05)) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(x / max(half, 0.01), 0.0, 1.0);
    let grain = rxFlow(vec2(b.x * 3.0, b.y * 0.35 - uClock * 0.18));
    var col = mix(CR_RED * 1.15, CR_DEEP, smoothstep(0.45, 0.9, grain) * 0.6);
    col += vec3<f32>(1.0, 0.55, 0.45) * (1.0 - u) * 0.25;
    let crust = cr_crust(b.y);
    // the frost: crystalline, growing in from the edges toward the middle as the crust returns
    let frost = rxFlow(vec2(b.x * 6.0 + 3.0, b.y * 0.9));
    let reach = crust * (1.05 + 0.35 * rxFlow(vec2(b.y * 0.6, 7.0)));
    var salt = smoothstep(1.0 - reach - 0.08, 1.0 - reach + 0.08, u + 0.25 * (frost - 0.5));
    if part(1.0) > 0.5 {
        let sw = smoothstep(0.2, 0.9, clamp(uSwing, 0.0, 1.0));
        let streak = smoothstep(0.5, 0.75, rxFlow(vec2(b.x * 7.0, b.y * 0.08 + 3.0)));
        salt *= 1.0 - streak * sw;
    }
    // the furrow: a line scored through the salt, winding up the blade, burning at its bottom
    let fx0 = half * (0.62 * sin(b.y * 0.2 - uClock * 0.34) + 0.2 * sin(b.y * 0.46 + uClock * 0.21));
    let fd = abs(b.x - fx0);
    let furrow = 1.0 - smoothstep(0.06, 0.2, fd);
    salt *= 1.0 - furrow;
    let crustCol = CR_SALT * (0.82 + 0.18 * frost);
    col = mix(col, crustCol, salt * 0.92);
    col += CR_RED * (1.0 - smoothstep(0.0, 0.1, fd)) * 1.1 + vec3<f32>(1.0, 0.6, 0.45) * (1.0 - smoothstep(0.0, 0.035, fd)) * 0.8;
    // glints on the crust
    if part(4.0) > 0.5 {
        let gl = pow(rxFlow(vec2(b.x * 7.0, b.y * 0.9 + 0.05 * uClock)), 10.0) * 3.0;
        col += vec3<f32>(1.0) * min(gl, 1.2) * salt;
    }
    let a = cov;
    return vec4(mix(o.rgb, col, a), max(o.a, a));
}

fn sig_vol_base(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return fx;
    }
    let L = uLength;
    if fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    let aft = rxLife(0.2, 1.0, 0.6);
    // effect 3: red dust climbing off it in slow plumes, fine white salt skimming round it
    if part(2.0) > 0.5 {
        for (var i = 0; i < 3; i++) {
            let k = f32(i);
            let y0 = L * (0.04 + 0.28 * k);
            fx += 0.4 * xPuffs(ro, rd, 1.0, 3.0, 0.3, k * 0.37 + 0.002 * uTime, y0, y0 + L * 0.4, 1.0, k + 17.0, CR_DUST, CR_RED * 0.7);
        }
        fx += gxKin(ro, rd, 0.0, 10.0, 2.60, 0.060, 0.20, 0.02, 0.50, 1.0, 7247.0, CR_SALT, CR_SALT * 0.5) * aft;
    }
    // effect 4: the gust: as its front passes, the crust lifts off as white powder spiralling away
    // round the blade, thinning over two seconds
    if part(3.0) > 0.5 {
        let t = glsl_mod(uClock + uSeed * 7.0, 14.0);
        let on = smoothstep(0.0, 0.3, t) * (1.0 - smoothstep(1.8, 3.8, t));
        if on > 0.01 {
            let f = cr_front();
            let y1 = clamp(f, 0.5, L + 0.5);
            fx += 2.2 * on * rxMistSpinP(ro, rd, 0.3, y1, 1.0, 3.2 + 1.5 * smoothstep(0.0, 3.0, t), 0.06 * uTime + 0.25 * t, 31.0, CR_SALT, CR_SALT * 0.35) * aft;
        }
    }
    return fx * uFx;
}

fn sig_vol_tc(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let fx = sig_vol_base(ro, rd, px);
    return fx * hiltFade(ro, rd);
}

// (update 26) the body starts softly in the emitter, no hard end above the hilt
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let r = sig_solid_raw(o, b, px);
    let j = smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, r.rgb, j), mix(o.a, r.a, j));
}

// (update 29, Creyon: nothing past the tip) every effect ends at the blade's end
fn sig_vol_34(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let fx = sig_vol_tc(ro, rd, px);
    var s: f32;
    _ = raySeg(ro, rd, vec3<f32>(0.0), vec3(0.0, uLength + 4.0, 0.0), &s);
    return fx * tipFade(ro, rd);
}

fn sig_glow_t1(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_tc(g, b, r, px) * tipFadeB(b);
}

