// Telos Restoration (rebuilt 3/11/2026): The Telos restoration, life returned to a burned world: a clean white blade with green rising up it in a slow year. Living shoots climb round it opening leaves as they go, pollen drifts off them, then they turn gold, wither and shed, and spring starts again.
const W: vec3<f32> = vec3<f32>(0.930, 1.000, 0.880);

const Gr: vec3<f32> = vec3<f32>(0.180, 0.860, 0.260);

const Dg: vec3<f32> = vec3<f32>(0.020, 0.200, 0.070);

const Au: vec3<f32> = vec3<f32>(1.000, 0.800, 0.320);

fn te_top() -> f32 {
    return uLength * rxLife(0.0, 0.5, 0.32);
}

fn te_half(y: f32) -> f32 {
    let top = te_top();
    if y > top {
        return 0.0;
    }
    let e = 1.0 - clamp((top - y) / 1.2, 0.0, 1.0);
    return 0.46 * sqrt(max(1.0 - e * e, 0.0));
}

// Spring climbs the blade in a 16 second year: 0 at the hand, 1 at the point, then it withers.
fn te_year() -> f32 {
    return fract(uClock / 16.0);
}

fn te_grow() -> f32 {
    let y = te_year();
    return smoothstep(0.0, 0.5, y) * (1.0 - smoothstep(0.82, 1.0, y));
}

fn te_wither() -> f32 {
    let y = te_year();
    return smoothstep(0.66, 0.84, y) * (1.0 - smoothstep(0.9, 1.0, y));
}

fn sig_glow_t1(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = te_top();
    let yc = clamp(b.y, 0.0, top);
    let d = max(length(vec2(b.x, b.y - yc)) - te_half(yc), 0.0);
    let front = te_grow() * uLength;
    let lit = 1.0 - smoothstep(front - 2.0, front + 3.0, b.y);
    var col = W * halo(d, 0.2) * 0.6 + mix(W * 0.45, Gr, lit) * (halo(d, 1.2) * 0.5 + halo(d, 3.6) * 0.18);
    col += lvl(g) * W * (1.0 - smoothstep(0.3, 1.5, abs(b.y))) * 0.25;
    col *= tipFadeB(b);
    return col * roomFade(abs(b.x)) * (1.0 + 0.7 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    if b.y < -0.3 || b.y > L + 0.3 {
        return o;
    }
    let half = te_half(b.y);
    let cov = (1.0 - smoothstep(half - 0.05 - px, half + 0.03 + px, abs(b.x))) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let u = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    let nz = sqrt(max(1.0 - u * u, 0.0));
    var col = W;
    if part(0.0) > 0.5 {
        let front = te_grow() * L;
        let v = rxFlow(vec2(b.x * 1.5, b.y * 0.09 - uClock * 0.1));
        let vein = 1.0 - smoothstep(0.0, 0.1, abs(v - 0.5));
        col = mix(W, mix(Gr, W, 0.2), vein * (1.0 - smoothstep(front - 2.0, front + 1.0, b.y)));
        col += Gr * exp(-pow((b.y - front) / 1.2, 2.0)) * (1.0 - te_wither()) * 0.6;
    }
    col *= 0.68 + 0.5 * nz;
    col = mix(col, W, 0.45 * clamp(uClash, 0.0, 1.0));
    col *= smoothstep(-0.25, 0.3, b.y);
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

// A climbing shoot: its line up the blade, how far it has grown, and leaves opening along it.
fn te_shoot(ro: vec3<f32>, rd: vec3<f32>, px: f32, k: f32) -> vec3<f32> {
    let L = uLength;
    let grown = te_grow();
    let w = te_wither();
    let len = grown * (0.72 + 0.28 * h11(k * 2.9));
    if len < 0.02 {
        return vec3<f32>(0.0);
    }
    let y0 = 0.3 + 0.9 * k;
    let a0 = k / 3.0 + 0.1;
    var bWs: f32 = 0.0;
    var best: f32 = 1.0e3;
    var bf: f32 = 0.0;
    var s: f32;
    var prev = around(0.7, a0, y0);
    for (var j = 1; j <= 16; j++) {
        let f = f32(j) / 16.0;
        if f - 1.0 / 16.0 > len {
            break;
        }
        let q = around(0.8 + 1.15 * sin(f * 9.0 + k * 2.0) * sin(f * 3.1416) + 0.25 * f, a0 + 0.8 * f + 0.02 * sin(uClock * 0.4 + k), mix(y0, L - 1.0, f));
        let dd = raySeg(ro, rd, prev, q, &s);
        {
            let wN = bW(dd);
            bWs += wN;
            best = min(best, dd);
            bf += ((f32(j) - 1.0 + s) / 16.0 - bf) * wN / bWs;
        }
        prev = q;
    }
    let ww = mix(0.15, 0.05, bf) * (1.0 - 0.3 * w);
    let stem = mix(Gr, Au * 0.75, w);
    var col = mix(stem, W, 0.25) * (1.0 - smoothstep(ww * 0.5, ww + px, best)) * 1.25 + stem * (halo(best, ww * 3.0) * 0.45 + halo(best, 0.7) * 0.1);
    // the leaves
    for (var i = 0; i < 9; i++) {
        let m = f32(i);
        let f = (m + 0.5 + 0.3 * h11(m * 3.3 + k)) / 9.0;
        let open = smoothstep(f, f + 0.16, len) * (1.0 - 0.4 * w);
        if open <= 0.0 {
            continue;
        }
        let at = around(0.8 + 1.15 * sin(f * 9.0 + k * 2.0) * sin(f * 3.1416) + 0.25 * f, a0 + 0.8 * f + 0.02 * sin(uClock * 0.4 + k), mix(y0, L - 1.0, f));
        let dir = m * 2.4 + k;
        let tip = at + vec3(sin(dir), 0.7 - 0.8 * w, cos(dir)) * (1.1 + 0.7 * h11(m * 5.1 + k)) * open;
        let mid = mix(at, tip, 0.55) + vec3<f32>(0.0, 0.14, 0.0);
        var s1: f32;
        var s2: f32;
        let d1 = raySeg(ro, rd, at, mid, &s1);
        let d2 = raySeg(ro, rd, mid, tip, &s2);
        let wl = select(0.3 * open * (1.0 - s2 * s2), 0.3 * open * smoothstep(0.0, 1.0, s1), d1 < d2);
        let dl = min(d1, d2);
        let leaf = mix(mix(Gr, W, 0.32), Au, w);
        col += leaf * (1.0 - smoothstep(wl * 0.65, wl + px + 0.02, dl)) * 1.1 + leaf * halo(dl, 0.42) * 0.14;
    }
    return col;
}

fn sig_vol_t1(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    if uFx <= 0.0 || fxNear(ro, rd, 0.0, L) > 16.0 {
