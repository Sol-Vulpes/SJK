}

// effects 1 and 2: crusted lava with magma flowing up through the gaps, and bubbles swelling and
// bursting on it (round, each kept inside its own cell)
fn sig_solid_raw(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    if b.y < -0.2 || b.y > L {
        return o;
    }
    let half = rxHalf(clamp(b.y, 0.0, L), L, 0.6, 1.0);
    let x = abs(b.x);
    let cov = fillD(x - half, min(px, 0.05)) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    var col = SL_CRUST;
    if part(0.0) > 0.5 {
        let f = rxFlow(vec2(b.x * 3.0, b.y * 0.5 - (uTime * 0.4) * 0.6));
        let flow = smoothstep(0.45, 0.62, f);
        col = mix(SL_CRUST, mix(SL_MAGMA, SL_HOT, smoothstep(0.62, 0.8, f)), flow);
    }
    if part(1.0) > 0.5 {
        let gq = vec2(b.x * 2.4, b.y * 0.9 - (uTime * 0.4) * 0.4);
        let c0 = floor(gq);
        let ctr = c0 + 0.3 + 0.4 * h22(c0);
        let life = fract((uTime * 0.4) * 0.35 + h21(c0));
        let rad = 0.05 + 0.2 * life;
        let dist = length(gq - ctr);
        let shown = step(0.55, h21(c0 + 4.0));
        col += SL_HOT * halo(dist, 0.5 * rad) * shown * (0.6 + 1.5 * smoothstep(0.85, 1.0, life)) * (1.0 - smoothstep(0.95, 1.0, life));
    }
    let a = cov;
    return vec4(mix(o.rgb, col, a), max(o.a, a));
}

// effect 3: spatter, drops of lava flung off and falling, glowing as they cool
// The 3D structure round it (1/11/2026, Creyon: the lower tiers filled out so they are never
// plain, each its own shape): the heat: a red haze of heat and smoke rising fast off the blade, and drops of magma spat out of it. Lit, it grows in; let go, it fades.
fn cx_more(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    let aft = rxLife(0.2, 1.0, 0.6);
    if part(3.0) < 0.5 || aft <= 0.01 || fxNear(ro, rd, 0.0, L) > 16.0 {
        return fx;
    }
    {
        fx += 1.6 * syMist(ro, rd, 0.5, L * 0.95, 4.2, 0.7, 18.0, SL_MAGMA * 0.7, SL_CRUST + SL_MAGMA * 0.15);
        fx += rxBorn(ro, rd, px, 18.0, 0.5, L * 0.9, 0.5, 3.0, 2.0, 0.07, 18.0, SL_HOT, SL_MAGMA);
    }
    return fx * aft;
}

fn sig_vol_base(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 || part(2.0) < 0.5 {
        return fx;
    }
    let L = uLength;
    var t: f32;
    if fxNear(ro, rd, -4.0, L) > 4.0 {
        return fx + cx_more(ro, rd, px) * uFx;
    }
    for (var i = 0; i < 12; i++) {
        let k = f32(i);
        let cyc = (uTime * 0.4) * (0.35 + 0.2 * h11(k * 2.3)) + h11(k * 7.1);
        let n = floor(cyc);
        let q = fract(cyc);
        let p = around(0.6 + 1.8 * q, h11(n * 3.7 + k), L * (0.2 + 0.75 * h11(n * 5.1 + k)) + 2.0 * q - 6.0 * q * q);
        let c = mix(SL_HOT, vec3<f32>(0.6, 0.08, 0.0), q);
        fx += (c * halo(rayPt(ro, rd, p, &t), max(0.07, px)) * 1.5 + SL_MAGMA * halo(rayPt(ro, rd, p, &t), 0.25) * 0.3) * smoothstep(0.0, 0.05, q) * (1.0 - q) * roomAt(p);
    }
    return (fx * uFx) + cx_more(ro, rd, px) * uFx;
}

