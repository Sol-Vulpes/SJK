// Sullust Magma: the molten rivers of Sullust shaped into a blade. Its body is dark crusted
// lava with bright magma flowing up through the gaps in its crust; bubbles of magma swell and
// burst on its surface; drops of lava spatter off it and fall glowing; heat glows round it. No
// figures.
const SL_CRUST: vec3<f32> = vec3<f32>(0.12, 0.04, 0.02);

const SL_MAGMA: vec3<f32> = vec3<f32>(1.0, 0.45, 0.05);

const SL_HOT: vec3<f32> = vec3<f32>(1.0, 0.85, 0.4);

fn sig_glow_tc(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let L = uLength;
    let half = rxHalf(clamp(b.y, 0.0, L), L, 0.6, 1.0);
    let d = rxOut(b, L, half);
    var col = recol(g, SL_MAGMA) * 0.5;
    if part(3.0) > 0.5 {
        col += SL_MAGMA * halo(d, 0.9) * (0.4 + 0.1 * sin((uTime * 0.4) * 0.8)) + vec3<f32>(0.6, 0.08, 0.0) * halo(d, 2.2) * 0.25;
    }
    // nothing over the point (Creyon): what it draws fades out just past its tip
    col *= tipFadeB(b);
    return col * roomFade(abs(b.x));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
