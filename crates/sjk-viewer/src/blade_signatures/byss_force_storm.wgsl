// Byss Force Storm (new 2/11/2026, update 21, in place of Nur Shadowflame): the Emperor's own weapon, the
// Force storm over the throne world of Byss, a tear in space that swallowed fleets. The blade is the
// storm's funnel: a thin dark rope at the hand, opening steadily into a wide turning tornado at
// the point, its walls twisting strands of black and violet, blue-white Force lightning burning
// inside it. Torn wreckage is carried round it on a rising spiral and flung off the top. At the crown
// the eye of the storm burns white. Every 24 seconds the storm surges: the funnel swells, the
// lightning blazes along its whole length and the wreckage whirls wider.
const BY_BLACK: vec3<f32> = vec3<f32>(0.012, 0.006, 0.03);

const BY_VIOLET: vec3<f32> = vec3<f32>(0.42, 0.14, 0.95);

const BY_PALE: vec3<f32> = vec3<f32>(0.72, 0.6, 1.0);

const BY_BOLT: vec3<f32> = vec3<f32>(0.68, 0.82, 1.0);

const BY_WHITE: vec3<f32> = vec3<f32>(0.96, 0.96, 1.0);

fn by_top() -> f32 {
    return (uLength + 0.2) * rxLife(0.0, 0.6, 0.5);
}

fn by_after() -> f32 {
    return rxLife(0.3, 1.2, 0.5);
}

fn by_surge() -> f32 {
    return select(0.0, rxCycle(24.0, 14.0, 17.0, 18.5, 22.0) * by_after(), part(5.0) > 0.5);
}

// the funnel's half width: a thin rope opening to a wide mouth, breathing, rounding off at the top
fn by_half(y0: f32, top: f32) -> f32 {
    let y = clamp(y0, 0.0, top);
    let s = clamp(y / max(uLength, 1.0), 0.0, 1.0);
    let open = 0.3 + (1.7 + 0.5 * by_surge()) * s * s * sqrt(s);
    let wob = 0.12 * sin(y * 0.22 - uClock * 1.2) + 0.04 * sin(y * 0.5 + uClock * 1.5);
    let e0 = 1.0 - clamp((top - y) / 2.2, 0.0, 1.0);
    let end = sqrt(max(1.0 - e0 * e0, 0.0));
    return (open + wob * (0.3 + s)) * end;
}

fn sig_glow_tc(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let top = by_top();
    var col: vec3<f32> = vec3<f32>(0.0);
    if top > 0.15 {
        let yc = clamp(b.y, 0.0, top);
        let d = max(length(vec2(b.x, b.y - yc)) - by_half(b.y, top), 0.0);
        let s = clamp(b.y / max(uLength, 1.0), 0.0, 1.0);
        let sg = by_surge();
        col = BY_VIOLET * (halo(d, 0.22) * 0.45 + halo(d, 0.9 + 0.7 * s) * (0.07 + 0.14 * s + 0.2 * sg));
        // the eye's light spilling over the crown
        if part(3.0) > 0.5 {
            col += BY_PALE * halo(length(vec2(b.x, b.y - uLength * 0.97)), 1.7) * 0.14 * (1.0 + sg);
        }
    }
    col += lvl(g) * BY_PALE * (1.0 - smoothstep(0.3, 1.5, abs(b.y))) * 0.3;
    col *= tipFadeB(b);
    return col * roomFade(abs(b.x)) * (1.0 + 0.7 * clamp(uClash, 0.0, 1.0));
}

fn sig_core_d(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * 0.0;
}

fn sig_solid_raw(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let top = by_top();
    if top < 0.15 || b.y < -0.3 || b.y > top + 0.3 {
        return o;
    }
    let half = by_half(b.y, top);
    let x = abs(b.x);
    let cov = (1.0 - smoothstep(half - 0.06 - px, half + 0.03 + px, x)) * smoothstep(0.02, 0.12 + px, half);
    if cov <= 0.0 {
        return o;
    }
    let across = clamp(b.x / max(half, 0.01), -1.0, 1.0);
    let nz = sqrt(max(1.0 - across * across, 0.0));
    let s = clamp(b.y / max(uLength, 1.0), 0.0, 1.0);
    let sg = by_surge();
    // (update 30, Creyon: you see the lines in it; one whole effect) the walls are one turning storm cloud,
    // thick and soft, darker in its folds; the lightning lights it from inside as blooms of light, no line
    let around_ = asin(across);
    let sq = vec2(around_ * 1.25 + b.y * 0.13 - uClock * 0.85, b.y * 0.06 - uClock * 0.22);
    let warp = rxFlow(sq * 0.7 + vec2<f32>(3.0, 1.0));
    let cloud = select(0.5, rxFlow(sq + vec2(1.1 * warp, 0.7 * warp)), part(0.0) > 0.5);
    var col = mix(BY_BLACK + BY_VIOLET * 0.16, BY_VIOLET * 1.1, smoothstep(0.22, 0.72, cloud));
    col = mix(col, BY_PALE * 1.05, smoothstep(0.6, 0.95, cloud) * 0.75);
    col *= 0.55 + 0.65 * nz;
    col += BY_VIOLET * pow(1.0 - nz, 2.5) * 0.5;
    if part(1.0) > 0.5 {
        col += BY_BOLT * pow(nz, 3.0) * (0.14 + 0.1 * sin(uClock * 1.3)) * (1.0 + sg);
        for (var i = 0; i < 3; i++) {
            let k = f32(i);
            let cyc = uClock * (0.31 + 0.09 * k) + k * 0.37;
            let q = fract(cyc);
            let yy = uLength * (0.15 + 0.78 * h11(floor(cyc) * 3.7 + k));
            let env = smoothstep(0.0, 0.07, q) * (1.0 - smoothstep(0.07, 0.7, q));
            col += mix(BY_BOLT, BY_WHITE, cloud) * halo(abs(b.y - yy), 3.0 + 2.0 * half) * env * (0.5 + 0.9 * cloud) * nz;
        }
        col += BY_WHITE * sg * 0.3 * (0.5 + 0.5 * cloud);
    }
    col += BY_WHITE * halo(max(b.y, 0.0), 0.5) * 0.45;
    col = mix(col, BY_WHITE, 0.5 * clamp(uClash, 0.0, 1.0));
    return vec4(mix(o.rgb, col, cov), max(o.a, cov));
}

fn sig_vol_tc(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var fx: vec3<f32> = vec3<f32>(0.0);
    if uFx <= 0.0 {
        return fx;
    }
    let L = uLength;
    var t: f32;
    let aft = by_after();
    let sg = by_surge();
    // three great arms of the storm winding up and out, and lightning leaping from them
    if part(2.0) > 0.5 && fxNear(ro, rd, 0.0, L) < 9.0 {
        for (var i = 0; i < 3; i++) {
            let k = f32(i);
            var f2: f32;
            var sa: f32;
            var bWs: f32 = 0.0;
            var best: f32 = 1.0e3;
            var bf: f32 = 0.0;
            var prev = around(0.7, k / 3.0 - 0.06 * uClock, L * 0.08);
            for (var j = 1; j <= 22; j++) {
                let g = f32(j) / 22.0;
                let q = around(0.7 + (4.2 + 1.2 * sg) * g * g, k / 3.0 + 0.9 * g - 0.06 * uClock, L * (0.08 + 0.9 * g));
                let d = raySeg(ro, rd, prev, q, &sa);
                {
                    let wN = bW(d);
                    bWs += wN;
                    best = min(best, d);
                    bf += ((f32(j) - 1.0 + sa) / 22.0 - bf) * wN / bWs;
                }
                prev = q;
            }
            let wv = 0.5 + 0.5 * sin(bf * 8.0 - uClock * 1.8 + k * 2.0);
            fx += (BY_PALE * halo(best, 0.2) * (0.25 + 0.4 * wv) + BY_VIOLET * (halo(best, 0.42) * 0.6 + halo(best, 1.0) * 0.25)) * smoothstep(0.0, 0.08, bf) * (1.0 - smoothstep(0.82, 1.0, bf)) * aft;
        }
        // (update 28) its lightning takes the wearer's colour with the blade
        uTurnFx += (1.0 + 0.8 * sg) * liveArcs(ro, rd, px, L * 0.3, L * 0.97, 4.0, 2.8, 0.5, 37.0, BY_BOLT) * aft * uFx * hiltFade(ro, rd);
    }
    // the wind: the storm's air, opening with the funnel
    if part(4.0) > 0.5 && fxNear(ro, rd, 0.0, L) < 9.0 {
        fx += (0.5 + 0.7 * sg) * syMistSpin(ro, rd, L * 0.25, L, 1.2, 5.6, 0.05, 90.0, BY_VIOLET * 0.9, BY_BLACK + BY_VIOLET * 0.2) * aft;
    }
    // dust and small things drawn up the spiral, a storm of specks widening with the funnel
    if part(4.0) > 0.5 && fxNear(ro, rd, 0.0, L) < 8.5 {
        for (var i = 0; i < 26; i++) {
            let k = f32(i);
            let cyc = uClock * (0.12 + 0.06 * h11(k * 2.3)) + h11(k * 6.1);
            let n = floor(cyc);
            let q = fract(cyc);
            let rr = 0.7 + 5.0 * q * q;
            let p = around(rr, h11(n * 5.3 + k) + 2.6 * q * q, L * (0.04 + 0.96 * q));
            let d = rayPt(ro, rd, p, &t);
            fx += (BY_PALE * halo(d, max(0.05, px)) * 1.0 + BY_VIOLET * halo(d, 0.22) * 0.28) * sin(3.1416 * q) * roomFade(rr) * aft * (1.0 + sg);
        }
    }
    // pulses of pale light climbing the funnel's mouth, felt from the crown
    if part(0.0) > 0.5 && fxNear(ro, rd, L * 0.3, L) < 4.0 {
        let pl = fract(uClock * 0.33);
        let yp = L * (0.15 + 0.85 * pl);
        fx += BY_PALE * halo(rayPt(ro, rd, vec3(0.0, yp, 0.0), &t), 0.5 + 1.4 * pl) * sin(3.1416 * pl) * 0.32 * aft;
    }
    // the eye of the storm
    if part(3.0) > 0.5 {
        let eye = vec3(0.0, L * 0.97, 0.0);
        let d = rayPt(ro, rd, eye, &t);
        let br = 0.8 + 0.2 * sin(uClock * 3.1) * sin(uClock * 1.7);
        fx += (BY_WHITE * halo(d, 0.42) * 1.1 + BY_PALE * halo(d, 1.3) * 0.4) * br * (1.0 + sg) * aft;
    }
    // lightning leaping from the crown when it surges
    if part(1.0) > 0.5 && sg > 0.02 && fxNear(ro, rd, L * 0.4, L) < 7.0 {
        for (var i = 0; i < 3; i++) {
            let k = f32(i);
            let cyc = uClock * (0.7 + 0.2 * k) + k * 0.3;
            let n = floor(cyc);
            let q = fract(cyc);
            if q > 0.4 {
                continue;
            }
            let a = around(1.0, h11(n * 3.3 + k), L * (0.72 + 0.22 * h11(n * 1.3 + k)));
            let c = around(4.5 + 1.5 * h11(n * 2.7 + k), h11(n * 3.3 + k) + 0.05, a.y + (h11(n * 5.1 + k) - 0.6) * 5.0);
            let d = bolt3(ro, rd, a, c, n * 7.7 + k, 0.2, px);
            uTurnFx += (BY_WHITE * halo(d, max(0.05, px)) * 1.5 + BY_BOLT * halo(d, 0.26) * 0.6) * (1.0 - q / 0.4) * sg * roomFade(5.5) * uFx * hiltFade(ro, rd);
        }
    }
    let cl = clamp(uClash, 0.0, 1.0);
    if cl > 0.01 {
        fx += (BY_WHITE * halo(rayPt(ro, rd, vec3(0.0, L * 0.6, 0.0), &t), 1.0) * 1.3 + BY_VIOLET * halo(rayPt(ro, rd, vec3(0.0, L * 0.6, 0.0), &t), 3.0) * 0.35) * cl;
    }
    return fx * uFx * hiltFade(ro, rd);
}

